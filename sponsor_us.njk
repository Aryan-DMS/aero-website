<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Aerial Martial | Sponsor Us</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Roboto+Mono:wght@400;500&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --bg-deep: #0B1121;
            --bg-panel-dark: #151E32;
            --bg-light: #F8FAFC;
            --bg-white: #FFFFFF;
            
            --accent-cyan: #0EA5E9;
            
            --text-light: #F8FAFC;
            --text-muted: #94A3B8;
            --text-dark: #0F172A;
            
            --border-dark: rgba(255, 255, 255, 0.1);
            
            --font-ui: 'Inter', sans-serif;
            --font-data: 'Roboto Mono', monospace;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; scroll-behavior: smooth; }
        body { font-family: var(--font-ui); background: var(--bg-deep); color: var(--text-light); -webkit-font-smoothing: antialiased; display: flex; flex-direction: column; min-height: 100vh; }
        a { text-decoration: none; color: inherit; }
        ul { list-style: none; }
        
        .container { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
        main { flex: 1; }

        header {
            background: var(--bg-deep);
            border-bottom: 1px solid var(--border-dark);
            height: 80px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 40px;
            position: sticky;
            top: 0;
            z-index: 1000;
        }
        
        .nav-logo { font-weight: 800; font-size: 24px; letter-spacing: -0.5px; }
        .nav-logo span { color: var(--accent-cyan); }
        
        .nav-links { display: flex; gap: 4px; }
        .nav-links a { color: var(--text-light); font-size: 16px; font-weight: 600; padding: 10px 18px; border-radius: 4px; transition: all 0.2s ease; }
        .nav-links a:hover, .nav-links a.active { background-color: var(--bg-white); color: var(--bg-deep); }

        .btn-join { display: inline-block; background: var(--accent-cyan); color: var(--bg-deep); padding: 12px 28px; border-radius: 4px; font-size: 15px; font-weight: 800; border: 1px solid var(--accent-cyan); transition: all 0.2s ease; text-align: center; }
        .btn-join:hover { background: var(--text-light); color: var(--bg-deep); border-color: var(--text-light); }

        /* Architectural Action Cards */
        .action-card { background: var(--bg-deep); border: 1px solid var(--border-dark); border-radius: 4px; padding: 40px; display: flex; align-items: flex-start; gap: 24px; transition: border-color 0.2s ease; text-decoration: none; color: var(--text-light); cursor: pointer; }
        .action-card:hover { border-color: var(--text-light); }
        
        .action-icon { width: 64px; height: 64px; background: var(--bg-panel-dark); color: var(--accent-cyan); border-radius: 4px; border: 1px solid var(--border-dark); display: flex; align-items: center; justify-content: center; font-size: 24px; flex-shrink: 0; transition: all 0.2s ease; font-weight: 800; }
        .action-card:hover .action-icon { background: var(--text-light); color: var(--bg-deep); border-color: var(--text-light); }
        
        .action-content h3 { font-size: 24px; font-weight: 800; margin-bottom: 12px; letter-spacing: -0.5px; }
        .action-content p { font-size: 15px; color: var(--text-muted); line-height: 1.6; }

        /* Footer Styles */
        footer { background: var(--bg-deep); border-top: 1px solid var(--border-dark); margin-top: auto; }
    </style>
</head>
<body>

    <!-- Integrated Navigation -->
    <header>
        <a href="/" class="nav-logo">Aerial<span>Martial</span></a>
        <nav>
            <ul class="nav-links">
                <li><a href="/about/" {% if '/about/' in page.url %}class="active"{% endif %}>About</a></li>
                <li><a href="/achievements/" {% if '/achievements/' in page.url %}class="active"{% endif %}>Achievements</a></li>
                <li><a href="/gallery/" {% if '/gallery/' in page.url %}class="active"{% endif %}>Gallery</a></li>
                <li><a href="/models/" {% if '/models/' in page.url %}class="active"{% endif %}>Models</a></li>
                <li><a href="/events/" {% if '/events/' in page.url %}class="active"{% endif %}>Events</a></li>
                <li><a href="/team/" {% if '/team/' in page.url %}class="active"{% endif %}>Team</a></li>
                <li><a href="/sponsors/" {% if '/sponsors/' in page.url %}class="active"{% endif %}>Sponsors</a></li>
                <li><a href="/contact/" {% if '/contact/' in page.url %}class="active"{% endif %}>Contact</a></li>
            </ul>
        </nav>
        <a href="/sponsor_us/" class="btn-join">Sponsor Us</a>
    </header>

    <main id="sponsor-action-page">
        <!-- Header -->
        <section style="padding: 100px 0 40px; border-bottom: 1px solid var(--border-dark);">
            <div class="container">
                <h4 style="font-family: var(--font-data); color: var(--accent-cyan); font-size: 14px; margin-bottom: 12px; letter-spacing: 1px; text-transform: uppercase;">PARTNERSHIP INQUIRY</h4>
                <h2 style="font-size: 48px; font-weight: 800; margin-bottom: 16px; color: var(--text-light); letter-spacing: -1px;">Sponsor Aerial Martial</h2>
                <p style="color: var(--text-muted); font-size: 20px; line-height: 1.6; max-width: 700px;">Direct access to our sponsorship prospectus, financial tiers, and faculty advisory board.</p>
            </div>
        </section>

        <!-- Split Layout -->
        <section style="padding: 80px 0 120px;">
            <div class="container" style="display: grid; grid-template-columns: 1fr 1.2fr; gap: 80px;">
                
                <!-- Left: The Value Prop -->
                <div>
                    <h3 style="font-size: 28px; font-weight: 800; color: var(--text-light); margin-bottom: 24px;">The Partnership Value</h3>
                    <p style="color: var(--text-muted); font-size: 16px; line-height: 1.7; margin-bottom: 32px;">Partnering with Aerial Martial provides unparalleled access to top-tier engineering talent and visible branding on national platforms. We offer multiple tiers structured to meet corporate recruitment and visibility goals.</p>
                    
                    <ul style="display: flex; flex-direction: column; gap: 20px;">
                        <li style="display: flex; gap: 16px; align-items: flex-start;">
                            <span style="color: var(--accent-cyan); font-family: var(--font-data); margin-top: 2px;">01</span>
                            <div>
                                <strong style="display: block; color: var(--text-light); margin-bottom: 4px; font-size: 16px;">Direct Talent Pipeline</strong>
                                <span style="color: var(--text-muted); font-size: 14px; line-height: 1.5;">Priority access to our engineering roster for recruitment and internships.</span>
                            </div>
                        </li>
                        <li style="display: flex; gap: 16px; align-items: flex-start;">
                            <span style="color: var(--accent-cyan); font-family: var(--font-data); margin-top: 2px;">02</span>
                            <div>
                                <strong style="display: block; color: var(--text-light); margin-bottom: 4px; font-size: 16px;">Hardware Branding</strong>
                                <span style="color: var(--text-muted); font-size: 14px; line-height: 1.5;">Logo placement on competition airframes, ground stations, and team apparel.</span>
                            </div>
                        </li>
                        <li style="display: flex; gap: 16px; align-items: flex-start;">
                            <span style="color: var(--accent-cyan); font-family: var(--font-data); margin-top: 2px;">03</span>
                            <div>
                                <strong style="display: block; color: var(--text-light); margin-bottom: 4px; font-size: 16px;">Tax-Deductible Contributions</strong>
                                <span style="color: var(--text-muted); font-size: 14px; line-height: 1.5;">As an academic collegiate organization, donations are processed through institutional channels.</span>
                            </div>
                        </li>
                    </ul>
                </div>

                <!-- Right: Action Cards -->
                <div style="display: flex; flex-direction: column; gap: 24px;">
                    <!-- PDF Download Action -->
                    <a href="#" class="action-card">
                        <div class="action-icon">↓</div>
                        <div class="action-content">
                            <h3>Download Prospectus</h3>
                            <p>Review our 2027 technical roadmap, detailed operational budget, and structured sponsorship tiers (PDF).</p>
                        </div>
                    </a>

                    <!-- Direct Email Action -->
                    <a href="mailto:faculty@aerialmartial.edu.in?subject=Corporate%20Partnership%20Inquiry%20-%20Aerial%20Martial" class="action-card">
                        <div class="action-icon">✉</div>
                        <div class="action-content">
                            <h3>Contact Faculty Board</h3>
                            <p>Bypass generic forms. Open a direct dialogue with our academic advisors to discuss custom partnership frameworks.</p>
                        </div>
                    </a>
                </div>

            </div>
        </section>
    </main>

    <!-- Global Footer -->
    <footer style="background: var(--bg-deep); border-top: 1px solid var(--border-dark); padding: 80px 0 40px; margin-top: auto;">
        <div class="container" style="display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 40px; margin-bottom: 60px;">
            <div>
                <div class="logo" style="font-size: 24px; font-weight: 800; margin-bottom: 16px;">Aerial<span style="color: var(--accent-cyan);">Martial</span></div>
                <p style="color: var(--text-muted); font-size: 15px; margin-bottom: 24px; max-width: 280px; line-height: 1.6;">A student-led aerospace and robotics club competing at national levels. INNOVATE. BUILD. FLY.</p>
                <div style="display: flex; flex-direction: column; gap: 12px;">
                    <span style="font-size: 14px; color: var(--text-light); display: flex; align-items: center;"><strong style="font-family: var(--font-data); font-size: 11px; color: var(--text-muted); letter-spacing: 1px; width: 60px;">EMAIL</strong> contact@aerialmartial.edu.in</span>
                    <span style="font-size: 14px; color: var(--text-light); display: flex; align-items: center;"><strong style="font-family: var(--font-data); font-size: 11px; color: var(--text-muted); letter-spacing: 1px; width: 60px;">HQ</strong> Engineering College, Pune</span>
                </div>
            </div>
            <div style="padding-top: 10px;">
                <h4 style="font-family: var(--font-data); font-size: 13px; color: var(--text-light); letter-spacing: 1px; text-transform: uppercase; margin-bottom: 24px;">Club</h4>
                <ul style="list-style: none; padding: 0; display: flex; flex-direction: column; gap: 12px;">
                    <li><a href="/about/" style="color: var(--text-muted); text-decoration: none; font-size: 15px; transition: color 0.2s;">About Us</a></li>
                    <li><a href="/team/" style="color: var(--text-muted); text-decoration: none; font-size: 15px; transition: color 0.2s;">Our Team</a></li>
                    <li><a href="/gallery/" style="color: var(--text-muted); text-decoration: none; font-size: 15px; transition: color 0.2s;">Gallery</a></li>
                </ul>
            </div>
            <div style="padding-top: 10px;">
                <h4 style="font-family: var(--font-data); font-size: 13px; color: var(--text-light); letter-spacing: 1px; text-transform: uppercase; margin-bottom: 24px;">Compete</h4>
                <ul style="list-style: none; padding: 0; display: flex; flex-direction: column; gap: 12px;">
                    <li><a href="/achievements/" style="color: var(--text-muted); text-decoration: none; font-size: 15px; transition: color 0.2s;">Achievements</a></li>
                    <li><a href="/models/" style="color: var(--text-muted); text-decoration: none; font-size: 15px; transition: color 0.2s;">The Fleet</a></li>
                    <li><a href="/events/" style="color: var(--text-muted); text-decoration: none; font-size: 15px; transition: color 0.2s;">Upcoming Events</a></li>
                </ul>
            </div>
            <div style="padding-top: 10px;">
                <h4 style="font-family: var(--font-data); font-size: 13px; color: var(--text-light); letter-spacing: 1px; text-transform: uppercase; margin-bottom: 24px;">Connect</h4>
                <ul style="list-style: none; padding: 0; display: flex; flex-direction: column; gap: 12px;">
                    <li><a href="/contact/" style="color: var(--text-muted); text-decoration: none; font-size: 15px; transition: color 0.2s;">Contact Us</a></li>
                    <li><a href="/sponsor_us/" style="color: var(--text-muted); text-decoration: none; font-size: 15px; transition: color 0.2s;">Partner With Us</a></li>
                </ul>
            </div>
        </div>
        <div class="container" style="border-top: 1px solid var(--border-dark); padding-top: 24px; display: flex; justify-content: space-between; align-items: center;">
            <p style="color: var(--text-muted); font-size: 13px;">&copy; 2026 Aerial Martial. All rights reserved.</p>
        </div>
    </footer>
</body>
</html>

