---
layout: base.njk
---
<style>
    /* Auto-style CMS inline images */
    .markdown-body img { width: 100%; height: auto; border-radius: 4px; border: 1px solid var(--border-dark); margin: 32px 0; filter: grayscale(20%); display: block; }
</style>

<main id="event-report">
        
        <!-- Massive Cinematic Header -->
        <section style="height: 60vh; background: linear-gradient(to top, var(--bg-deep), transparent 60%), url('{{ image }}') center/cover; position: relative; display: flex; align-items: flex-end; padding-bottom: 60px; border-bottom: 1px solid var(--border-dark);">
            <div class="container" style="width: 100%;">
                <a href="/events/" style="font-family: var(--font-data); color: var(--text-muted); text-transform: uppercase; font-size: 13px; display: inline-flex; align-items: center; gap: 8px; margin-bottom: 24px; transition: color 0.2s;">← Back to Events</a>
                <span style="display: block; color: var(--accent-cyan); font-family: var(--font-data); letter-spacing: 1px; margin-bottom: 16px; text-transform: uppercase;">{{ category }} EVENT</span>
                <h1 style="font-size: 56px; font-weight: 800; line-height: 1.1; max-width: 900px; letter-spacing: -1px;">{{ title }}</h1>
            </div>
        </section>

        <!-- Formal "Letter" Reading Column -->
        <section style="padding: 80px 0;">
            <div class="container" style="max-width: 800px; margin: 0 auto;">
                
                <!-- Quick Operational Stats Box -->
                <div style="background: var(--bg-panel-dark); border: 1px solid var(--border-dark); padding: 32px; border-radius: 4px; display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-bottom: 60px;">
                    <div>
                        <span style="display: block; font-family: var(--font-data); font-size: 12px; color: var(--text-muted); margin-bottom: 8px;">DATES</span>
                        <strong style="font-size: 16px; color: var(--text-light);">{{ dateString }}</strong>
                    </div>
                    <div>
                        <span style="display: block; font-family: var(--font-data); font-size: 12px; color: var(--text-muted); margin-bottom: 8px;">LOCATION</span>
                        <strong style="font-size: 16px; color: var(--text-light);">{{ location }}</strong>
                    </div>
                    <div>
                        <span style="display: block; font-family: var(--font-data); font-size: 12px; color: var(--text-muted); margin-bottom: 8px;">HARDWARE</span>
                        <strong style="font-size: 16px; color: var(--accent-cyan);">{{ hardware }}</strong>
                    </div>
                </div>

                <!-- The Briefing / Block Builder Engine -->
                <div style="font-size: 18px; color: var(--text-muted); line-height: 1.8; text-align: left;">
                    {% for block in blocks %}
                        {% if block.type == 'text_block' %}
                            {% if block.heading %}
                                <h3 style="color: var(--text-light); font-size: 24px; font-weight: 800; margin: 48px 0 24px;">{{ block.heading }}</h3>
                            {% endif %}
                            <div style="margin-bottom: 24px;">
                                {{ block.content | safe }}
                            </div>
                        {% elif block.type == 'image_block' %}
                            <img src="{{ block.image }}" style="width: 100%; height: auto; border: 1px solid var(--border-dark); border-radius: 4px; margin: 32px 0;" alt="{{ block.alt }}">
                        {% endif %}
                    {% endfor %}
                    
                    <div style="margin-top: 60px; padding-top: 40px; border-top: 1px solid var(--border-dark);">
                        <a href="/contact/" class="btn-outline">Request a Briefing Appointment</a>
                    </div>
                </div>

            </div>
        </section>
    </main>
