<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AeroClub | Home</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Roboto+Mono:wght@400;500&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --bg-deep: #0B1121;
            --bg-panel-dark: #151E32;
            --bg-light: #F8FAFC;
            --bg-white: #FFFFFF;
            
            --accent-cyan: #0EA5E9;
            
            --text-light: #F8FAFC;
            --text-muted: #94A3B8;
            --text-dark: #0F172A;
            
            --border-dark: rgba(255, 255, 255, 0.1);
            
            --font-ui: 'Inter', sans-serif;
            --font-data: 'Roboto Mono', monospace;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; scroll-behavior: smooth; }
        body { font-family: var(--font-ui); background: var(--bg-deep); color: var(--text-light); -webkit-font-smoothing: antialiased; display: flex; flex-direction: column; min-height: 100vh; }
        a { text-decoration: none; color: inherit; }
        ul { list-style: none; }
        
        .container { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
        main { flex: 1; }

        /* ==========================================
           CLEAN, FLAT, HIGH-CONTRAST NAVIGATION
        ========================================== */
        header {
            background: var(--bg-deep); /* Solid, integrated background */
            border-bottom: 1px solid var(--border-dark);
            height: 80px; /* Taller for better breathing room */
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 40px;
            position: sticky;
            top: 0;
            z-index: 1000;
        }
        
        .nav-logo { font-weight: 800; font-size: 24px; letter-spacing: -0.5px; }
        .nav-logo span { color: var(--accent-cyan); }
        
        /* Removed the pill container styling completely */
        .nav-links { 
            display: flex; 
            gap: 4px; 
        }
        
        /* Larger, bolder, more readable links */
        .nav-links a { 
            color: var(--text-light); 
            font-size: 16px; 
            font-weight: 600; 
            padding: 10px 18px; 
            border-radius: 4px; /* Subtle architectural rounding */
            transition: all 0.2s ease;
        }
        
        /* High contrast DW.com style hover & active states */
        .nav-links a:hover, 
        .nav-links a.active {
            background-color: var(--bg-white); 
            color: var(--bg-deep); 
        }

        .btn-join { background: var(--accent-cyan); color: #fff; padding: 12px 28px; border-radius: 4px; font-size: 15px; font-weight: 700; transition: background 0.2s; }
        .btn-join:hover { background: #0284C7; }

        /* ==========================================
           PAGE CONTENT (HOME PAGE)
        ========================================== */
        .hero {
            height: calc(100vh - 80px);
            position: relative;
            display: flex;
            align-items: center;
            overflow: hidden;
            background-color: var(--bg-deep);
        }
        
        /* The Engineering Grid Overlay */
        .hero::before {
            content: '';
            position: absolute;
            inset: 0;
            background-image: 
                linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
                linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
            background-size: 40px 40px;
            background-position: center center;
            z-index: 1;
        }
        
        /* Radial vignette to fade the grid smoothly into the dark */
        .hero::after {
            content: '';
            position: absolute;
            inset: 0;
            background: radial-gradient(circle at center right, transparent 0%, var(--bg-deep) 80%);
            z-index: 2;
        }

        .hero-content {
            position: relative;
            z-index: 3;
            width: 100%;
        }

        .hero-text h1 { font-size: 72px; font-weight: 800; line-height: 1.05; margin-bottom: 24px; max-width: 850px; letter-spacing: -2px; color: var(--text-light); }
        .hero-text p { font-size: 16px; color: var(--accent-cyan); max-width: 600px; margin-bottom: 40px; font-family: var(--font-data); letter-spacing: 2px; text-transform: uppercase; }

        /* ==========================================
           GLOBAL FOOTER
        ========================================== */
        footer { background: var(--bg-deep); border-top: 1px solid var(--border-dark); margin-top: auto; }
        .map-container { width: 100%; height: 350px; background: #111; border-bottom: 1px solid var(--border-dark); }
        .map-container iframe { width: 100%; height: 100%; border: 0; filter: invert(90%) hue-rotate(180deg) contrast(1.1); }
        
        .footer-content { padding: 80px 0 40px; display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 40px; border-bottom: 1px solid var(--border-dark); margin-bottom: 24px; }
        .footer-brand .logo { font-size: 24px; font-weight: 800; margin-bottom: 16px; display: block; }
        .footer-brand .logo span { color: var(--accent-cyan); }
        .footer-brand p { color: var(--text-muted); font-size: 14px; line-height: 1.6; margin-bottom: 24px; max-width: 300px; }
        .contact-info li { display: flex; align-items: center; gap: 12px; color: var(--text-muted); font-size: 14px; margin-bottom: 12px; }
        
        .footer-links h4 { font-size: 13px; font-weight: 700; letter-spacing: 1px; margin-bottom: 20px; color: var(--text-light); text-transform: uppercase; }
        .footer-links ul li { margin-bottom: 12px; }
        .footer-links ul a { color: var(--text-muted); font-size: 14px; transition: color 0.2s; }
        .footer-links ul a:hover { color: var(--accent-cyan); }

        .footer-bottom { padding-bottom: 40px; display: flex; justify-content: space-between; align-items: center; color: var(--text-muted); font-size: 14px; }
        
        /* ==========================================
           HOMEPAGE SPECIFIC SECTIONS
        ========================================== */
        .stats-bar { background: var(--bg-panel-dark); border-bottom: 1px solid var(--border-dark); padding: 40px 0; }
        .stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); text-align: center; gap: 24px; }
        .stat-value { font-size: 48px; font-weight: 800; color: var(--accent-cyan); margin-bottom: 8px; line-height: 1; }
        .stat-label { font-family: var(--font-data); font-size: 13px; color: var(--text-muted); text-transform: uppercase; letter-spacing: 1px; }
        
        .home-section { padding: 80px 0; }
        
        .mission-split { display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: center; }
        .mission-text h2 { font-size: 40px; font-weight: 800; margin-bottom: 24px; letter-spacing: -0.5px; }
        .mission-text h2 span { color: var(--accent-cyan); }
        .mission-text p { font-size: 18px; color: var(--text-muted); line-height: 1.7; margin-bottom: 32px; }
        
        /* Clean, high-contrast button (No neon blue outline) */
        .btn-outline { display: inline-block; padding: 12px 28px; border: 1px solid var(--border-dark); background: var(--bg-deep); color: var(--text-light); border-radius: 4px; font-weight: 700; transition: all 0.2s ease; }
        .btn-outline:hover { background: var(--text-light); color: var(--bg-deep); border-color: var(--text-light); }
        
        .mission-typo { display: flex; flex-direction: column; gap: 12px; }
        .mission-typo h3 { font-size: 72px; font-weight: 900; line-height: 0.9; color: transparent; -webkit-text-stroke: 1px rgba(255,255,255,0.15); text-transform: uppercase; transition: all 0.3s cubic-bezier(0.25, 0.1, 0.25, 1); cursor: default; }
        .mission-typo h3.active { color: rgba(255,255,255,0.05); -webkit-text-stroke: 0; }
        .mission-typo h3:hover { color: var(--accent-cyan); -webkit-text-stroke: 0; transform: translateX(12px); }
        
        /* Fleet Carousel */
        .fleet-carousel { position: relative; display: flex; align-items: center; background: var(--bg-panel-dark); border-radius: 12px; border: 1px solid var(--border-dark); overflow: hidden; }
        .fleet-slide { display: flex; align-items: center; gap: 40px; padding: 60px 80px; width: 100%; }
        .fleet-info { flex: 1; z-index: 2; }
        .fleet-info h3 { font-size: 36px; font-weight: 800; margin-bottom: 16px; color: var(--text-light); } /* Explicitly white title */
        .fleet-info p { font-size: 18px; color: var(--text-muted); margin-bottom: 32px; line-height: 1.6; }
        .fleet-image { flex: 1; display: flex; justify-content: center; }
        .fleet-image img { max-width: 100%; max-height: 300px; object-fit: contain; filter: drop-shadow(0 20px 30px rgba(0,0,0,0.5)); }
        
        .carousel-btn { position: absolute; background: rgba(11, 17, 33, 0.5); border: 1px solid var(--border-dark); color: var(--text-light); width: 48px; height: 48px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 18px; cursor: pointer; transition: background 0.2s, border-color 0.2s; z-index: 10; }
        .carousel-btn:hover { background: var(--bg-deep); border-color: var(--text-light); }
        .carousel-prev { left: 16px; }
        .carousel-next { right: 16px; }
        
        .news-header { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 40px; }
        .news-header h2 { font-size: 32px; font-weight: 800; }
        .news-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
        
        /* Clean Dual-Color News Cards (No float/glow) */
        .news-card { background: var(--bg-deep); border: 1px solid var(--border-dark); display: flex; flex-direction: column; transition: border-color 0.2s; overflow: hidden; }
        .news-card:hover { border-color: var(--text-light); } /* Sharp, architectural border contrast */
        .news-img { height: 200px; overflow: hidden; border-bottom: 1px solid var(--border-dark); }
        .news-img img { width: 100%; height: 100%; object-fit: cover; filter: grayscale(40%); transition: filter 0.3s; }
        .news-card:hover .news-img img { filter: grayscale(0%); }
        .news-content { padding: 32px; flex: 1; display: flex; flex-direction: column; }
        .news-meta { font-family: var(--font-data); font-size: 12px; color: var(--accent-cyan); margin-bottom: 12px; display: block; letter-spacing: 1px; }
        .news-card h4 { font-size: 20px; font-weight: 700; margin-bottom: 12px; color: var(--text-light); }
        .news-card p { font-size: 15px; color: var(--text-muted); line-height: 1.6; margin-bottom: 24px; flex: 1; }
        .learn-more { font-size: 13px; font-weight: 700; color: var(--text-light); text-transform: uppercase; letter-spacing: 1px; display: flex; align-items: center; gap: 8px; }
        .learn-more::after { content: '→'; transition: transform 0.2s; }
        .news-card:hover .learn-more::after { transform: translateX(6px); }

        /* Strategic Partners Grid */
        .partners-header { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 40px; }
        .partners-header h2 { font-size: 32px; font-weight: 800; }
        .partners-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; }
        
        /* Vertical, solid cards with pure white logos */
        .partner-logo { display: flex; justify-content: center; align-items: center; padding: 40px; height: 220px; border-radius: 4px; background: var(--bg-panel-dark); border: 1px solid var(--border-dark); transition: border-color 0.2s ease; }
        .partner-logo img { max-width: 85%; max-height: 90px; object-fit: contain; filter: brightness(0) invert(1); /* Forces any logo to be pure, opaque white */ transition: transform 0.2s ease; }
        .partner-logo:hover { border-color: var(--text-light); }
        .partner-logo:hover img { transform: scale(1.05); }
        
        .marquee-wrapper { overflow: hidden; white-space: nowrap; padding: 60px 0; border-top: 1px solid var(--border-dark); border-bottom: 1px solid var(--border-dark); background: var(--bg-panel-dark); }
        .marquee-content { display: inline-flex; gap: 80px; align-items: center; animation: marquee 20s linear infinite; opacity: 0.5; }
        .marquee-content span { font-size: 24px; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 2px; }
        @keyframes marquee { 0% { transform: translateX(0); } 100% { transform: translateX(-50%); } }
        
        .launch-cta { text-align: center; padding: 100px 0; }
        .launch-cta h2 { font-size: 48px; font-weight: 800; margin-bottom: 24px; }
        .launch-cta p { font-size: 18px; color: var(--text-muted); margin-bottom: 40px; }

        /* Auto-style CMS inline images */
        .markdown-body img { width: 100%; height: auto; border-radius: 4px; border: 1px solid var(--border-dark); margin: 32px 0; filter: grayscale(20%); display: block; }
    </style>
</head>
<body>

    <!-- Integrated, High-Contrast Navigation -->
    <header>
        <a href="/" class="nav-logo">Aerial<span>Martial</span></a>
        
        <nav>
            <ul class="nav-links">
                <li><a href="/about/" {% if '/about/' in page.url %}class="active"{% endif %}>About</a></li>
                <li><a href="/achievements/" {% if '/achievements/' in page.url %}class="active"{% endif %}>Achievements</a></li>
                <li><a href="/gallery/" {% if '/gallery/' in page.url %}class="active"{% endif %}>Gallery</a></li>
                <li><a href="/models/" {% if '/models/' in page.url %}class="active"{% endif %}>Models</a></li>
                <li><a href="/events/" {% if '/events/' in page.url %}class="active"{% endif %}>Events</a></li>
                <li><a href="/team/" {% if '/team/' in page.url %}class="active"{% endif %}>Team</a></li>
                <li><a href="/sponsors/" {% if '/sponsors/' in page.url %}class="active"{% endif %}>Sponsors</a></li>
                <li><a href="/contact/" {% if '/contact/' in page.url %}class="active"{% endif %}>Contact</a></li>
            </ul>
        </nav>
        
        <a href="/sponsor_us/" class="btn-join">Sponsor Us</a>
    </header>

    <!-- Expanded Event Briefing (Letter Layout) -->
    <main id="event-report">
        
        <!-- Massive Cinematic Header -->
        <section style="height: 60vh; background: linear-gradient(to top, var(--bg-deep), transparent 60%), url('{{ image }}') center/cover; position: relative; display: flex; align-items: flex-end; padding-bottom: 60px; border-bottom: 1px solid var(--border-dark);">
            <div class="container" style="width: 100%;">
                <a href="/events/" style="font-family: var(--font-data); color: var(--text-muted); text-transform: uppercase; font-size: 13px; display: inline-flex; align-items: center; gap: 8px; margin-bottom: 24px; transition: color 0.2s;">← Back to Events</a>
                <span style="display: block; color: var(--accent-cyan); font-family: var(--font-data); letter-spacing: 1px; margin-bottom: 16px; text-transform: uppercase;">{{ category }} EVENT</span>
                <h1 style="font-size: 56px; font-weight: 800; line-height: 1.1; max-width: 900px; letter-spacing: -1px;">{{ title }}</h1>
            </div>
        </section>

        <!-- Formal "Letter" Reading Column -->
        <section style="padding: 80px 0;">
            <div class="container" style="max-width: 800px; margin: 0 auto;">
                
                <!-- Quick Operational Stats Box -->
                <div style="background: var(--bg-panel-dark); border: 1px solid var(--border-dark); padding: 32px; border-radius: 4px; display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-bottom: 60px;">
                    <div>
                        <span style="display: block; font-family: var(--font-data); font-size: 12px; color: var(--text-muted); margin-bottom: 8px;">DATES</span>
                        <strong style="font-size: 16px; color: var(--text-light);">{{ dateString }}</strong>
                    </div>
                    <div>
                        <span style="display: block; font-family: var(--font-data); font-size: 12px; color: var(--text-muted); margin-bottom: 8px;">LOCATION</span>
                        <strong style="font-size: 16px; color: var(--text-light);">{{ location }}</strong>
                    </div>
                    <div>
                        <span style="display: block; font-family: var(--font-data); font-size: 12px; color: var(--text-muted); margin-bottom: 8px;">HARDWARE</span>
                        <strong style="font-size: 16px; color: var(--accent-cyan);">{{ hardware }}</strong>
                    </div>
                </div>

                <!-- The Briefing / Block Builder Engine -->
                <div style="font-size: 18px; color: var(--text-muted); line-height: 1.8; text-align: left;">
                    {% for block in blocks %}
                        {% if block.type == 'text_block' %}
                            {% if block.heading %}
                                <h3 style="color: var(--text-light); font-size: 24px; font-weight: 800; margin: 48px 0 24px;">{{ block.heading }}</h3>
                            {% endif %}
                            <div style="margin-bottom: 24px;">
                                {{ block.content | safe }}
                            </div>
                        {% elif block.type == 'image_block' %}
                            <img src="{{ block.image }}" style="width: 100%; height: auto; border: 1px solid var(--border-dark); border-radius: 4px; margin: 32px 0;" alt="{{ block.alt }}">
                        {% endif %}
                    {% endfor %}
                    
                    <div style="margin-top: 60px; padding-top: 40px; border-top: 1px solid var(--border-dark);">
                        <a href="/contact/" class="btn-outline">Request a Briefing Appointment</a>
                    </div>
                </div>

            </div>
        </section>
    </main>

    <!-- Global Footer -->
    <footer style="background: var(--bg-deep); border-top: 1px solid var(--border-dark); padding: 80px 0 40px; margin-top: auto;">
        <div class="container" style="display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 40px; margin-bottom: 60px;">
            
            <!-- Brand & Typographic Contact -->
            <div>
                <div class="logo" style="font-size: 24px; font-weight: 800; margin-bottom: 16px;">Aerial<span style="color: var(--accent-cyan);">Martial</span></div>
                <p style="color: var(--text-muted); font-size: 15px; margin-bottom: 24px; max-width: 280px; line-height: 1.6;">A student-led aerospace and robotics club competing at national levels. INNOVATE. BUILD. FLY.</p>
                <div style="display: flex; flex-direction: column; gap: 12px;">
                    <span style="font-size: 14px; color: var(--text-light); display: flex; align-items: center;"><strong style="font-family: var(--font-data); font-size: 11px; color: var(--text-muted); letter-spacing: 1px; width: 60px;">EMAIL</strong> contact@aerialmartial.edu.in</span>
                    <span style="font-size: 14px; color: var(--text-light); display: flex; align-items: center;"><strong style="font-family: var(--font-data); font-size: 11px; color: var(--text-muted); letter-spacing: 1px; width: 60px;">HQ</strong> Engineering College, Pune</span>
                    <span style="font-size: 14px; color: var(--text-light); display: flex; align-items: center;"><strong style="font-family: var(--font-data); font-size: 11px; color: var(--text-muted); letter-spacing: 1px; width: 60px;">COMMS</strong> +91 98765 43210</span>
                </div>
            </div>
            
            <!-- Navigation -->
            <div style="padding-top: 10px;">
                <h4 style="font-family: var(--font-data); font-size: 13px; color: var(--text-light); letter-spacing: 1px; text-transform: uppercase; margin-bottom: 24px;">Club</h4>
                <ul style="list-style: none; padding: 0; display: flex; flex-direction: column; gap: 12px;">
                    <li><a href="/about/" style="color: var(--text-muted); text-decoration: none; font-size: 15px; transition: color 0.2s;">About Us</a></li>
                    <li><a href="/team/" style="color: var(--text-muted); text-decoration: none; font-size: 15px; transition: color 0.2s;">Our Team</a></li>
                    <li><a href="/gallery/" style="color: var(--text-muted); text-decoration: none; font-size: 15px; transition: color 0.2s;">Gallery</a></li>
                </ul>
            </div>
            
            <!-- Operations -->
            <div style="padding-top: 10px;">
                <h4 style="font-family: var(--font-data); font-size: 13px; color: var(--text-light); letter-spacing: 1px; text-transform: uppercase; margin-bottom: 24px;">Compete</h4>
                <ul style="list-style: none; padding: 0; display: flex; flex-direction: column; gap: 12px;">
                    <li><a href="/achievements/" style="color: var(--text-muted); text-decoration: none; font-size: 15px; transition: color 0.2s;">Achievements</a></li>
                    <li><a href="/models/" style="color: var(--text-muted); text-decoration: none; font-size: 15px; transition: color 0.2s;">The Fleet</a></li>
                    <li><a href="/events/" style="color: var(--text-muted); text-decoration: none; font-size: 15px; transition: color 0.2s;">Upcoming Events</a></li>
                </ul>
            </div>
            
            <!-- Connect -->
            <div style="padding-top: 10px;">
                <h4 style="font-family: var(--font-data); font-size: 13px; color: var(--text-light); letter-spacing: 1px; text-transform: uppercase; margin-bottom: 24px;">Connect</h4>
                <ul style="list-style: none; padding: 0; display: flex; flex-direction: column; gap: 12px;">
                    <li><a href="/contact/" style="color: var(--text-muted); text-decoration: none; font-size: 15px; transition: color 0.2s;">Contact Us</a></li>
                    <li><a href="/sponsor_us/" style="color: var(--text-muted); text-decoration: none; font-size: 15px; transition: color 0.2s;">Partner With Us</a></li>
                    <li><a href="/sponsors/" style="color: var(--text-muted); text-decoration: none; font-size: 15px; transition: color 0.2s;">Sponsors</a></li>
                </ul>
            </div>

        </div>
        
        <!-- Legal & Social Row -->
        <div class="container" style="border-top: 1px solid var(--border-dark); padding-top: 24px; display: flex; justify-content: space-between; align-items: center;">
            <p style="color: var(--text-muted); font-size: 13px;">&copy; 2026 Aerial Martial. All rights reserved.</p>
            <div style="display: flex; gap: 24px;">
                <a href="#" style="color: var(--text-muted); text-decoration: none; font-size: 13px; transition: color 0.2s;">Instagram</a>
                <a href="#" style="color: var(--text-muted); text-decoration: none; font-size: 13px; transition: color 0.2s;">LinkedIn</a>
                <a href="#" style="color: var(--text-muted); text-decoration: none; font-size: 13px; transition: color 0.2s;">YouTube</a>
            </div>
        </div>
    </footer>
    

</body>
</html>
