---
layout: base.njk
---
<main id="mission-report">
        
        <!-- Massive Cinematic Header -->
        <section style="height: 60vh; background: linear-gradient(to top, var(--bg-deep), transparent 60%), url('{{ image }}') center/cover; position: relative; display: flex; align-items: flex-end; padding-bottom: 60px; border-bottom: 1px solid var(--border-dark);">
            <div class="container" style="width: 100%;">
                <a href="/achievements/" style="font-family: var(--font-data); color: var(--text-muted); text-transform: uppercase; font-size: 13px; display: inline-flex; align-items: center; gap: 8px; margin-bottom: 24px; transition: color 0.2s;">← Back to Archives</a>
                <span style="display: block; color: var(--accent-cyan); font-family: var(--font-data); letter-spacing: 1px; margin-bottom: 16px;">{{ hero_meta }}</span>
                <h1 style="font-size: 56px; font-weight: 800; line-height: 1.1; max-width: 900px; letter-spacing: -1px;">{{ title }}</h1>
            </div>
        </section>

        <style>
            /* The 30/70 Macro Grid */
            .report-grid { display: grid; grid-template-columns: 320px 1fr; gap: 60px; align-items: start; }
            @media (max-width: 1024px) { .report-grid { grid-template-columns: 1fr; } }
            
            /* Sticky HUD Anchor */
            .hud-anchor { position: sticky; top: 120px; background: var(--bg-panel-dark); border: 1px solid var(--border-dark); padding: 32px; border-radius: 8px; }
            .hud-metric { font-size: 64px; font-weight: 900; color: var(--accent-cyan); line-height: 1; margin-bottom: 8px; letter-spacing: -2px; }
            .hud-label { font-family: var(--font-ui), sans-serif; font-size: 12px; font-weight: 700; color: var(--text-muted); letter-spacing: 1.5px; text-transform: uppercase; margin-bottom: 32px; display: block; }
            .hud-grid { display: flex; flex-direction: column; gap: 20px; margin-bottom: 32px; }
            .hud-item span { display: block; }
            .hud-item-label { font-family: var(--font-ui), sans-serif; font-size: 11px; font-weight: 700; color: var(--text-muted); letter-spacing: 1px; text-transform: uppercase; margin-bottom: 4px; }
            .hud-item-value { font-size: 15px; color: var(--text-light); font-weight: 600; }
            .btn-hud { display: inline-block; width: 100%; text-align: center; padding: 14px; background: var(--accent-cyan); color: var(--bg-deep); font-weight: 800; border-radius: 4px; text-decoration: none; transition: background 0.2s; }
            .btn-hud:hover { background: var(--text-light); }

            /* Narrative Modules & Premium Typography */
            .narrative-flow { display: flex; flex-direction: column; gap: 80px; padding-top: 12px; }
            .narrative-phase { display: flex; flex-direction: column; }
            
            /* Architectural Headings */
            .phase-header { margin-bottom: 24px; }
            .phase-overline { font-family: var(--font-data); font-size: 12px; color: var(--accent-cyan); letter-spacing: 2px; text-transform: uppercase; margin-bottom: 12px; display: block; }
            .phase-heading { font-size: 32px; font-weight: 800; color: var(--text-light); margin: 0; letter-spacing: -0.5px; }
            
            /* Standardized Body Text */
            .phase-text { font-size: 18px; color: var(--text-muted); line-height: 1.8; margin-bottom: 24px; }
            .phase-text:last-child { margin-bottom: 0; }
            
            /* The Hook (Slightly larger, but still muted) */
            .phase-hook { font-size: 20px; color: var(--text-muted); line-height: 1.8; font-weight: 500; margin: 0; }
            
            /* Visual 1: Telemetry Bars (Corporate Precision) */
            .telemetry-bars { display: flex; flex-direction: column; gap: 24px; background: var(--bg-panel-dark); border: 1px solid var(--border-dark); padding: 32px; border-radius: 4px; margin-top: 16px; }
            .bar-row { display: flex; flex-direction: column; gap: 12px; }
            .bar-meta { display: flex; justify-content: space-between; font-family: var(--font-ui), sans-serif; font-size: 12px; font-weight: 600; color: var(--text-muted); letter-spacing: 1px; text-transform: uppercase; }
            .bar-meta .val { color: var(--text-light); font-weight: 800; font-family: var(--font-data); }
            .bar-track { width: 100%; height: 4px; background: rgba(255,255,255,0.05); border-radius: 2px; overflow: hidden; }
            .bar-fill { height: 100%; background: var(--text-light); border-radius: 2px; } 

            /* Visual 2: Subsystem Matrix (Tech Spec Sheet) */
            .subsystem-matrix { display: flex; flex-direction: column; border-top: 1px solid var(--border-dark); border-bottom: 1px solid var(--border-dark); margin-top: 24px; }
            .matrix-row { display: grid; grid-template-columns: 200px 1fr; border-bottom: 1px solid var(--border-dark); transition: background 0.2s; }
            .matrix-row:last-child { border-bottom: none; }
            .matrix-row:hover { background: rgba(255, 255, 255, 0.02); }
            .matrix-left { padding: 24px 24px 24px 0; font-family: var(--font-ui), sans-serif; font-size: 12px; font-weight: 700; color: var(--text-light); text-transform: uppercase; letter-spacing: 1px; border-right: 1px solid var(--border-dark); }
            .matrix-right { padding: 24px; color: var(--text-muted); font-size: 16px; line-height: 1.6; }

            /* Visual 3: Flight Dashboard (Analytical) */
            .flight-dashboard { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 24px; }
            .dash-card { background: var(--bg-panel-dark); border: 1px solid var(--border-dark); padding: 32px 24px; border-radius: 4px; display: flex; flex-direction: column; justify-content: center; align-items: flex-start; transition: all 0.2s ease; }
            .dash-card:hover { border-color: var(--text-light); background: rgba(255, 255, 255, 0.03); }
            .dash-val { font-size: 40px; font-weight: 800; color: var(--text-light); margin-bottom: 6px; line-height: 1; letter-spacing: -1px; }
            .dash-label { font-family: var(--font-data); font-size: 11px; font-weight: 700; color: var(--accent-cyan); letter-spacing: 1.5px; text-transform: uppercase; }
        </style>

        <!-- Dynamic Architectural Layout -->
        <section style="padding: 80px 0;">
            <div class="container report-grid">
                
                <!-- Column 1: Sticky HUD Anchor -->
                <aside class="hud-anchor">
                    <div class="hud-metric">{{ result | default('N/A') }}</div>
                    <span class="hud-label">OVERALL RESULT</span>
                    <div class="hud-grid">
                        <div class="hud-item"><span class="hud-item-label">MISSION LOG</span><span class="hud-item-value">{{ card_meta }}</span></div>
                        <div class="hud-item"><span class="hud-item-label">HARDWARE DEPLOYED</span><span class="hud-item-value">{{ hardware }}</span></div>
                    </div>
                    <a href="/gallery/" class="btn-hud">View Flight Media ↗</a>
                </aside>

                <!-- Column 2: Narrative Engine -->
                <article class="narrative-flow">
                    
                    {% if report_mode == 'Automation' and automation_payload %}
                        <!-- JSON AUTOMATION PARSER -->
                        {% set rawPayload = automation_payload.code if automation_payload.code else automation_payload %}
                        {% set p = rawPayload | parseJSON %}
                        
                        <!-- Phase 1: Executive Briefing -->
                        <div class="narrative-phase">
                            <div class="phase-header">
                                <span class="phase-overline">{{ p.phase1.overline | default('01 // EXECUTIVE BRIEFING') }}</span>
                                <h3 class="phase-heading">{{ p.phase1.heading | default('Mission Overview & Objectives') }}</h3>
                            </div>
                            <p class="phase-hook">{{ p.phase1.hook }}</p>
                        </div>
                        
                        <!-- Phase 2: Strategy & Analytics -->
                        <div class="narrative-phase">
                            <div class="phase-header">
                                <span class="phase-overline">{{ p.phase2.overline | default('02 // STRATEGY & SCORING') }}</span>
                                <h3 class="phase-heading">{{ p.phase2.heading | default('Competitive Execution') }}</h3>
                            </div>
                            <p class="phase-text">{{ p.phase2.strategy }}</p>
                            <p class="phase-text">{{ p.phase2.execution }}</p>
                            
                            <div class="telemetry-bars">
                                {% for bar in p.phase2.bars %}
                                <div class="bar-row">
                                    <div class="bar-meta"><span>{{ bar.label }}</span><span class="val">{{ bar.val }} / {{ bar.max }}</span></div>
                                    <div class="bar-track"><div class="bar-fill" style="width: {{ (bar.val / bar.max) * 100 }}%"></div></div>
                                </div>
                                {% endfor %}
                            </div>
                        </div>
                        
                        <!-- Phase 3: Technical Context -->
                        <div class="narrative-phase">
                            <div class="phase-header">
                                <span class="phase-overline">{{ p.phase3.overline | default('03 // FIELD VARIABLES') }}</span>
                                <h3 class="phase-heading">{{ p.phase3.heading | default('Environmental Context & Hardware') }}</h3>
                            </div>
                            <p class="phase-text">{{ p.phase3.context }}</p>
                            
                            <div class="subsystem-matrix">
                                {% for row in p.phase3.matrix %}
                                <div class="matrix-row">
                                    <div class="matrix-left">{{ row.sub }}</div>
                                    <div class="matrix-right">{{ row.cap }}</div>
                                </div>
                                {% endfor %}
                            </div>
                        </div>
                        
                        <!-- Phase 4: Flight Dynamics -->
                        <div class="narrative-phase">
                            <div class="phase-header">
                                <span class="phase-overline">{{ p.phase4.overline | default('04 // AERODYNAMICS') }}</span>
                                <h3 class="phase-heading">{{ p.phase4.heading | default('Flight Envelope & Peak Capabilities') }}</h3>
                            </div>
                            <p class="phase-text">{{ p.phase4.dynamics }}</p>
                            
                            <div class="flight-dashboard">
                                {% for stat in p.phase4.dashboard %}
                                <div class="dash-card">
                                    <div class="dash-val">{{ stat.val }}</div>
                                    <div class="dash-label">{{ stat.label }}</div>
                                </div>
                                {% endfor %}
                            </div>
                        </div>
                        
                        <!-- Phase 5: Post-Action -->
                        <div class="narrative-phase">
                            <div class="phase-header">
                                <span class="phase-overline">{{ p.phase5.overline | default('05 // CONCLUSION') }}</span>
                                <h3 class="phase-heading">{{ p.phase5.heading | default('Post-Action Directives') }}</h3>
                            </div>
                            <p class="phase-text">{{ p.phase5.debrief }}</p>
                        </div>
                        
                    {% else %}
                        <!-- LEGACY MANUAL BLOCK BUILDER (Preserved so old pages don't break) -->
                        <div style="font-size: 18px; color: var(--text-muted); line-height: 1.8;">
                            {% for block in blocks %}
                                {% if block.type == 'text_block' %}
                                    {% if block.heading %}
                                        <h3 style="color: var(--text-light); font-size: 24px; font-weight: 800; margin: 48px 0 24px;">{{ block.heading }}</h3>
                                    {% endif %}
                                    <div style="margin-bottom: 24px;">
                                        {{ block.content | safe }}
                                    </div>
                                {% elif block.type == 'image_block' %}
                                    <img src="{{ block.image }}" style="width: 100%; height: auto; border: 1px solid var(--border-dark); border-radius: 4px; margin: 32px 0;" alt="{{ block.alt }}">
                                {% endif %}
                            {% endfor %}
                        </div>
                    {% endif %}

                </article>
            </div>
        </section>
    </main>
