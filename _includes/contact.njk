---
layout: base.njk
title: "AeroClub | Contact"
---
<style>

        /* High-Contrast, Dual-Color Buttons */
        .btn-join { display: inline-block; background: var(--accent-cyan); color: var(--bg-deep); padding: 12px 28px; border-radius: 4px; font-size: 15px; font-weight: 800; border: 1px solid var(--accent-cyan); transition: all 0.2s ease; cursor: pointer; text-align: center; text-decoration: none; }
        .btn-join:hover { background: var(--text-light); color: var(--bg-deep); border-color: var(--text-light); }

        .btn-outline { display: inline-block; padding: 12px 28px; border: 1px solid var(--border-dark); background: transparent; color: var(--text-light); border-radius: 4px; font-size: 15px; font-weight: 800; transition: all 0.2s ease; text-decoration: none; text-align: center; }
        .btn-outline:hover { background: var(--text-light); color: var(--bg-deep); border-color: var(--text-light); }

        /* Contact Typographic Lists */
        .contact-list { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 32px; }
        .contact-item { display: flex; flex-direction: column; gap: 6px; }
        .contact-label { font-family: var(--font-data); color: var(--text-muted); font-size: 12px; letter-spacing: 1px; text-transform: uppercase; }
        .contact-value { font-size: 18px; color: var(--text-light); font-weight: 600; }
        
        .social-links { display: flex; gap: 24px; }
        .social-link { color: var(--accent-cyan); font-weight: 700; font-size: 15px; transition: color 0.2s; text-decoration: none; display: inline-block; }
        .social-link:hover { color: var(--text-light); }

        /* Modern Architectural Form */
        .form-group { margin-bottom: 24px; }
        .form-label { display: block; font-family: var(--font-data); font-size: 12px; color: var(--text-muted); margin-bottom: 8px; letter-spacing: 1px; text-transform: uppercase; }
        .form-input { width: 100%; padding: 16px; border-radius: 4px; border: 1px solid var(--border-dark); background: var(--bg-deep); color: var(--text-light); font-family: var(--font-ui); font-size: 16px; transition: border-color 0.2s ease, box-shadow 0.2s ease; outline: none; }
        .form-input:focus { border-color: var(--text-light); box-shadow: 0 0 0 1px var(--text-light); }

        /* ==========================================
           PAGE CONTENT (HOME PAGE)
        ========================================== */
        .hero {
            height: calc(100vh - 80px);
            background: linear-gradient(to right, rgba(11,17,33,0.95), rgba(11,17,33,0.2)), url('https://images.unsplash.com/photo-1541187764121-717013809cb8?auto=format&fit=crop&q=80&w=2000') center/cover;
            display: flex;
            align-items: center;
        }
        .hero-text h1 { font-size: 64px; font-weight: 800; line-height: 1.1; margin-bottom: 20px; max-width: 800px; letter-spacing: -1px; }
        .hero-text p { font-size: 20px; color: var(--text-muted); max-width: 600px; margin-bottom: 40px; font-family: var(--font-data); }

        /* ==========================================
           GLOBAL FOOTER
        ========================================== */
        footer { background: var(--bg-deep); border-top: 1px solid var(--border-dark); margin-top: auto; }
        .map-container { width: 100%; height: 350px; background: #111; border-bottom: 1px solid var(--border-dark); }
        .map-container iframe { width: 100%; height: 100%; border: 0; filter: invert(90%) hue-rotate(180deg) contrast(1.1); }
        
        .footer-content { padding: 80px 0 40px; display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 40px; border-bottom: 1px solid var(--border-dark); margin-bottom: 24px; }
        .footer-brand .logo { font-size: 24px; font-weight: 800; margin-bottom: 16px; display: block; }
        .footer-brand .logo span { color: var(--accent-cyan); }
        .footer-brand p { color: var(--text-muted); font-size: 14px; line-height: 1.6; margin-bottom: 24px; max-width: 300px; }
        .contact-info li { display: flex; align-items: center; gap: 12px; color: var(--text-muted); font-size: 14px; margin-bottom: 12px; }
        
        .footer-links h4 { font-size: 13px; font-weight: 700; letter-spacing: 1px; margin-bottom: 20px; color: var(--text-light); text-transform: uppercase; }
        .footer-links ul li { margin-bottom: 12px; }
        .footer-links ul a { color: var(--text-muted); font-size: 14px; transition: color 0.2s; }
        .footer-links ul a:hover { color: var(--accent-cyan); }

        .footer-bottom { padding-bottom: 40px; display: flex; justify-content: space-between; align-items: center; color: var(--text-muted); font-size: 14px; }
        
        /* Layout for Content Sections */
        .page-section { padding: 120px 0; min-height: 80vh; border-bottom: 1px solid var(--border-dark); }
        .page-section h2 { font-size: 40px; font-weight: 800; margin-bottom: 24px; color: var(--text-light); }
        .page-section p { font-size: 18px; color: var(--text-muted); }
</style>

<main id="contact-page">
        
        <!-- Standardized Page Header -->
        <section style="padding: 80px 0 40px; border-bottom: 1px solid var(--border-dark);">
            <div class="container">
                <h4 style="font-family: var(--font-data); color: var(--accent-cyan); font-size: 14px; margin-bottom: 12px; letter-spacing: 1px; text-transform: uppercase;">CONTACT US</h4>
                <h2 style="font-size: 48px; font-weight: 800; margin-bottom: 16px; color: var(--text-light); letter-spacing: -1px;">Communications</h2>
                <p style="color: var(--text-muted); font-size: 20px; line-height: 1.6; max-width: 700px;">Direct channels for recruitment, sponsorship inquiries, and institutional partnerships.</p>
            </div>
        </section>

        <section style="padding: 80px 0 100px;">
            <div class="container" style="display: grid; grid-template-columns: 1fr 1fr; gap: 80px;">
                
                <!-- Left: Typography-based Contact Info -->
                <div>
                    <div style="margin-bottom: 40px;">
                        <h4 style="font-family: var(--font-data); color: var(--accent-cyan); font-size: 14px; margin-bottom: 12px; letter-spacing: 1px; text-transform: uppercase;">CONTACT INFORMATION</h4>
                        <h2 style="font-size: 36px; font-weight: 800; color: var(--text-light); letter-spacing: -0.5px;">Headquarters</h2>
                    </div>
                    
                    <ul class="contact-list">
                        <li class="contact-item">
                            <span class="contact-label">Primary Email</span>
                            <span class="contact-value">{{ email }}</span>
                        </li>
                        <li class="contact-item">
                            <span class="contact-label">Facility Location</span>
                            <span class="contact-value" style="white-space: pre-line;">{{ location }}</span>
                        </li>
                        <li class="contact-item">
                            <span class="contact-label">Direct Line</span>
                            <span class="contact-value">{{ phone }}</span>
                        </li>
                    </ul>

                    <div style="margin-top: 48px; border-top: 1px solid var(--border-dark); padding-top: 32px;">
                        <span class="contact-label" style="margin-bottom: 16px; display: block;">Social Network</span>
                        <div class="social-links">
                            {% for social in socials %}
                            <a href="{{ social.url }}" target="_blank" rel="noopener noreferrer" class="social-link">{{ social.platform }} ↗</a>
                            {% endfor %}
                        </div>
                    </div>

                    <!-- New Recruitment Link -->
                    <div style="margin-top: 48px; border-top: 1px solid var(--border-dark); padding-top: 32px;">
                        <span class="contact-label" style="margin-bottom: 16px; display: block;">Division Recruitment</span>
                        <p style="color: var(--text-muted); font-size: 15px; margin-bottom: 24px; line-height: 1.6;">Interested in joining the engineering team? Check our active roster for open positions and technical requirements.</p>
                        <a href="/join_us/" class="btn-outline">View Open Roles</a>
                    </div>
                </div>
                
                <!-- Right: High-End Form -->
                <div style="background: var(--bg-panel-dark); padding: 48px; border-radius: 4px; border: 1px solid var(--border-dark);">
                    <form>
                        <div class="form-group">
                            <label class="form-label">Full Name</label>
                            <input type="text" class="form-input" placeholder="Enter your designation">
                        </div>
                        <div class="form-group">
                            <label class="form-label">Email Address</label>
                            <input type="email" class="form-input" placeholder="Enter routing email">
                        </div>
                        <div class="form-group">
                            <label class="form-label">Inquiry Type</label>
                            <select class="form-input" style="appearance: none; cursor: pointer; color: var(--text-muted);">
                                <option>Sponsorship & Partnership</option>
                                <option>Recruitment</option>
                                <option>Press & Media</option>
                                <option>General Inquiry</option>
                            </select>
                        </div>
                        <div class="form-group" style="margin-bottom: 32px;">
                            <label class="form-label">Transmission Message</label>
                            <textarea rows="4" class="form-input" style="resize: vertical;" placeholder="How can we assist your operations?"></textarea>
                        </div>
                        <button type="submit" class="btn-join" style="width: 100%;">Transmit Message</button>
                    </form>
                </div>
            </div>
        </section>
    </main>
