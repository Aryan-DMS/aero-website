---
layout: base.njk
title: "AeroClub | Contact"
---
<style>

        /* Contact Typographic Lists */
        .contact-list { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 32px; }
        .contact-item { display: flex; flex-direction: column; gap: 8px; align-items: flex-start; }
        .contact-label { font-family: var(--font-ui), -apple-system, BlinkMacSystemFont, sans-serif; color: var(--text-muted); font-size: 13px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; }
        
        /* Minimalist Pill Tags (No gimmicks, pure architecture) */
        .contact-pill { display: inline-flex; align-items: center; gap: 10px; padding: 10px 16px; background: rgba(255, 255, 255, 0.03); border: 1px solid var(--border-dark); border-radius: 40px; color: var(--text-light); font-size: 15px; font-weight: 600; text-decoration: none; transition: all 0.2s ease; cursor: default; }
        a.contact-pill { cursor: pointer; }
        @media (hover: hover) {
            a.contact-pill:hover { background: rgba(14, 165, 233, 0.1); border-color: var(--accent-cyan); color: var(--accent-cyan); transform: translateY(-1px); }
        }
        .contact-pill svg { width: 16px; height: 16px; color: var(--text-muted); transition: color 0.2s ease; }
        @media (hover: hover) {
            a.contact-pill:hover svg { color: var(--accent-cyan); }
        }
        
        /* Multi-line text fix for location pill */
        .contact-pill.location-pill { border-radius: 12px; align-items: flex-start; padding: 14px 16px; }
        .contact-pill.location-pill svg { margin-top: 2px; flex-shrink: 0; }
        
        .social-links { display: flex; gap: 12px; flex-wrap: wrap; }

        /* Premium Solid Action Button */
        .btn-solid-cyan { display: inline-block; padding: 14px 32px; background: var(--accent-cyan); color: var(--bg-deep); font-family: var(--font-ui), sans-serif; font-size: 15px; font-weight: 800; border-radius: 4px; text-decoration: none; transition: all 0.2s cubic-bezier(0.25, 1, 0.5, 1); border: 1px solid var(--accent-cyan); }
        .btn-solid-cyan:hover { background: var(--text-light); color: var(--bg-deep); border-color: var(--text-light); transform: translateY(-2px); box-shadow: 0 10px 20px rgba(14, 165, 233, 0.25); }

        /* ==========================================
           CLEAN ARCHITECTURAL CONTACT FORM
        ========================================== */
        .contact-form-card {
            background: var(--bg-panel-dark);
            border: 1px solid var(--border-dark);
            border-radius: 8px;
            padding: 40px;
        }
        
        .card-header { margin-bottom: 32px; }
        .card-header h4 { font-family: var(--font-ui), -apple-system, BlinkMacSystemFont, sans-serif; font-size: 13px; color: var(--accent-cyan); letter-spacing: 1.5px; text-transform: uppercase; margin-bottom: 8px; font-weight: 700; }
        .card-header h2 { font-size: 32px; font-weight: 800; color: var(--text-light); margin-bottom: 8px; letter-spacing: -0.5px; }
        .card-header p { font-size: 15px; color: var(--text-muted); line-height: 1.5; margin: 0; }
        
        .form-group { margin-bottom: 24px; }
        
        .form-label {
            font-family: var(--font-ui), -apple-system, BlinkMacSystemFont, sans-serif; 
            font-size: 13px; 
            font-weight: 700;
            color: var(--text-light);
            letter-spacing: 1px; 
            text-transform: uppercase; 
            margin-bottom: 10px; 
            display: block;
        }
        
        .form-input, .form-textarea, .form-select {
            width: 100%; 
            background: var(--bg-deep); 
            border: 1px solid var(--border-dark);
            color: var(--text-light); 
            font-family: var(--font-ui), sans-serif;
            font-size: 15px; 
            padding: 14px 16px; 
            border-radius: 4px; 
            outline: none;
            transition: border-color 0.2s ease; 
            box-sizing: border-box;
            appearance: none;
        }
        
        .form-input::placeholder, .form-textarea::placeholder, .form-select:invalid { 
            color: rgba(255,255,255,0.4); 
        }
        
        /* Clean Flat Focus - NO GLOW */
        .form-input:focus, .form-textarea:focus, .form-select:focus {
            border-color: rgba(255,255,255,0.3);
        }
        
        /* Custom Select Arrow */
        .select-wrapper { position: relative; }
        .select-wrapper::after {
            content: '⌄';
            font-size: 20px;
            color: var(--text-muted);
            position: absolute;
            right: 16px;
            top: 45%;
            transform: translateY(-50%);
            pointer-events: none;
        }
        
        .form-textarea { 
            resize: vertical; 
            min-height: 120px; 
        }
        
        .form-submit {
            width: 100%; 
            background: var(--accent-cyan); 
            color: var(--bg-deep);
            border: none; 
            padding: 16px; 
            border-radius: 4px; 
            font-size: 16px; 
            font-weight: 800;
            cursor: pointer; 
            transition: background 0.2s ease; 
            margin-top: 8px;
        }
        
        .form-submit:hover {
            background: var(--text-light); 
        }

        /* ==========================================
           PAGE CONTENT (HOME PAGE)
        ========================================== */
        .hero {
            height: calc(100vh - 80px);
            background: linear-gradient(to right, rgba(11,17,33,0.95), rgba(11,17,33,0.2)), url('https://images.unsplash.com/photo-1541187764121-717013809cb8?auto=format&fit=crop&q=80&w=2000') center/cover;
            display: flex;
            align-items: center;
        }
        .hero-text h1 { font-size: 64px; font-weight: 800; line-height: 1.1; margin-bottom: 20px; max-width: 800px; letter-spacing: -1px; }
        .hero-text p { font-size: 20px; color: var(--text-muted); max-width: 600px; margin-bottom: 40px; font-family: var(--font-data); }

        /* ==========================================
           GLOBAL FOOTER
        ========================================== */
        footer { background: var(--bg-deep); border-top: 1px solid var(--border-dark); margin-top: auto; }
        .map-container { width: 100%; height: 350px; background: #111; border-bottom: 1px solid var(--border-dark); }
        .map-container iframe { width: 100%; height: 100%; border: 0; filter: invert(90%) hue-rotate(180deg) contrast(1.1); }
        
        .footer-content { padding: 80px 0 40px; display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 40px; border-bottom: 1px solid var(--border-dark); margin-bottom: 24px; }
        .footer-brand .logo { font-size: 24px; font-weight: 800; margin-bottom: 16px; display: block; }
        .footer-brand .logo span { color: var(--accent-cyan); }
        .footer-brand p { color: var(--text-muted); font-size: 14px; line-height: 1.6; margin-bottom: 24px; max-width: 300px; }
        .contact-info li { display: flex; align-items: center; gap: 12px; color: var(--text-muted); font-size: 14px; margin-bottom: 12px; }
        
        .footer-links h4 { font-size: 13px; font-weight: 700; letter-spacing: 1px; margin-bottom: 20px; color: var(--text-light); text-transform: uppercase; }
        .footer-links ul li { margin-bottom: 12px; }
        .footer-links ul a { color: var(--text-muted); font-size: 14px; transition: color 0.2s; }
        .footer-links ul a:hover { color: var(--accent-cyan); }

        .footer-bottom { padding-bottom: 40px; display: flex; justify-content: space-between; align-items: center; color: var(--text-muted); font-size: 14px; }
        
        /* Layout for Content Sections */
        .page-section { padding: 120px 0; min-height: 80vh; border-bottom: 1px solid var(--border-dark); }
        .page-section h2 { font-size: 40px; font-weight: 800; margin-bottom: 24px; color: var(--text-light); }
        .page-section p { font-size: 18px; color: var(--text-muted); }
</style>

<main id="contact-page">
        
        <!-- Standardized Page Header -->
        <section style="padding: 80px 0 40px; border-bottom: 1px solid var(--border-dark);">
            <div class="container">
                <h4 style="font-family: var(--font-data); color: var(--accent-cyan); font-size: 14px; margin-bottom: 12px; letter-spacing: 1px; text-transform: uppercase;">CONTACT US</h4>
                <h2 style="font-size: 48px; font-weight: 800; margin-bottom: 16px; color: var(--text-light); letter-spacing: -1px;">Communications</h2>
                <p style="color: var(--text-muted); font-size: 20px; line-height: 1.6; max-width: 700px;">Direct channels for recruitment, sponsorship inquiries, and institutional partnerships.</p>
            </div>
        </section>

        <section style="padding: clamp(60px, 8vw, 100px) 0;">
            <div class="container" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 400px), 1fr)); gap: clamp(40px, 8vw, 80px);">
                
                <!-- Left: Typography-based Contact Info -->
                <div>
                    <div style="margin-bottom: 40px;">
                        <h4 style="font-family: var(--font-data); color: var(--accent-cyan); font-size: 14px; margin-bottom: 12px; letter-spacing: 1px; text-transform: uppercase;">CONTACT INFORMATION</h4>
                        <h2 style="font-size: 36px; font-weight: 800; color: var(--text-light); letter-spacing: -0.5px;">Connect With Us</h2>
                    </div>
                    
                    <ul class="contact-list">
                        <li class="contact-item">
                            <span class="contact-label">Primary Email</span>
                            <a href="mailto:{{ email }}" class="contact-pill">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
                                {{ email }}
                            </a>
                        </li>
                        <li class="contact-item">
                            <span class="contact-label">Facility Location</span>
                            <div class="contact-pill location-pill">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                                <span style="white-space: pre-line; line-height: 1.5;">{{ location }}</span>
                            </div>
                        </li>
                        <li class="contact-item">
                            <span class="contact-label">Direct Line</span>
                            <a href="tel:{{ phone | replace(' ', '') }}" class="contact-pill">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
                                {{ phone }}
                            </a>
                        </li>
                    </ul>

                    <div style="margin-top: 48px; border-top: 1px solid var(--border-dark); padding-top: 32px;">
                        <span class="contact-label" style="margin-bottom: 16px; display: block;">Social Network</span>
                        <div class="social-links">
                            {% for social in socials %}
                            <a href="{{ social.url }}" target="_blank" rel="noopener noreferrer" class="contact-pill">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg>
                                {{ social.platform }}
                            </a>
                            {% endfor %}
                        </div>
                    </div>

                    <!-- Strategic Sponsorship Link -->
                    <div style="margin-top: 48px; border-top: 1px solid var(--border-dark); padding-top: 40px;">
                        <span class="contact-label" style="margin-bottom: 16px; display: block; color: var(--accent-cyan);">Corporate Partnerships</span>
                        <p style="color: var(--text-muted); font-size: 18px; margin-bottom: 32px; line-height: 1.6;">Partner with our engineering division to support autonomous flight innovation and access top-tier aerospace talent.</p>
                        <a href="/sponsor_us/" class="btn-solid-cyan">Sponsor Our Team</a>
                    </div>
                </div>
                
                <!-- Right: High-End Form (Mailto Integration) -->
                <div class="contact-form-card">
                    <div class="card-header">
                        <h4>GET IN TOUCH</h4>
                        <h2>Contact Our Team</h2>
                        <p>Have a question, collaboration idea, or general inquiry? We'd love to hear from you.</p>
                    </div>
                    
                    <form id="contactForm" onsubmit="sendEmail(event)">
                        <div class="form-group">
                            <label class="form-label">FULL NAME</label>
                            <input type="text" id="senderName" class="form-input" placeholder="Enter your name" required>
                        </div>
                        
                        <div class="form-group">
                            <label class="form-label">EMAIL ADDRESS</label>
                            <input type="email" id="senderEmail" class="form-input" placeholder="Enter your email" required>
                        </div>
                        
                        <div class="form-group">
                            <label class="form-label">INQUIRY TYPE</label>
                            <input type="text" id="inquiryType" class="form-input" placeholder="e.g. Recruitment, Doubts, General" required>
                        </div>
                        
                        <div class="form-group">
                            <label class="form-label">MESSAGE</label>
                            <textarea id="senderMessage" class="form-textarea" placeholder="How can we assist you?" required></textarea>
                        </div>
                        
                        <button type="submit" class="form-submit">Send Message</button>
                    </form>
                </div>
            </div>
        </section>
    </main>

    <script>
        function sendEmail(event) {
            event.preventDefault(); 
            
            const name = document.getElementById('senderName').value;
            const email = document.getElementById('senderEmail').value;
            const inquiry = document.getElementById('inquiryType').value;
            const message = document.getElementById('senderMessage').value;
            
            // Construct a natural, professional letter template
            const body = `Dear Aerial Martial Team,

My name is ${name}, and I am reaching out to you today regarding: ${inquiry}.

${message}

Thank you for your time and consideration. I look forward to connecting with you soon.

Best regards,

${name}
${email}`;
            
            const encodedBody = encodeURIComponent(body);
            const targetEmail = "contact@aerialmartial.edu.in"; 
            
            // Dynamically set the subject line
            const subject = encodeURIComponent(`Aerial Martial Inquiry: ${inquiry} - ${name}`);
            
            // Fire the mailto protocol to open default mail app
            window.location.href = `mailto:${targetEmail}?subject=${subject}&body=${encodedBody}`;
        }
    </script>
