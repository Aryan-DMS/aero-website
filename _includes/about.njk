---
layout: base.njk
title: "AeroClub | About"
---
<style>

        /* High-Contrast, Dual-Color Buttons */
        .btn-join { display: inline-block; background: var(--accent-cyan); color: var(--bg-deep); padding: 12px 28px; border-radius: 4px; font-size: 15px; font-weight: 800; border: 1px solid var(--accent-cyan); transition: all 0.2s ease; }
        .btn-join:hover { background: var(--text-light); color: var(--bg-deep); border-color: var(--text-light); }

        .btn-outline { display: inline-block; padding: 12px 28px; border: 1px solid var(--border-dark); background: transparent; color: var(--text-light); border-radius: 4px; font-size: 15px; font-weight: 800; transition: all 0.2s ease; }
        .btn-outline:hover { background: var(--text-light); color: var(--bg-deep); border-color: var(--text-light); }

        /* ==========================================
           PAGE CONTENT (HOME PAGE)
        ========================================== */
        .hero {
            height: calc(100vh - 80px);
            background: linear-gradient(to right, rgba(11,17,33,0.95), rgba(11,17,33,0.2)), url('https://images.unsplash.com/photo-1541187764121-717013809cb8?auto=format&fit=crop&q=80&w=2000') center/cover;
            display: flex;
            align-items: center;
        }
        .hero-text h1 { font-size: 64px; font-weight: 800; line-height: 1.1; margin-bottom: 20px; max-width: 800px; letter-spacing: -1px; }
        .hero-text p { font-size: 20px; color: var(--text-muted); max-width: 600px; margin-bottom: 40px; font-family: var(--font-data); }

        /* ==========================================
           GLOBAL FOOTER
        ========================================== */
        footer { background: var(--bg-deep); border-top: 1px solid var(--border-dark); margin-top: auto; }
        .map-container { width: 100%; height: 350px; background: #111; border-bottom: 1px solid var(--border-dark); }
        .map-container iframe { width: 100%; height: 100%; border: 0; filter: invert(90%) hue-rotate(180deg) contrast(1.1); }
        
        .footer-content { padding: 80px 0 40px; display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 40px; border-bottom: 1px solid var(--border-dark); margin-bottom: 24px; }
        .footer-brand .logo { font-size: 24px; font-weight: 800; margin-bottom: 16px; display: block; }
        .footer-brand .logo span { color: var(--accent-cyan); }
        .footer-brand p { color: var(--text-muted); font-size: 14px; line-height: 1.6; margin-bottom: 24px; max-width: 300px; }
        .contact-info li { display: flex; align-items: center; gap: 12px; color: var(--text-muted); font-size: 14px; margin-bottom: 12px; }
        
        .footer-links h4 { font-size: 13px; font-weight: 700; letter-spacing: 1px; margin-bottom: 20px; color: var(--text-light); text-transform: uppercase; }
        .footer-links ul li { margin-bottom: 12px; }
        .footer-links ul a { color: var(--text-muted); font-size: 14px; transition: color 0.2s; }
        .footer-links ul a:hover { color: var(--accent-cyan); }

        .footer-bottom { padding-bottom: 40px; display: flex; justify-content: space-between; align-items: center; color: var(--text-muted); font-size: 14px; }
        
        /* Layout for Content Sections */
        .page-section { padding: 120px 0; min-height: 80vh; border-bottom: 1px solid var(--border-dark); }
        .page-section h2 { font-size: 40px; font-weight: 800; margin-bottom: 24px; color: var(--text-light); }
        .page-section p { font-size: 18px; color: var(--text-muted); }

        /* ==========================================
           MOBILE STACKING OVERRIDES
        ========================================== */
        @media (max-width: 960px) {
            /* Switches to flex and reverses order so the Image (2nd item) loads above the Text (1st item) */
            .about-overview-grid { display: flex !important; flex-direction: column-reverse !important; gap: 40px !important; }
            
            .about-philosophy-grid { grid-template-columns: 1fr !important; gap: 40px !important; }
            
            /* Removes the ugly 100% stretch and allows buttons to wrap naturally with their proper padding */
            .about-buttons { flex-direction: row !important; flex-wrap: wrap !important; align-items: flex-start !important; width: auto !important; }
            .about-buttons a { width: fit-content !important; }
            
            .about-buttons-center { flex-direction: row !important; flex-wrap: wrap !important; justify-content: center !important; width: auto !important; }
            .about-buttons-center a { width: fit-content !important; }
        }
</style>

<main id="about-page">
        
        <!-- Standardized Page Header -->
        <section style="padding: 80px 0 40px; border-bottom: 1px solid var(--border-dark);">
            <div class="container">
                <h4 style="font-family: var(--font-data); color: var(--accent-cyan); font-size: 14px; margin-bottom: 12px; letter-spacing: 1px; text-transform: uppercase;">DIVISION ORIGINS</h4>
                <h2 style="font-size: 48px; font-weight: 800; margin-bottom: 16px; color: var(--text-light); letter-spacing: -1px;">About AeroClub</h2>
                <p style="color: var(--text-muted); font-size: 20px; line-height: 1.6; max-width: 700px;">Bridging the gap between theoretical aerodynamics and applied, competition-grade manufacturing since 2015.</p>
            </div>
        </section>

        <!-- Sub-section 1: Division Overview (Image on Right) -->
        <section style="padding: clamp(40px, 8vw, 80px) 0;">
            <div class="container about-overview-grid" style="display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: center;">
                <div>
                    <div style="margin-bottom: 32px;">
                        <h4 style="font-family: var(--font-data); color: var(--accent-cyan); font-size: 14px; margin-bottom: 12px; letter-spacing: 1px; text-transform: uppercase;">{{ overview.subtitle }}</h4>
                        <h2 style="font-size: 36px; font-weight: 800; color: var(--text-light); letter-spacing: -0.5px;">Division Overview</h2>
                    </div>
                    <div style="color: var(--text-muted); font-size: 18px; line-height: 1.8; margin-bottom: 32px; max-width: 65ch;">
                        {{ overview.body | markdown | safe }}
                    </div>
                    
                    <!-- Inline Navigation -->
                    <div class="about-buttons" style="display: flex; gap: 16px;">
                        <a href="/team/" class="btn-join" style="padding: 12px 28px; font-size: 15px;">Meet the Team</a>
                        <a href="/models/" class="btn-outline" style="padding: 12px 28px; font-size: 15px;">View The Fleet</a>
                    </div>
                </div>
                <div style="border-radius: 4px; overflow: hidden; border: 1px solid var(--border-dark);">
                    <img src="{{ overview.image }}" alt="Division Overview" style="width: 100%; height: auto; display: block; filter: contrast(1.1) brightness(0.9) grayscale(20%);">
                </div>
            </div>
        </section>

        <!-- Sub-section 2: Engineering Philosophy (Pure Text Grid) -->
        <section style="padding: clamp(60px, 8vw, 80px) 0; background: var(--bg-panel-dark); border-top: 1px solid var(--border-dark); border-bottom: 1px solid var(--border-dark);">
            <div class="container">
                <div style="margin-bottom: 40px;">
                    <h4 style="font-family: var(--font-data); color: var(--accent-cyan); font-size: 14px; margin-bottom: 12px; letter-spacing: 1px; text-transform: uppercase;">CORE VALUES</h4>
                    <h2 style="font-size: 36px; font-weight: 800; color: var(--text-light); letter-spacing: -0.5px;">Engineering Philosophy</h2>
                </div>
                <div class="about-philosophy-grid" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 40px;">
                    {% for pillar in philosophy %}
                    <div>
                        <h4 style="font-family: var(--font-data); font-size: 13px; color: var(--accent-cyan); margin-bottom: 16px; letter-spacing: 1px; text-transform: uppercase;">0{{ loop.index }} // {{ pillar.title }}</h4>
                        <div style="color: var(--text-muted); line-height: 1.7; font-size: 16px;">
                            {{ pillar.body }}
                        </div>
                    </div>
                    {% endfor %}
                </div>
            </div>
        </section>

        <!-- Sub-section 3: Scope of Operations (Pure Text + Funnel) -->
        <section style="padding: 80px 0 100px;">
            <div class="container" style="max-width: 800px; margin: 0 auto; text-align: center;">
                <div style="margin-bottom: 32px;">
                    <h4 style="font-family: var(--font-data); color: var(--accent-cyan); font-size: 14px; margin-bottom: 12px; letter-spacing: 1px; text-transform: uppercase;">OPERATIONAL DOMAIN</h4>
                    <h2 style="font-size: 36px; font-weight: 800; color: var(--text-light); letter-spacing: -0.5px;">Scope of Operations</h2>
                </div>
                <div style="color: var(--text-muted); font-size: 18px; line-height: 1.8; margin-bottom: 40px;">
                    {{ scope | markdown | safe }}
                </div>
                
                <!-- Inline Navigation -->
                <div class="about-buttons-center" style="display: flex; gap: 16px; justify-content: center;">
                    <a href="/achievements/" class="btn-outline" style="padding: 12px 28px; font-size: 15px;">View Track Record</a>
                    <a href="/gallery/" class="btn-outline" style="padding: 12px 28px; font-size: 15px;">Explore Facilities</a>
                </div>
            </div>
        </section>

    </main>
