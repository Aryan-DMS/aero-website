---
layout: base.njk
title: "AeroClub | Team"
---
<style>

        /* High-Contrast, Dual-Color Buttons */
        .btn-join { display: inline-block; background: var(--accent-cyan); color: var(--bg-deep); padding: 12px 28px; border-radius: 4px; font-size: 15px; font-weight: 800; border: 1px solid var(--accent-cyan); transition: all 0.2s ease; }
        .btn-join:hover { background: var(--text-light); color: var(--bg-deep); border-color: var(--text-light); }

        .btn-outline { display: inline-block; padding: 12px 28px; border: 1px solid var(--border-dark); background: transparent; color: var(--text-light); border-radius: 4px; font-size: 15px; font-weight: 800; transition: all 0.2s ease; }
        .btn-outline:hover { background: var(--text-light); color: var(--bg-deep); border-color: var(--text-light); }

        /* Architectural Team Cards */
        .team-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 24px; }
        .team-card { background: var(--bg-deep); border: 1px solid var(--border-dark); border-radius: 4px; display: block; overflow: hidden; transition: border-color 0.2s ease; }
        .team-card:hover { border-color: var(--text-light); }
        
        .team-img { height: 260px; overflow: hidden; border-bottom: 1px solid var(--border-dark); background: #1E293B; }
        .team-img img { width: 100%; height: 100%; object-fit: cover; filter: contrast(1.1); transition: transform 0.4s ease; }
        .team-card:hover .team-img img { transform: scale(1.03); }
        
        .team-info { padding: 20px; }
        .team-info h4 { font-size: 18px; margin-bottom: 4px; color: var(--text-light); transition: color 0.2s; }
        .team-info p { font-family: var(--font-data); font-size: 12px; color: var(--accent-cyan); letter-spacing: 1px; text-transform: uppercase; }

        /* ==========================================
           PAGE CONTENT (HOME PAGE)
        ========================================== */
        .hero {
            height: calc(100vh - 80px);
            background: linear-gradient(to right, rgba(11,17,33,0.95), rgba(11,17,33,0.2)), url('https://images.unsplash.com/photo-1541187764121-717013809cb8?auto=format&fit=crop&q=80&w=2000') center/cover;
            display: flex;
            align-items: center;
        }
        .hero-text h1 { font-size: 64px; font-weight: 800; line-height: 1.1; margin-bottom: 20px; max-width: 800px; letter-spacing: -1px; }
        .hero-text p { font-size: 20px; color: var(--text-muted); max-width: 600px; margin-bottom: 40px; font-family: var(--font-data); }

        /* ==========================================
           GLOBAL FOOTER
        ========================================== */
        footer { background: var(--bg-deep); border-top: 1px solid var(--border-dark); margin-top: auto; }
        .map-container { width: 100%; height: 350px; background: #111; border-bottom: 1px solid var(--border-dark); }
        .map-container iframe { width: 100%; height: 100%; border: 0; filter: invert(90%) hue-rotate(180deg) contrast(1.1); }
        
        .footer-content { padding: 80px 0 40px; display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 40px; border-bottom: 1px solid var(--border-dark); margin-bottom: 24px; }
        .footer-brand .logo { font-size: 24px; font-weight: 800; margin-bottom: 16px; display: block; }
        .footer-brand .logo span { color: var(--accent-cyan); }
        .footer-brand p { color: var(--text-muted); font-size: 14px; line-height: 1.6; margin-bottom: 24px; max-width: 300px; }
        .contact-info li { display: flex; align-items: center; gap: 12px; color: var(--text-muted); font-size: 14px; margin-bottom: 12px; }
        
        .footer-links h4 { font-size: 13px; font-weight: 700; letter-spacing: 1px; margin-bottom: 20px; color: var(--text-light); text-transform: uppercase; }
        .footer-links ul li { margin-bottom: 12px; }
        .footer-links ul a { color: var(--text-muted); font-size: 14px; transition: color 0.2s; }
        .footer-links ul a:hover { color: var(--accent-cyan); }

        .footer-bottom { padding-bottom: 40px; display: flex; justify-content: space-between; align-items: center; color: var(--text-muted); font-size: 14px; }
        
        /* Layout for Content Sections */
        .page-section { padding: 120px 0; min-height: 80vh; border-bottom: 1px solid var(--border-dark); }
        .page-section h2 { font-size: 40px; font-weight: 800; margin-bottom: 24px; color: var(--text-light); }
        .page-section p { font-size: 18px; color: var(--text-muted); }
</style>

<main id="team-page">
        
        <style>
            /* Specific border adjustment for cards inside the lighter panel-dark background */
            .team-card-dark { border-color: rgba(255,255,255,0.1); }
        </style>
        
        {# Reusable Card Macro to keep the HTML clean and DRY #}
        {% macro teamCard(member, isDarkPanel) %}
        <a href="{{ member.url }}" class="team-card {% if isDarkPanel %}team-card-dark{% endif %}">
            <div class="team-img"><img src="{{ member.data.image }}" alt="{{ member.data.name }}"></div>
            <div class="team-info"><h4>{{ member.data.name }}</h4><p>{{ member.data.role }}</p></div>
        </a>
        {% endmacro %}

        <!-- FULL WIDTH HEADER SECTION -->
        <section style="padding: 80px 0 32px; border-bottom: 1px solid var(--border-dark); background: var(--bg-deep);">
            <div class="container">
                <h4 style="font-family: var(--font-data); color: var(--accent-cyan); font-size: 14px; margin-bottom: 12px; letter-spacing: 1px; text-transform: uppercase;">ENGINEERING TEAM</h4>
                <h2 style="font-size: 48px; font-weight: 800; margin-bottom: 16px; color: var(--text-light); letter-spacing: -1px;">Our Team</h2>
                <p style="color: var(--text-muted); font-size: 20px; line-height: 1.6; max-width: 700px; margin: 0;">The engineers, designers, and operators driving our autonomous flight programs.</p>
            </div>
        </section>
        
        <!-- COMPACT FACULTY SECTION -->
        <section style="padding: 32px 0 60px; background: var(--bg-deep);">
            <div class="container">
                <div style="margin-bottom: 24px;">
                    <h3 style="font-size: 24px; font-weight: 800; color: var(--text-light); letter-spacing: -0.5px;">Faculty Advisors</h3>
                </div>
                <div class="team-grid">
                    {% for member in collections.personnel %}
                        {% if member.data.division == 'Faculty Advisor' %}
                            {{ teamCard(member, false) }}
                        {% endif %}
                    {% endfor %}
                </div>
            </div>
        </section>

        <!-- MACRO-SECTION 2: CORE TEAM (The VIP Sweeps) -->
        <section style="padding: 80px 0; background: var(--bg-panel-dark);">
            <div class="container">
                <div style="margin-bottom: 48px;">
                    <h4 style="font-family: var(--font-data); color: var(--accent-cyan); font-size: 14px; margin-bottom: 8px; letter-spacing: 1px; text-transform: uppercase;">TEAM DIVISION</h4>
                    <h3 style="font-size: 32px; font-weight: 800; color: var(--text-light); letter-spacing: -0.5px;">Core Team</h3>
                </div>
                <div class="team-grid">
                    
                    <!-- Sweep 1: Captain -->
                    {% for member in collections.personnel %}
                        {% if member.data.division == 'Core Team' and member.data.role == 'Captain' %}
                            {{ teamCard(member, true) }}
                        {% endif %}
                    {% endfor %}
                    
                    <!-- Sweep 2: Vice Captain -->
                    {% for member in collections.personnel %}
                        {% if member.data.division == 'Core Team' and (member.data.role == 'Vice Captain' or member.data.role == 'Vice-Captain') %}
                            {{ teamCard(member, true) }}
                        {% endif %}
                    {% endfor %}
                    
                    <!-- Sweep 3: Heads & Leads -->
                    {% for member in collections.personnel %}
                        {% if member.data.division == 'Core Team' %}
                            {% if ('Head' in member.data.role or 'Lead' in member.data.role) and member.data.role != 'Captain' and member.data.role != 'Vice Captain' and member.data.role != 'Vice-Captain' %}
                                {{ teamCard(member, true) }}
                            {% endif %}
                        {% endif %}
                    {% endfor %}
                    
                    <!-- Sweep 4: Standard Members -->
                    {% for member in collections.personnel %}
                        {% if member.data.division == 'Core Team' %}
                            {% if not ('Head' in member.data.role or 'Lead' in member.data.role or member.data.role == 'Captain' or member.data.role == 'Vice Captain' or member.data.role == 'Vice-Captain') %}
                                {{ teamCard(member, true) }}
                            {% endif %}
                        {% endif %}
                    {% endfor %}
                    
                </div>
            </div>
        </section>

        <!-- MACRO-SECTION 3: JUNIORS -->
        <section style="padding: 80px 0; background: var(--bg-deep);">
            <div class="container">
                <div style="margin-bottom: 48px;">
                    <h4 style="font-family: var(--font-data); color: var(--accent-cyan); font-size: 14px; margin-bottom: 8px; letter-spacing: 1px; text-transform: uppercase;">TEAM DIVISION</h4>
                    <h3 style="font-size: 32px; font-weight: 800; color: var(--text-light); letter-spacing: -0.5px;">Juniors</h3>
                </div>
                <div class="team-grid">
                    {% for member in collections.personnel %}
                        {% if member.data.division == 'Juniors' %}
                            {{ teamCard(member, false) }}
                        {% endif %}
                    {% endfor %}
                </div>
            </div>
        </section>

    </main>
