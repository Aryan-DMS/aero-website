---
layout: base.njk
---
<main id="hardware-report">
        
        <!-- Massive Cinematic Header -->
        <section style="height: 70vh; background: linear-gradient(to top, var(--bg-deep) 5%, transparent 60%), url('{{ image }}') center/cover; position: relative; display: flex; align-items: flex-end; padding-bottom: 60px; border-bottom: 1px solid var(--border-dark);">
            <div class="container" style="width: 100%;">
                <a href="/models/" style="font-family: var(--font-data); color: var(--text-muted); text-transform: uppercase; font-size: 13px; display: inline-flex; align-items: center; gap: 8px; margin-bottom: 24px; transition: color 0.2s;">← Back to Fleet</a>
                <span style="display: block; color: var(--accent-cyan); font-family: var(--font-data); letter-spacing: 1px; margin-bottom: 16px;">{{ hero_meta }}</span>
                <h1 style="font-size: 64px; font-weight: 900; line-height: 1.1; max-width: 900px; letter-spacing: -2px;">{{ title }}</h1>
            </div>
        </section>

        <!-- Technical Layout -->
        <section style="padding: 80px 0 100px;">
            <div class="container" style="display: grid; grid-template-columns: 340px 1fr; gap: 80px; align-items: start;">
                
                <!-- Left Column: Raw Data & Specifications -->
                <div>
                    <h4 style="font-family: var(--font-data); color: var(--text-muted); font-size: 14px; margin-bottom: 24px; letter-spacing: 1px;">HARDWARE DATA</h4>
                    
                    <div style="background: var(--bg-panel-dark); border: 1px solid var(--border-dark); padding: 32px; border-radius: 4px; margin-bottom: 32px;">
                        
                        <!-- Dimension Block -->
                        {% if dimensions %}
                        <div style="margin-bottom: 24px;">
                            <h5 style="color: var(--accent-cyan); font-family: var(--font-data); font-size: 11px; text-transform: uppercase; margin-bottom: 16px; border-bottom: 1px solid var(--border-dark); padding-bottom: 8px;">Physical Dimensions</h5>
                            {% for spec in dimensions %}
                            <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
                                <span style="color: var(--text-muted); font-size: 14px;">{{ spec.label }}</span>
                                <span style="color: var(--text-light); font-weight: 700; font-size: 14px; text-align: right; max-width: 50%;">{{ spec.value }}</span>
                            </div>
                            {% endfor %}
                        </div>
                        {% endif %}

                        <!-- Systems Block -->
                        {% if systems %}
                        <div>
                            <h5 style="color: var(--accent-cyan); font-family: var(--font-data); font-size: 11px; text-transform: uppercase; margin-bottom: 16px; border-bottom: 1px solid var(--border-dark); padding-bottom: 8px;">Avionics & Power</h5>
                            {% for spec in systems %}
                            <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
                                <span style="color: var(--text-muted); font-size: 14px;">{{ spec.label }}</span>
                                <span style="color: var(--text-light); font-weight: 700; font-size: 14px; text-align: right; max-width: 50%;">{{ spec.value }}</span>
                            </div>
                            {% endfor %}
                        </div>
                        {% endif %}
                        
                    </div>
                </div>

                <!-- Right Column: Engineering Narrative -->
                <div style="font-size: 18px; color: var(--text-muted); line-height: 1.8;">
                    <h2 style="font-size: 32px; font-weight: 800; margin-bottom: 24px; color: var(--text-light);">Engineering Summary</h2>
                    {% for block in blocks %}
                        {% if block.type == 'text_block' %}
                            {% if block.heading %}
                                <h3 style="color: var(--text-light); font-size: 24px; font-weight: 800; margin: 48px 0 24px;">{{ block.heading }}</h3>
                            {% endif %}
                            <div style="margin-bottom: 24px;">
                                {{ block.content | safe }}
                            </div>
                        {% elif block.type == 'image_block' %}
                            <img src="{{ block.image }}" style="width: 100%; height: auto; border: 1px solid var(--border-dark); border-radius: 4px; margin: 32px 0;" alt="{{ block.alt }}">
                        {% endif %}
                    {% endfor %}
                </div>

            </div>
        </section>
    </main>
