---
layout: base.njk
---
<main id="hardware-report">

        {# --- MASTER ROUTING ENGINE (Handles backwards compatibility) --- #}
        {% set legacyMode = report_mode | default('Automation') %}
        {% set mode = card.report_mode | default(legacyMode) %}
        
        {# Extract base fallback variables so legacy files don't crash #}
        {% set baseTitle = card.title | default(title) %}
        {% set baseImage = card.image | default(image) %}
        {% set baseMeta = card.meta | default(card_meta) %}
        
        {% if mode == 'Automation' %}
            {# Attempt to pull from new Automation Box, fallback to old Report box #}
            {% set rawPayload = automation.payload.code if automation.payload.code else automation.payload %}
            {% if not rawPayload %}{% set rawPayload = automation_payload.code if automation_payload.code else automation_payload %}{% endif %}
            {% set p = rawPayload | parseJSON %}
            
            {% set heroMeta = p.hero_meta | default(hero_meta) | default('ACTIVE DEPLOYMENT') %}
            {% set secMetrics = p.metrics %}
            
        {% else %}
            {# Attempt to pull from new Manual Box, fallback to legacy variables #}
            {% set heroMeta = manual.hero_meta | default(hero_meta) | default('ACTIVE DEPLOYMENT') %}
            {% set secMetrics = manual.metrics %}
            
            {# Legacy Manual Fallback for old HUD variables #}
            {% if not secMetrics %}
                {% set secMetrics = [
                    {label: "CLASSIFICATION", value: baseMeta | default('EXPERIMENTAL')},
                    {label: "STATUS", value: heroMeta}
                ] %}
            {% endif %}
        {% endif %}
        
        <!-- Massive Cinematic Header -->
        <section style="height: 70vh; background: linear-gradient(to top, var(--bg-deep) 5%, transparent 60%), url('{{ baseImage }}') center/cover; position: relative; display: flex; align-items: flex-end; padding-bottom: 60px; border-bottom: 1px solid var(--border-dark);">
            <div class="container" style="width: 100%;">
                <a href="/models/" style="font-family: var(--font-data); color: var(--text-muted); text-transform: uppercase; font-size: 13px; display: inline-flex; align-items: center; gap: 8px; margin-bottom: 24px; transition: color 0.2s;">← Back to Fleet</a>
                <span style="display: block; color: var(--accent-cyan); font-family: var(--font-data); letter-spacing: 1px; margin-bottom: 16px;">{{ heroMeta }}</span>
                <h1 style="font-size: 64px; font-weight: 900; line-height: 1.1; max-width: 900px; letter-spacing: -2px;">{{ baseTitle }}</h1>
            </div>
        </section>

        <style>
            /* The 30/70 Macro Grid */
            .report-grid { display: grid; grid-template-columns: 320px 1fr; gap: 60px; align-items: start; }
            @media (max-width: 1024px) { .report-grid { grid-template-columns: 1fr; } }
            
            /* Sticky HUD Anchor */
            .hud-anchor { position: sticky; top: 120px; background: var(--bg-panel-dark); border: 1px solid var(--border-dark); padding: 32px; border-radius: 8px; }
            .hud-metric { font-size: 48px; font-weight: 900; color: var(--text-light); line-height: 1.1; margin-bottom: 8px; letter-spacing: -1px; text-transform: uppercase; }
            .hud-label { font-family: var(--font-ui), sans-serif; font-size: 12px; font-weight: 700; color: var(--accent-cyan); letter-spacing: 1.5px; text-transform: uppercase; margin-bottom: 32px; display: block; }
            .hud-grid { display: flex; flex-direction: column; gap: 20px; margin-bottom: 32px; }
            .hud-item span { display: block; }
            .hud-item-label { font-family: var(--font-ui), sans-serif; font-size: 11px; font-weight: 700; color: var(--text-muted); letter-spacing: 1px; text-transform: uppercase; margin-bottom: 4px; }
            .hud-item-value { font-size: 15px; color: var(--text-light); font-weight: 600; }
            .btn-hud { display: inline-block; width: 100%; text-align: center; padding: 14px; background: var(--text-light); color: var(--bg-deep); font-weight: 800; border-radius: 4px; text-decoration: none; transition: background 0.2s; }
            .btn-hud:hover { background: var(--accent-cyan); }

            /* Narrative Modules & Premium Typography */
            .narrative-flow { display: flex; flex-direction: column; gap: 80px; padding-top: 12px; }
            .narrative-phase { display: flex; flex-direction: column; }
            
            /* Architectural Headings */
            .phase-header { margin-bottom: 24px; }
            .phase-overline { font-family: var(--font-data); font-size: 12px; color: var(--accent-cyan); letter-spacing: 2px; text-transform: uppercase; margin-bottom: 12px; display: block; }
            .phase-heading { font-size: 32px; font-weight: 800; color: var(--text-light); margin: 0; letter-spacing: -0.5px; }
            
            /* Standardized Body Text */
            .phase-text { font-size: 18px; color: var(--text-muted); line-height: 1.8; margin-bottom: 24px; }
            .phase-text:last-child { margin-bottom: 0; }
            .phase-hook { font-size: 20px; color: var(--text-muted); line-height: 1.8; font-weight: 500; margin: 0; }

            /* Visual 1: Tech Spec Matrix */
            .subsystem-matrix { display: flex; flex-direction: column; border-top: 1px solid var(--border-dark); border-bottom: 1px solid var(--border-dark); margin-top: 24px; }
            .matrix-row { display: grid; grid-template-columns: 200px 1fr; border-bottom: 1px solid var(--border-dark); transition: background 0.2s; }
            .matrix-row:last-child { border-bottom: none; }
            .matrix-row:hover { background: rgba(255, 255, 255, 0.02); }
            .matrix-left { padding: 24px 24px 24px 0; font-family: var(--font-ui), sans-serif; font-size: 12px; font-weight: 700; color: var(--text-light); text-transform: uppercase; letter-spacing: 1px; border-right: 1px solid var(--border-dark); }
            .matrix-right { padding: 24px; color: var(--text-muted); font-size: 16px; line-height: 1.6; }

            /* Visual 2: Propulsion Dashboard */
            .flight-dashboard { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 24px; }
            .dash-card { background: var(--bg-panel-dark); border: 1px solid var(--border-dark); padding: 32px 24px; border-radius: 4px; display: flex; flex-direction: column; justify-content: center; align-items: flex-start; transition: all 0.2s ease; }
            .dash-card:hover { border-color: var(--text-light); background: rgba(255, 255, 255, 0.03); }
            .dash-val { font-size: 40px; font-weight: 800; color: var(--text-light); margin-bottom: 6px; line-height: 1; letter-spacing: -1px; }
            .dash-label { font-family: var(--font-data); font-size: 11px; font-weight: 700; color: var(--accent-cyan); letter-spacing: 1.5px; text-transform: uppercase; }

            /* Visual 3: Capability Index (Bars) */
            .telemetry-bars { display: flex; flex-direction: column; gap: 24px; background: var(--bg-panel-dark); border: 1px solid var(--border-dark); padding: 32px; border-radius: 4px; margin-top: 16px; }
            .bar-row { display: flex; flex-direction: column; gap: 12px; }
            .bar-meta { display: flex; justify-content: space-between; font-family: var(--font-ui), sans-serif; font-size: 12px; font-weight: 600; color: var(--text-muted); letter-spacing: 1px; text-transform: uppercase; }
            .bar-meta .val { color: var(--text-light); font-weight: 800; font-family: var(--font-data); }
            .bar-track { width: 100%; height: 4px; background: rgba(255,255,255,0.05); border-radius: 2px; overflow: hidden; }
            .bar-fill { height: 100%; background: var(--text-light); border-radius: 2px; } 
            
            /* Up Next Recommendation Block */
            .next-report { border-top: 1px solid var(--border-dark); background: var(--bg-panel-dark); padding: 80px 20px; text-align: center; transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1); display: block; text-decoration: none; }
            .next-report:hover { background: var(--bg-deep); border-top-color: var(--accent-cyan); }
            .next-report:hover .next-title { color: var(--accent-cyan); transform: translateX(12px); }
            .next-label { font-family: var(--font-data); color: var(--text-muted); font-size: 13px; letter-spacing: 2px; text-transform: uppercase; display: block; margin-bottom: 12px; transition: color 0.3s ease; }
            .next-report:hover .next-label { color: var(--text-light); }
            .next-title { font-size: 48px; font-weight: 900; color: var(--text-light); letter-spacing: -1px; margin: 0; transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1); display: inline-block; }
        </style>

        <!-- Dynamic Architectural Layout -->
        <section style="padding: 80px 0;">
            <div class="container report-grid">
                
                <!-- Column 1: Sticky Hardware Anchor -->
                <aside class="hud-anchor">
                    <div class="hud-metric">{{ baseTitle }}</div>
                    <span class="hud-label">PLATFORM REGISTRATION</span>
                    
                    {% if secMetrics %}
                    <div class="hud-grid">
                        {% for metric in secMetrics %}
                        <div class="hud-item"><span class="hud-item-label">{{ metric.label }}</span><span class="hud-item-value">{{ metric.value }}</span></div>
                        {% endfor %}
                    </div>
                    {% endif %}
                    
                    <a href="/achievements/" class="btn-hud">View Flight Logs ↗</a>
                </aside>

                <!-- Column 2: Engineering Whitepaper -->
                <article class="narrative-flow">
                    
                    {% if mode == 'Automation' and p %}
                        
                        <!-- GENERALIZED BLOCK BUILDER ENGINE -->
                        {% for section in p.sections %}
                        <div class="narrative-phase">
                            
                            <!-- Architectural Header -->
                            <div class="phase-header">
                                {% if section.overline %}<span class="phase-overline">{{ section.overline }}</span>{% endif %}
                                <h3 class="phase-heading">{{ section.heading }}</h3>
                            </div>
                            
                            <!-- Infinite Paragraph Loop -->
                            {% if section.paragraphs %}
                                {% for para in section.paragraphs %}
                                    <p class="phase-text">{{ para }}</p>
                                {% endfor %}
                            {% endif %}
                            
                            <!-- Dynamic Visual Injection Engine -->
                            {% if section.visual_type == 'matrix' and section.visual_data %}
                                <div class="subsystem-matrix">
                                    {% for row in section.visual_data %}
                                    <div class="matrix-row">
                                        <div class="matrix-left">{{ row.label }}</div>
                                        <div class="matrix-right">{{ row.val }}</div>
                                    </div>
                                    {% endfor %}
                                </div>
                                
                            {% elif section.visual_type == 'dashboard' and section.visual_data %}
                                <div class="flight-dashboard">
                                    {% for stat in section.visual_data %}
                                    <div class="dash-card">
                                        <div class="dash-val">{{ stat.val }}</div>
                                        <div class="dash-label">{{ stat.label }}</div>
                                    </div>
                                    {% endfor %}
                                </div>
                                
                            {% elif section.visual_type == 'bars' and section.visual_data %}
                                <div class="telemetry-bars">
                                    {% for bar in section.visual_data %}
                                    <div class="bar-row">
                                        <div class="bar-meta"><span>{{ bar.label }}</span><span class="val">{{ bar.val }} / {{ bar.max }}</span></div>
                                        <div class="bar-track"><div class="bar-fill" style="width: {{ (bar.val / bar.max) * 100 }}%"></div></div>
                                    </div>
                                    {% endfor %}
                                </div>
                            {% endif %}
                            
                        </div>
                        {% endfor %}
                        
                    {% else %}
                        <!-- LEGACY MANUAL BLOCK BUILDER (Preserved so old pages don't break) -->
                        <div style="font-size: 18px; color: var(--text-muted); line-height: 1.8;">
                            {% set blockArray = manual.blocks | default(blocks) %}
                            {% for block in blockArray %}
                                {% if block.type == 'text_block' %}
                                    {% if block.heading %}
                                        <h3 style="color: var(--text-light); font-size: 24px; font-weight: 800; margin: 48px 0 24px;">{{ block.heading }}</h3>
                                    {% endif %}
                                    <div style="margin-bottom: 24px;">
                                        {{ block.content | safe }}
                                    </div>
                                {% elif block.type == 'image_block' %}
                                    <img src="{{ block.image }}" style="width: 100%; height: auto; border: 1px solid var(--border-dark); border-radius: 4px; margin: 32px 0;" alt="{{ block.alt }}">
                                {% endif %}
                            {% endfor %}
                        </div>
                    {% endif %}

                </article>
            </div>
        </section>

        <!-- Up Next / Recommendation Loop -->
        
        <!-- Up Next / Recommendation Loop -->
        {% set nextItem = collections.models | getNextCollectionItem(page) %}
        {% if not nextItem %}
            {% set nextItem = collections.models[0] %}
        {% endif %}
        {% if nextItem %}
        <a href="{{ nextItem.url }}" class="next-report">
            <span class="next-label">Read More About</span>
            <h2 class="next-title">{{ nextItem.data.title }} ➔</h2>
        </a>
        {% endif %}

    </main>
