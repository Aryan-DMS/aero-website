<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title | default("AeroClub | Home") }}</title>
    
    <!-- Browser Tab Logo (Favicon) -->
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png">
    <link rel="apple-touch-icon" href="/favicon.png">
    
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --bg-deep: #0B1121;
            --bg-panel-dark: #151E32;
            --bg-light: #F8FAFC;
            --bg-white: #FFFFFF;
            
            --accent-cyan: #0EA5E9;
            
            --text-light: #F8FAFC;
            --text-muted: #94A3B8;
            --text-dark: #0F172A;
            
            --border-dark: rgba(255, 255, 255, 0.1);
            
            --font-ui: 'Inter', sans-serif;
            --font-data: 'Inter', sans-serif;

            /* ==========================================
               FLUID MATHEMATICAL CORE
               These variables scale dynamically across all screen sizes
            ========================================== */
            --space-container: clamp(16px, 4vw, 40px);
            --space-gap: clamp(24px, 3vw, 40px);
            
            /* Typography Scaling Matrix */
            --text-h1: clamp(40px, 6vw, 64px);
            --text-h2: clamp(28px, 4.5vw, 48px);
            --text-h3: clamp(24px, 3vw, 36px);
            --text-p: clamp(16px, 2vw, 18px);
        }

        * { margin: 0; padding: 0; box-sizing: border-box; scroll-behavior: smooth; }
        
        /* App-Feel Reset: Kills blue tap highlights and default focus rings on mobile */
        *, *::before, *::after { -webkit-tap-highlight-color: transparent; }
        *:focus:not(:focus-visible) { outline: none; }
        *:focus-visible { outline: 2px solid var(--accent-cyan); outline-offset: 2px; }

        body { font-family: var(--font-ui); background: var(--bg-deep); color: var(--text-light); -webkit-font-smoothing: antialiased; display: flex; flex-direction: column; min-height: 100vh; overflow-x: hidden; }
        a { text-decoration: none; color: inherit; }
        ul { list-style: none; }
        
        /* App-Feel Reset: Disables text selection on UI elements */
        button, .btn-join, .btn-outline, .nav-links a, .menu-toggle { user-select: none; -webkit-user-select: none; }
        
        /* Global Fluid Constraints */
        .container { max-width: 1200px; margin: 0 auto; padding-left: var(--space-container) !important; padding-right: var(--space-container) !important; width: 100%; box-sizing: border-box; }
        main { flex: 1; }
        
        /* Universal Fluid Typography (Overrides inline hardcoded pixel values) */
        h1 { font-size: var(--text-h1) !important; letter-spacing: -1px; line-height: 1.1; }
        h2 { font-size: var(--text-h2) !important; letter-spacing: -0.5px; line-height: 1.2; }
        h3 { font-size: var(--text-h3) !important; letter-spacing: -0.5px; line-height: 1.3; }
        p { font-size: var(--text-p); line-height: 1.6; }

        /* ==========================================
           CLEAN, FLAT, HIGH-CONTRAST NAVIGATION
        ========================================== */
        header {
            background: var(--bg-deep);
            border-bottom: 1px solid var(--border-dark);
            height: 80px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 40px;
            position: sticky;
            top: 0;
            z-index: 1000;
        }
        
        .nav-logo { font-weight: 800; font-size: 32px; letter-spacing: -0.5px; }
        .nav-logo span { color: var(--accent-cyan); }
        
        .nav-links { display: flex; gap: 4px; align-items: center; }
        
        .nav-links a { 
            color: var(--text-light); 
            font-size: 16px; 
            font-weight: 600; 
            padding: 10px 18px; 
            border-radius: 4px;
            transition: all 0.2s ease;
        }
        
        /* Active State (Always applies) */
        .nav-links a.active { background-color: var(--bg-white); color: var(--bg-deep); }
        
        /* App-Feel Reset: Only allow hovers on devices with a mouse */
        @media (hover: hover) {
            .nav-links a:hover { background-color: var(--bg-white); color: var(--bg-deep); }
        }

        /* Hamburger Menu Toggle Button (Hidden on Desktop) */
        .menu-toggle {
            display: none;
            flex-direction: column;
            justify-content: space-between;
            width: 28px;
            height: 20px;
            background: transparent;
            border: none;
            cursor: pointer;
            z-index: 1001;
        }
        .menu-toggle span {
            width: 100%;
            height: 2px;
            background-color: var(--text-light);
            transition: all 0.3s ease;
        }

        /* High-Contrast, Dual-Color Buttons */
        .btn-join { display: inline-block; background: var(--accent-cyan); color: var(--text-light); padding: 12px 28px; border-radius: 4px; font-size: 15px; font-weight: 800; border: 1px solid var(--accent-cyan); transition: all 0.2s ease; text-align: center; text-decoration: none; }
        
        .btn-outline { display: inline-block; padding: 12px 28px; border: 1px solid var(--border-dark); background: transparent; color: var(--text-light); border-radius: 4px; font-size: 15px; font-weight: 800; transition: all 0.2s ease; text-align: center; text-decoration: none; }
        
        /* App-Feel Reset: Only allow hovers on devices with a mouse */
        @media (hover: hover) {
            .btn-join:hover { background: var(--text-light); color: var(--bg-deep); border-color: var(--text-light); }
            .btn-outline:hover { background: var(--text-light); color: var(--bg-deep); border-color: var(--text-light); }
        }
        
        /* Provide tactile tap feedback on mobile */
        .btn-join:active, .btn-outline:active { transform: scale(0.98); }

        /* ==========================================
           GLOBAL FOOTER
        ========================================== */
        footer { background: var(--bg-deep); border-top: 1px solid var(--border-dark); margin-top: auto; }
        .map-container { width: 100%; height: 350px; background: #111; border-bottom: 1px solid var(--border-dark); }
        .map-container iframe { width: 100%; height: 100%; border: 0; filter: invert(90%) hue-rotate(180deg) contrast(1.1); }
        
        .footer-content { padding: 80px 0 40px; display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 40px; border-bottom: 1px solid var(--border-dark); margin-bottom: 24px; }
        .footer-brand .logo { font-size: 24px; font-weight: 800; margin-bottom: 16px; display: block; }
        .footer-brand .logo span { color: var(--accent-cyan); }
        .footer-brand p { color: var(--text-muted); font-size: 14px; line-height: 1.6; margin-bottom: 24px; max-width: 300px; }
        .contact-info li { display: flex; align-items: center; gap: 12px; color: var(--text-muted); font-size: 14px; margin-bottom: 12px; }
        
        .footer-links h4 { font-family: var(--font-data); font-size: 13px; font-weight: 700; letter-spacing: 1px; margin-bottom: 24px; color: var(--text-light); text-transform: uppercase; }
        .footer-links ul { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 12px; }
        .footer-links a { color: var(--text-muted); text-decoration: none; font-size: 15px; transition: color 0.2s ease; }
        .footer-links a:hover { color: var(--accent-cyan); }
        
        .footer-contact-link { color: var(--text-light); text-decoration: none; transition: color 0.2s ease; }
        .footer-contact-link:hover { color: var(--accent-cyan); }

        .footer-bottom { padding-bottom: 40px; display: flex; justify-content: space-between; align-items: center; color: var(--text-muted); font-size: 14px; }

        /* ==========================================
           STRUCTURAL MOBILE OVERRIDES
        ========================================== */
        @media (max-width: 960px) {
            body.no-scroll { overflow: hidden !important; touch-action: none; }

            /* Header & Drawer */
            header { padding: 0 var(--space-container); height: 70px; display: flex; align-items: center; position: relative; }
            .nav-logo { flex: 1; }
            .menu-toggle { display: flex; position: absolute; right: var(--space-container); top: 50%; transform: translateY(-50%); }
            header > .btn-join { display: none !important; } 
            
            .nav-links {
                position: fixed; top: 70px; left: 0; width: 100%; height: calc(100vh - 70px);
                background-color: var(--bg-deep); flex-direction: column; align-items: center;
                justify-content: flex-start; padding-top: 40px; gap: 16px;
                border-bottom: 1px solid var(--border-dark); transform: translateY(-100%);
                opacity: 0; visibility: hidden; transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); z-index: 999;
            }
            .nav-links.active { transform: translateY(0); opacity: 1; visibility: visible; }
            .nav-links li { width: 100%; display: flex; justify-content: center; }
            .nav-links a { font-size: 18px; width: 100%; text-align: center; padding: 12px; display: block; }
            .mobile-sponsor-item { display: flex !important; justify-content: center; width: 100%; }
            .mobile-sponsor-item a { width: fit-content; margin: 0 auto; }

            /* Structural Layout Stacks */
            div[style*="display: flex; gap: 16px; margin-top: 40px;"] { flex-direction: column !important; align-items: flex-start !important; width: 100% !important; margin-top: 0 !important; gap: 16px !important; }
            .btn-join, .btn-outline { width: fit-content !important; display: inline-flex !important; }
            .mission-split { grid-template-columns: 1fr !important; gap: var(--space-gap) !important; }
            .mission-typo { align-items: flex-start !important; }
            
            /* Fleet Carousel Stack */
            .fleet-slide { flex-direction: column-reverse !important; padding: var(--space-gap) var(--space-container) !important; text-align: left !important; align-items: flex-start !important; }
            .fleet-image img { max-height: clamp(180px, 40vw, 250px) !important; }
            
            /* Footer Stacking */
            footer > .container:nth-of-type(1) { grid-template-columns: 1fr !important; gap: 40px !important; }
            footer > .container:nth-of-type(2) { flex-direction: column !important; gap: 24px !important; align-items: flex-start !important; }
            .footer-contact-link, footer span { word-break: break-word; }
        }
    </style>
</head>
<body>

    <header>
        <a href="/" class="nav-logo">Aerial<span>Martial</span></a>
        
        <!-- Hamburger Menu Button -->
        <button class="menu-toggle" id="menuToggle" aria-label="Toggle Navigation">
            <span></span>
            <span></span>
            <span></span>
        </button>

        <nav>
            <ul class="nav-links" id="navLinks">
                <li><a href="/about/" {% if '/about/' in page.url %}class="active"{% endif %}>About</a></li>
                <li><a href="/achievements/" {% if '/achievements/' in page.url %}class="active"{% endif %}>Achievements</a></li>
                <li><a href="/gallery/" {% if '/gallery/' in page.url %}class="active"{% endif %}>Gallery</a></li>
                <li><a href="/models/" {% if '/models/' in page.url %}class="active"{% endif %}>Models</a></li>
                <li><a href="/events/" {% if '/events/' in page.url %}class="active"{% endif %}>Events</a></li>
                <li><a href="/team/" {% if '/team/' in page.url %}class="active"{% endif %}>Team</a></li>
                <li><a href="/contact/" {% if '/contact/' in page.url %}class="active"{% endif %}>Contact</a></li>
                <li><a href="/join_us/" {% if '/join_us/' in page.url %}class="active"{% endif %}>Recruitment</a></li>
                <!-- Mobile Only Sponsor Button inside drawer -->
                <li class="mobile-sponsor-item" style="width: 80%; text-align: center; margin-top: 12px; display: none;"><a href="/sponsor_us/" class="btn-join" style="display: block; width: 100%;">Sponsor Us</a></li>
            </ul>
        </nav>
        <a href="/sponsor_us/" class="btn-join">Sponsor Us</a>
    </header>

    <!-- THIS IS WHERE ELEVENTY INJECTS YOUR PAGE CONTENT -->
    {{ content | safe }}

    <footer style="background: var(--bg-deep); border-top: 1px solid var(--border-dark); padding: 80px 0 40px; margin-top: auto;">
        <div class="container" style="display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 40px; margin-bottom: 60px;">
            
            <div>
                <div class="logo" style="font-size: 24px; font-weight: 800; margin-bottom: 16px;">Aerial<span style="color: var(--accent-cyan);">Martial</span></div>
                <p style="color: var(--text-muted); font-size: 15px; margin-bottom: 24px; max-width: 280px; line-height: 1.6;">A student-led Aeromodelling club competing at national levels. INNOVATE. BUILD. FLY.</p>
                <div style="display: flex; flex-direction: column; gap: 12px;">
                    <span style="font-size: 14px; color: var(--text-light); display: flex; align-items: center;">
                        <strong style="font-family: var(--font-data); font-size: 11px; color: var(--text-muted); letter-spacing: 1px; width: 60px;">EMAIL</strong> 
                        <a href="mailto:aerialmartial@gmail.com" class="footer-contact-link">aerialmartial@gmail.com</a>
                    </span>
                    <span style="font-size: 14px; color: var(--text-light); display: flex; align-items: center;">
                        <strong style="font-family: var(--font-data); font-size: 11px; color: var(--text-muted); letter-spacing: 1px; width: 60px;">CAMPUS</strong> 
                        <a href="https://moderncoe.edu.in/" target="_blank" rel="noopener noreferrer" class="footer-contact-link"> PES MCOE, Pune</a>
                    </span>
                    <span style="font-size: 14px; color: var(--text-light); display: flex; align-items: center;">
                        <strong style="font-family: var(--font-data); font-size: 11px; color: var(--text-muted); letter-spacing: 1px; width: 60px;">PHONE</strong> 
                        <a href="tel:+919876543210" class="footer-contact-link">+91 98765 43210</a>
                    </span>
                </div>
            </div>
            
            <!-- Navigation -->
            <div class="footer-links" style="padding-top: 10px;">
                <h4>Club</h4>
                <ul>
                    <li><a href="/about/">About Us</a></li>
                    <li><a href="/team/">Our Team</a></li>
                    <li><a href="/gallery/">Gallery</a></li>
                </ul>
            </div>
            
            <!-- Operations -->
            <div class="footer-links" style="padding-top: 10px;">
                <h4>Compete</h4>
                <ul>
                    <li><a href="/achievements/">Achievements</a></li>
                    <li><a href="/models/">The Fleet</a></li>
                    <li><a href="/events/">Upcoming Events</a></li>
                </ul>
            </div>
            
            <!-- Connect -->
            <div class="footer-links" style="padding-top: 10px;">
                <h4>Connect</h4>
                <ul>
                    <li><a href="/contact/">Contact Us</a></li>
                    <li><a href="/join_us/">Join The Team</a></li>
                    <li><a href="/sponsor_us/">Partner With Us</a></li>
                    <li><a href="/sponsors/">Sponsors</a></li>
                </ul>
            </div>

        </div>
        
        <div class="container" style="border-top: 1px solid var(--border-dark); padding-top: 24px; display: flex; justify-content: space-between; align-items: center;">
            <p style="color: var(--text-muted); font-size: 13px;">&copy; 2026 Aerial Martial. All rights reserved.</p>
            <div style="display: flex; gap: 24px;">
                <a href="https://www.instagram.com/teamaerialmartial/" target="_blank" rel="noopener noreferrer" style="color: var(--text-muted); text-decoration: none; font-size: 13px; transition: color 0.2s;" onmouseover="this.style.color='var(--accent-cyan)'" onmouseout="this.style.color='var(--text-muted)'">Instagram</a>
                <a href="https://www.linkedin.com/company/team-aerial-martialmcoe" target="_blank" rel="noopener noreferrer" style="color: var(--text-muted); text-decoration: none; font-size: 13px; transition: color 0.2s;" onmouseover="this.style.color='var(--accent-cyan)'" onmouseout="this.style.color='var(--text-muted)'">LinkedIn</a>
                <a href="https://www.youtube.com/channel/UCBD1x9EdxqMjrMDhqJWB4yg" target="_blank" rel="noopener noreferrer" style="color: var(--text-muted); text-decoration: none; font-size: 13px; transition: color 0.2s;" onmouseover="this.style.color='var(--accent-cyan)'" onmouseout="this.style.color='var(--text-muted)'">YouTube</a>
            </div>
        </div>
    </footer>

    <script>
        const toggle = document.getElementById('menuToggle');
        const nav = document.getElementById('navLinks');
        toggle.addEventListener('click', () => {
            nav.classList.toggle('active');
            document.body.classList.toggle('no-scroll'); // Freezes background scrolling
        });
    </script>
</body>
</html>
