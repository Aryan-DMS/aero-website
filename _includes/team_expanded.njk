---
layout: base.njk
---
<main id="personnel-expanded">
        
        <style>
            /* The 30/70 Macro Grid */
            .report-grid { display: grid; grid-template-columns: 320px 1fr; gap: clamp(40px, 6vw, 64px); align-items: start; }
            
            /* Sticky Identity Anchor (ID Badge) */
            .hud-anchor { position: sticky; top: 40px; background: var(--bg-panel-dark); border: 1px solid var(--border-dark); padding: clamp(20px, 3vw, 24px); border-radius: 8px; }
            .hud-image { width: 100%; aspect-ratio: 1/1; object-fit: cover; border-radius: 4px; border: 1px solid var(--border-dark); margin-bottom: 24px; filter: contrast(1.1); }
            .hud-anchor:hover .hud-image { filter: grayscale(0%) contrast(1.1); }
            
            .hud-grid { display: flex; flex-direction: column; gap: 20px; margin-bottom: 32px; }
            .hud-item span { display: block; }
            .hud-item-label { font-family: var(--font-ui), sans-serif; font-size: 11px; font-weight: 700; color: var(--text-muted); letter-spacing: 1px; text-transform: uppercase; margin-bottom: 4px; }
            .hud-item-value { font-size: 15px; color: var(--text-light); font-weight: 600; }

            /* Narrative Modules & Premium Typography */
            .narrative-flow { display: flex; flex-direction: column; gap: clamp(40px, 6vw, 60px); padding-top: 12px; }
            .narrative-phase { display: flex; flex-direction: column; }
            
            /* Architectural Headings */
            .phase-header { margin-bottom: 24px; }
            .phase-overline { font-family: var(--font-data); font-size: 12px; color: var(--accent-cyan); letter-spacing: 2px; text-transform: uppercase; margin-bottom: 12px; display: block; }
            .phase-heading { font-size: 32px; font-weight: 800; color: var(--text-light); margin: 0; letter-spacing: -0.5px; }
            
            /* Standardized Body Text */
            .phase-text { font-size: 18px; color: var(--text-muted); line-height: 1.8; margin-bottom: 24px; }
            .phase-text:last-child { margin-bottom: 0; }
            .phase-hook { font-size: 20px; color: var(--text-muted); line-height: 1.8; font-weight: 500; margin: 0; }

            /* Visual 1: Competency Matrix (Tech Spec Sheet) */
            .subsystem-matrix { display: flex; flex-direction: column; border-top: 1px solid var(--border-dark); border-bottom: 1px solid var(--border-dark); margin-top: 24px; }
            .matrix-row { display: grid; grid-template-columns: 200px 1fr; border-bottom: 1px solid var(--border-dark); transition: background 0.2s; }
            .matrix-row:last-child { border-bottom: none; }
            .matrix-row:hover { background: rgba(255, 255, 255, 0.02); }
            .matrix-left { padding: 24px 24px 24px 0; font-family: var(--font-ui), sans-serif; font-size: 12px; font-weight: 700; color: var(--text-light); text-transform: uppercase; letter-spacing: 1px; border-right: 1px solid var(--border-dark); }
            .matrix-right { padding: 24px; color: var(--text-muted); font-size: 16px; line-height: 1.6; }

            /* Visual 2: Contributions Row */
            .contribution-row { display: grid; grid-template-columns: 200px 1fr; gap: 24px; align-items: start; }

            /* High-End Corporate Actions Compartment */
            .action-btn { display: flex; justify-content: center; align-items: center; width: 100%; gap: 10px; padding: 14px; box-sizing: border-box; border-radius: 4px; font-size: 15px; font-weight: 700; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; text-decoration: none; transition: all 0.2s ease; cursor: pointer; border: 1px solid transparent; }
            
            .action-btn-primary { background: var(--accent-cyan); color: var(--bg-deep); }
            .action-btn-primary:hover { background: var(--text-light); color: var(--bg-deep); border-color: var(--text-light); }
            
            .action-btn-outline { background: transparent; border-color: var(--border-dark); color: var(--text-light); }
            .action-btn-outline:hover { background: var(--text-light); color: var(--bg-deep); border-color: var(--text-light); }
            
            /* Strictly caps the SVGs so they never blow up */
            .action-btn svg { width: 18px !important; height: 18px !important; flex-shrink: 0; }

            /* ==========================================
               MOBILE RESPONSIVE OVERRIDES
            ========================================== */
            @media (max-width: 1024px) { 
                .report-grid { grid-template-columns: 1fr; }
                /* Disable sticky behavior so it scrolls naturally above the content on mobile */
                .hud-anchor { position: relative; top: 0; margin-bottom: 16px; }
            }
            @media (max-width: 768px) {
                /* Stack data grids vertically on narrow screens */
                .matrix-row { grid-template-columns: 1fr; gap: 8px; padding: 24px 0; }
                .matrix-left { padding: 0; border-right: none; }
                .matrix-right { padding: 0; }
                .contribution-row { grid-template-columns: 1fr; gap: 8px; }
            }
        </style>

        {# --- MASTER ROUTING ENGINE FOR ROSTER --- #}
        {% set legacyMode = report_mode | default('Automation') %}
        {% set mode = card.report_mode | default(legacyMode) %}
        
        {# Extract base fallback variables so legacy files don't crash #}
        {% set baseName = card.name | default(name) %}
        {% set baseRole = card.role | default(role) %}
        {% set baseDiv = card.division | default(division) %}
        {% set baseImage = card.image | default(image) %}
        
        {% if mode == 'Automation' %}
            {# Attempt to pull from new Automation Box, fallback to old Report box #}
            {% set rawPayload = automation.payload.code if automation.payload.code else automation.payload %}
            {% if not rawPayload %}{% set rawPayload = automation_payload.code if automation_payload.code else automation_payload %}{% endif %}
            {% set p = rawPayload | parseJSON %}
            
            {% set secMetrics = p.metrics %}
            {% set bioLink = p.linkedin | default(linkedin) %}
            {% set bioQuote = p.quote | default(quote) %}
            
        {% else %}
            {# Attempt to pull from new Manual Box, fallback to legacy variables #}
            {% set secMetrics = manual.metrics %}
            {% set bioLink = manual.linkedin | default(linkedin) %}
            {% set bioQuote = manual.quote | default(quote) %}
            
            {# Legacy Manual Fallbacks so old pages don't break #}
            {% if not secMetrics %}
                {% set bioMajor = manual.major | default(major) %}
                {% set bioJoined = manual.joined | default(joined) %}
            {% endif %}
        {% endif %}

        <section style="padding: clamp(40px, 8vw, 100px) 0;">
            <div class="container">
                <a href="/team/" style="font-family: var(--font-data); color: var(--text-muted); text-transform: uppercase; font-size: 11px; display: inline-flex; align-items: center; gap: 8px; margin-bottom: 40px; letter-spacing: 1px; transition: color 0.2s;">← Back to Roster</a>
                
                <div class="report-grid">
                    
                    <!-- Column 1: Sticky Identity Anchor -->
                    <aside class="hud-anchor">
                        <img src="{{ baseImage }}" alt="{{ baseName }}" class="hud-image">
                        <div class="hud-grid">
                            <div class="hud-item"><span class="hud-item-label">DIVISION</span><span class="hud-item-value">{{ baseDiv }}</span></div>
                            
                            {% if secMetrics %}
                                {% for metric in secMetrics %}
                                <div class="hud-item"><span class="hud-item-label">{{ metric.label }}</span><span class="hud-item-value">{{ metric.value }}</span></div>
                                {% endfor %}
                            {% else %}
                                {# Legacy Fallback #}
                                {% if bioMajor %}<div class="hud-item"><span class="hud-item-label">ACADEMIC MAJOR</span><span class="hud-item-value">{{ bioMajor }}</span></div>{% endif %}
                                {% if bioJoined %}<div class="hud-item"><span class="hud-item-label">DATE JOINED</span><span class="hud-item-value">{{ bioJoined }}</span></div>{% endif %}
                            {% endif %}
                        </div>
                        
                        <!-- Official Actions Compartment -->
                        <div style="display: flex; flex-direction: column; gap: 12px; margin-top: 32px; border-top: 1px solid var(--border-dark); padding-top: 24px;">
                            {% if bioLink %}
                            <a href="{{ bioLink }}" target="_blank" class="action-btn action-btn-primary">
                                LinkedIn Profile
                                <svg viewBox="0 0 24 24" fill="currentColor" stroke="none"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
                            </a>
                            {% endif %}
                            <button id="share-btn" class="action-btn action-btn-outline" onclick="shareProfile()">
                                Copy Profile Link
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg>
                            </button>
                            <button id="cert-btn" class="action-btn action-btn-outline" onclick="printCertificate()">
                                Official Certificate
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                            </button>
                        </div>
                    </aside>
                    
                    <!-- Column 2: Specialist Dossier -->
                    <div>
                        <!-- Dossier Header -->
                        <div style="margin-bottom: clamp(40px, 6vw, 60px); border-bottom: 1px solid var(--border-dark); padding-bottom: clamp(24px, 4vw, 40px);">
                            <h1 style="font-size: clamp(40px, 8vw, 56px); font-weight: 900; color: var(--text-light); margin-bottom: 8px; letter-spacing: -1.5px; line-height: 1.1;">{{ baseName }}</h1>
                            <h4 style="font-family: var(--font-data); color: var(--accent-cyan); font-size: clamp(12px, 2vw, 14px); letter-spacing: 2px; text-transform: uppercase; margin: 0;">{{ baseRole }}</h4>
                        </div>
                        
                        <!-- Automated Narrative Engine -->
                        <article class="narrative-flow">
                            
                            {% if mode == 'Automation' and p %}
                                
                                <!-- HIGH-FLEXIBILITY AUTOMATION ENGINE -->
                                {% set narrative_phases = [p.phase1, p.phase2, p.phase3, p.phase4, p.phase5] %}
                                {% for section in narrative_phases %}
                                    {% if section %}
                                    <div class="narrative-phase">
                                        
                                        <!-- Architectural Header -->
                                        <div class="phase-header">
                                            {% if section.overline %}<span class="phase-overline">{{ section.overline }}</span>{% endif %}
                                            {% if section.heading %}<h3 class="phase-heading">{{ section.heading }}</h3>{% endif %}
                                        </div>
                                        
                                        <!-- The Hook (Executive Summary style) -->
                                        {% if section.hook %}
                                            <p class="phase-hook" style="margin-bottom: 24px;">{{ section.hook }}</p>
                                        {% endif %}
                                        
                                        <!-- Infinite Paragraph Loop -->
                                        {% if section.paragraphs %}
                                            {% for para in section.paragraphs %}
                                                <p class="phase-text">{{ para }}</p>
                                            {% endfor %}
                                        {% endif %}
                                        
                                        <!-- Dynamic Visual Injection: Matrix -->
                                        {% if section.matrix %}
                                            <div class="subsystem-matrix">
                                                {% for row in section.matrix %}
                                                <div class="matrix-row">
                                                    <div class="matrix-left">{{ row.skill }}</div>
                                                    <div class="matrix-right">{{ row.desc }}</div>
                                                </div>
                                                {% endfor %}
                                            </div>
                                        {% endif %}
                                            
                                        <!-- Dynamic Visual Injection: Contributions -->
                                        {% if section.contributions %}
                                            <div style="display: flex; flex-direction: column; gap: 32px; margin-top: 24px;">
                                                {% for item in section.contributions %}
                                                <div class="contribution-row">
                                                    <div style="color: var(--text-light); font-weight: 700; font-size: 13px; font-family: var(--font-ui); text-transform: uppercase; letter-spacing: 1px; display: flex; align-items: flex-start; gap: 12px; margin-top: 5px;">
                                                        <span style="display: block; width: 6px; height: 6px; background: var(--accent-cyan); flex-shrink: 0; margin-top: 6px;"></span>
                                                        <span style="line-height: 1.4;">{{ item.title }}</span>
                                                    </div>
                                                    <div style="color: var(--text-muted); font-size: 16px; line-height: 1.7;">
                                                        {{ item.desc }}
                                                    </div>
                                                </div>
                                                {% endfor %}
                                            </div>
                                        {% endif %}
                                        
                                    </div>
                                    {% endif %}
                                {% endfor %}
                                
                            {% else %}
                                <!-- LEGACY MANUAL BIO -->
                                <div class="phase-text">
                                    {% set bioContent = manual.body | default(body) | default(content) %}
                                    {{ bioContent | safe }}
                                </div>
                            {% endif %}
                            
                            <!-- MANUAL FALLBACK (Personal Quote) -->
                            {% if bioQuote %}
                            <div style="display: flex; flex-direction: column; gap: 60px; margin-top: 20px;">
                                <blockquote style="border-left: 3px solid var(--accent-cyan); padding-left: 32px; margin: 0; font-style: italic; font-size: 22px; color: var(--text-light); line-height: 1.6; font-weight: 500;">
                                    "{{ bioQuote }}"
                                </blockquote>
                            </div>
                            {% endif %}

                        </article>
                    </div>
                </div>
            </div>
        </section>

        <!-- Personnel Action Scripts -->
        <script>
            function shareProfile() {
                // Generates the absolute cleanest canonical URL without index.html or messy query parameters
                const cleanUrl = window.location.origin + window.location.pathname.replace(/\/index\.html$/, '/');
                
                navigator.clipboard.writeText(cleanUrl).then(() => {
                    const btn = document.getElementById('share-btn');
                    const originalHtml = btn.innerHTML;
                    
                    // UI Feedback State
                    btn.innerHTML = 'Link Copied! <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>';
                    btn.style.color = 'var(--bg-deep)';
                    btn.style.backgroundColor = 'var(--text-light)';
                    btn.style.borderColor = 'var(--text-light)';
                    
                    setTimeout(() => {
                        btn.innerHTML = originalHtml;
                        btn.style.color = '';
                        btn.style.backgroundColor = '';
                        btn.style.borderColor = '';
                    }, 2500);
                });
            }

            function printCertificate() {
                const btn = document.getElementById('cert-btn');
                const originalHtml = btn.innerHTML;
                
                // UI Feedback State (Coming Soon)
                btn.innerHTML = 'Module Coming Soon <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>';
                btn.style.color = 'var(--bg-deep)';
                btn.style.backgroundColor = 'var(--accent-cyan)';
                btn.style.borderColor = 'var(--accent-cyan)';
                
                setTimeout(() => {
                    btn.innerHTML = originalHtml;
                    btn.style.color = '';
                    btn.style.backgroundColor = '';
                    btn.style.borderColor = '';
                }, 2500);
            }
        </script>
    </main>
