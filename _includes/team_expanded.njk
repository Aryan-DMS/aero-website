---
layout: base.njk
---
<main id="personnel-expanded">
        
        <style>
            /* The 30/70 Macro Grid */
            .report-grid { display: grid; grid-template-columns: 320px 1fr; gap: 64px; align-items: start; }
            @media (max-width: 1024px) { .report-grid { grid-template-columns: 1fr; } }
            
            /* Sticky Identity Anchor (ID Badge) */
            .hud-anchor { position: sticky; top: 40px; background: var(--bg-panel-dark); border: 1px solid var(--border-dark); padding: 24px; border-radius: 8px; }
            .hud-image { width: 100%; aspect-ratio: 1/1; object-fit: cover; border-radius: 4px; border: 1px solid var(--border-dark); margin-bottom: 24px; filter: contrast(1.1); }
            .hud-anchor:hover .hud-image { filter: grayscale(0%) contrast(1.1); }
            
            .hud-grid { display: flex; flex-direction: column; gap: 20px; margin-bottom: 32px; }
            .hud-item span { display: block; }
            .hud-item-label { font-family: var(--font-ui), sans-serif; font-size: 11px; font-weight: 700; color: var(--text-muted); letter-spacing: 1px; text-transform: uppercase; margin-bottom: 4px; }
            .hud-item-value { font-size: 15px; color: var(--text-light); font-weight: 600; }
            
            .btn-hud { display: inline-block; width: 100%; text-align: center; padding: 14px; background: var(--text-light); color: var(--bg-deep); font-weight: 800; border-radius: 4px; text-decoration: none; transition: background 0.2s; font-family: var(--font-ui), sans-serif; text-transform: uppercase; font-size: 12px; letter-spacing: 1px; }
            .btn-hud:hover { background: var(--accent-cyan); }

            /* Narrative Modules & Premium Typography */
            .narrative-flow { display: flex; flex-direction: column; gap: 60px; padding-top: 12px; }
            .narrative-phase { display: flex; flex-direction: column; }
            
            /* Architectural Headings */
            .phase-header { margin-bottom: 24px; }
            .phase-overline { font-family: var(--font-data); font-size: 12px; color: var(--accent-cyan); letter-spacing: 2px; text-transform: uppercase; margin-bottom: 12px; display: block; }
            .phase-heading { font-size: 32px; font-weight: 800; color: var(--text-light); margin: 0; letter-spacing: -0.5px; }
            
            /* Standardized Body Text */
            .phase-text { font-size: 18px; color: var(--text-muted); line-height: 1.8; margin-bottom: 24px; }
            .phase-text:last-child { margin-bottom: 0; }
            .phase-hook { font-size: 20px; color: var(--text-muted); line-height: 1.8; font-weight: 500; margin: 0; }

            /* Visual 1: Competency Matrix (Tech Spec Sheet) */
            .subsystem-matrix { display: flex; flex-direction: column; border-top: 1px solid var(--border-dark); border-bottom: 1px solid var(--border-dark); margin-top: 24px; }
            .matrix-row { display: grid; grid-template-columns: 200px 1fr; border-bottom: 1px solid var(--border-dark); transition: background 0.2s; }
            .matrix-row:last-child { border-bottom: none; }
            .matrix-row:hover { background: rgba(255, 255, 255, 0.02); }
            .matrix-left { padding: 24px 24px 24px 0; font-family: var(--font-ui), sans-serif; font-size: 12px; font-weight: 700; color: var(--text-light); text-transform: uppercase; letter-spacing: 1px; border-right: 1px solid var(--border-dark); }
            .matrix-right { padding: 24px; color: var(--text-muted); font-size: 16px; line-height: 1.6; }
        </style>

        {# --- MASTER ROUTING ENGINE FOR ROSTER --- #}
        {% set legacyMode = report_mode | default('Automation') %}
        {% set mode = card.report_mode | default(legacyMode) %}
        
        {# Extract base fallback variables so legacy files don't crash #}
        {% set baseName = card.name | default(name) %}
        {% set baseRole = card.role | default(role) %}
        {% set baseDiv = card.division | default(division) %}
        {% set baseImage = card.image | default(image) %}
        
        {% if mode == 'Automation' %}
            {# Attempt to pull from new Automation Box, fallback to old Report box #}
            {% set rawPayload = automation.payload.code if automation.payload.code else automation.payload %}
            {% if not rawPayload %}{% set rawPayload = automation_payload.code if automation_payload.code else automation_payload %}{% endif %}
            {% set p = rawPayload | parseJSON %}
            
            {% set secMetrics = p.metrics %}
            {% set bioLink = p.linkedin | default(linkedin) %}
            {% set bioQuote = p.quote | default(quote) %}
            
        {% else %}
            {# Attempt to pull from new Manual Box, fallback to legacy variables #}
            {% set secMetrics = manual.metrics %}
            {% set bioLink = manual.linkedin | default(linkedin) %}
            {% set bioQuote = manual.quote | default(quote) %}
            
            {# Legacy Manual Fallbacks so old pages don't break #}
            {% if not secMetrics %}
                {% set bioMajor = manual.major | default(major) %}
                {% set bioJoined = manual.joined | default(joined) %}
            {% endif %}
        {% endif %}

        <section style="padding: 60px 0 100px;">
            <div class="container">
                <a href="/team/" style="font-family: var(--font-data); color: var(--text-muted); text-transform: uppercase; font-size: 11px; display: inline-flex; align-items: center; gap: 8px; margin-bottom: 40px; letter-spacing: 1px; transition: color 0.2s;">← Back to Roster</a>
                
                <div class="report-grid">
                    
                    <!-- Column 1: Sticky Identity Anchor -->
                    <aside class="hud-anchor">
                        <img src="{{ baseImage }}" alt="{{ baseName }}" class="hud-image">
                        <div class="hud-grid">
                            <div class="hud-item"><span class="hud-item-label">DIVISION</span><span class="hud-item-value">{{ baseDiv }}</span></div>
                            
                            {% if secMetrics %}
                                {% for metric in secMetrics %}
                                <div class="hud-item"><span class="hud-item-label">{{ metric.label }}</span><span class="hud-item-value">{{ metric.value }}</span></div>
                                {% endfor %}
                            {% else %}
                                {# Legacy Fallback #}
                                {% if bioMajor %}<div class="hud-item"><span class="hud-item-label">ACADEMIC MAJOR</span><span class="hud-item-value">{{ bioMajor }}</span></div>{% endif %}
                                {% if bioJoined %}<div class="hud-item"><span class="hud-item-label">DATE JOINED</span><span class="hud-item-value">{{ bioJoined }}</span></div>{% endif %}
                            {% endif %}
                        </div>
                        {% if bioLink %}
                        <a href="{{ bioLink }}" target="_blank" class="btn-hud">LinkedIn Profile ↗</a>
                        {% endif %}
                    </aside>
                    
                    <!-- Column 2: Specialist Dossier -->
                    <div>
                        <!-- Dossier Header -->
                        <div style="margin-bottom: 60px; border-bottom: 1px solid var(--border-dark); padding-bottom: 40px;">
                            <h1 style="font-size: 56px; font-weight: 900; color: var(--text-light); margin-bottom: 8px; letter-spacing: -1.5px;">{{ baseName }}</h1>
                            <h4 style="font-family: var(--font-data); color: var(--accent-cyan); font-size: 14px; letter-spacing: 2px; text-transform: uppercase; margin: 0;">{{ baseRole }}</h4>
                        </div>
                        
                        <!-- Automated Narrative Engine -->
                        <article class="narrative-flow">
                            
                            {% if mode == 'Automation' and p %}
                                
                                <!-- GENERALIZED BLOCK BUILDER ENGINE -->
                                {% for section in p.sections %}
                                <div class="narrative-phase">
                                    
                                    <!-- Architectural Header -->
                                    <div class="phase-header">
                                        {% if section.overline %}<span class="phase-overline">{{ section.overline }}</span>{% endif %}
                                        <h3 class="phase-heading">{{ section.heading }}</h3>
                                    </div>
                                    
                                    <!-- Infinite Paragraph Loop -->
                                    {% if section.paragraphs %}
                                        {% for para in section.paragraphs %}
                                            <p class="phase-text">{{ para }}</p>
                                        {% endfor %}
                                    {% endif %}
                                    
                                    <!-- Dynamic Visual Injection Engine -->
                                    {% if section.visual_type == 'matrix' and section.visual_data %}
                                        <div class="subsystem-matrix">
                                            {% for row in section.visual_data %}
                                            <div class="matrix-row">
                                                <div class="matrix-left">{{ row.label }}</div>
                                                <div class="matrix-right">{{ row.val }}</div>
                                            </div>
                                            {% endfor %}
                                        </div>
                                        
                                    {% elif section.visual_type == 'contributions' and section.visual_data %}
                                        <div style="display: flex; flex-direction: column; gap: 24px; margin-top: 24px;">
                                            {% for item in section.visual_data %}
                                            <div style="display: grid; grid-template-columns: 200px 1fr; gap: 24px; align-items: start;">
                                                <div style="color: var(--text-light); font-weight: 700; font-size: 13px; font-family: var(--font-ui); text-transform: uppercase; letter-spacing: 1px; display: flex; align-items: flex-start; gap: 12px; margin-top: 5px;">
                                                    <span style="display: block; width: 6px; height: 6px; background: var(--accent-cyan); flex-shrink: 0; margin-top: 6px;"></span>
                                                    <span style="line-height: 1.4;">{{ item.label }}</span>
                                                </div>
                                                <div style="color: var(--text-muted); font-size: 16px; line-height: 1.7;">
                                                    {{ item.val }}
                                                </div>
                                            </div>
                                            {% endfor %}
                                        </div>
                                    {% endif %}
                                    
                                </div>
                                {% endfor %}
                                
                            {% else %}
                                <!-- LEGACY MANUAL BIO -->
                                <div class="phase-text">
                                    {% set bioContent = manual.body | default(body) | default(content) %}
                                    {{ bioContent | safe }}
                                </div>
                            {% endif %}
                            
                            <!-- MANUAL FALLBACK (Personal Quote) -->
                            {% if bioQuote %}
                            <div style="display: flex; flex-direction: column; gap: 60px; margin-top: 20px;">
                                <blockquote style="border-left: 3px solid var(--accent-cyan); padding-left: 32px; margin: 0; font-style: italic; font-size: 22px; color: var(--text-light); line-height: 1.6; font-weight: 500;">
                                    "{{ bioQuote }}"
                                </blockquote>
                            </div>
                            {% endif %}

                        </article>
                    </div>
                </div>
            </div>
        </section>
    </main>
