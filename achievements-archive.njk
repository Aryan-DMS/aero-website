---
layout: base.njk
title: "AeroClub | All Missions"
permalink: /achievements/archive/index.html
---
<style>
    .achievement-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr)); gap: var(--space-gap); }
    .achievement-card { background: var(--bg-deep); border: 1px solid var(--border-dark); display: flex; flex-direction: column; transition: border-color 0.2s ease; overflow: hidden; text-decoration: none; }
    .achievement-card:hover { border-color: var(--text-light); }
    
    .achievement-img { aspect-ratio: 16 / 9; overflow: hidden; border-bottom: 1px solid var(--border-dark); }
    .achievement-img img { width: 100%; height: 100%; object-fit: cover; filter: contrast(1.1); transition: transform 0.4s ease; display: block; }
    .achievement-card:hover .achievement-img img { transform: scale(1.02); }
    
    .achievement-content { padding: 32px; flex: 1; display: flex; flex-direction: column; }
    .achievement-meta { font-family: var(--font-data); font-size: 13px; color: var(--accent-cyan); margin-bottom: 16px; display: block; letter-spacing: 1px; text-transform: uppercase; }
    .achievement-card h4 { font-size: 22px; font-weight: 800; margin-bottom: 12px; color: var(--text-light); line-height: 1.3; }
    .achievement-card p { font-size: 16px; color: var(--text-muted); line-height: 1.6; margin-bottom: 32px; flex: 1; }
    .read-report { font-size: 13px; font-weight: 700; color: var(--text-light); text-transform: uppercase; letter-spacing: 1px; display: flex; align-items: center; gap: 8px; }
    .read-report::after { content: '→'; transition: transform 0.2s; }
    .achievement-card:hover .read-report::after { transform: translateX(6px); }
</style>

<main>
    <section style="padding: 80px 0 40px; border-bottom: 1px solid var(--border-dark);">
        <div class="container">
            <a href="/achievements/" style="font-family: var(--font-data); color: var(--text-muted); font-size: 13px; letter-spacing: 1px; text-transform: uppercase; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; margin-bottom: 24px; transition: color 0.2s;">← Back to Highlights</a>
            <h4 style="font-family: var(--font-data); color: var(--accent-cyan); font-size: 14px; margin-bottom: 12px; letter-spacing: 1px; text-transform: uppercase;">TRACK RECORD</h4>
            <h2 style="font-size: 48px; font-weight: 800; margin-bottom: 16px; color: var(--text-light); letter-spacing: -1px;">Mission Archive</h2>
            <p style="color: var(--text-muted); font-size: 20px; line-height: 1.6; max-width: 700px;">The complete, unrestricted database of all historical deployments and engineering projects.</p>
        </div>
    </section>

    <section style="padding: 80px 0 120px;">
        <div class="container">
            <div class="achievement-grid">
                <!-- NO LIMITS: Infinite Loop -->
                {% for mission in collections.achievements | reverse %}
                <a href="{{ mission.url }}" class="achievement-card">
                    <div class="achievement-img">
                        <img src="{{ mission.data.card.image }}" alt="{{ mission.data.card.title }}">
                    </div>
                    <div class="achievement-content">
                        <span class="achievement-meta">{{ mission.data.card.meta }}</span>
                        <h4>{{ mission.data.card.title }}</h4>
                        <p>{{ mission.data.card.summary }}</p>
                        <span class="read-report">Read Mission Report</span>
                    </div>
                </a>
                {% endfor %}
            </div>
        </div>
    </section>
</main>
