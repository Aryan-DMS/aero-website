---
layout: base.njk
title: "AeroClub | Models"
---
<style>

        /* High-Contrast, Dual-Color Buttons */
        .btn-join { display: inline-block; background: var(--accent-cyan); color: var(--bg-deep); padding: 12px 28px; border-radius: 4px; font-size: 15px; font-weight: 800; border: 1px solid var(--accent-cyan); transition: all 0.2s ease; cursor: pointer; text-align: center; }
        .btn-join:hover { background: var(--text-light); color: var(--bg-deep); border-color: var(--text-light); }

        .btn-outline { display: inline-block; padding: 12px 28px; border: 1px solid var(--border-dark); background: transparent; color: var(--text-light); border-radius: 4px; font-size: 15px; font-weight: 800; transition: all 0.2s ease; }
        .btn-outline:hover { background: var(--text-light); color: var(--bg-deep); border-color: var(--text-light); }

        /* Hardware Fleet Cards */
        .model-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; }
        .model-card { background: var(--bg-deep); border: 1px solid var(--border-dark); display: flex; flex-direction: column; transition: border-color 0.2s ease; overflow: hidden; text-decoration: none; }
        .model-card:hover { border-color: var(--text-light); }
        
        .model-img { height: 280px; overflow: hidden; border-bottom: 1px solid var(--border-dark); background: var(--bg-panel-dark); padding: 16px; display: flex; justify-content: center; align-items: center; }
        .model-img img { width: 100%; height: 100%; object-fit: contain; filter: contrast(1.1) drop-shadow(0 20px 30px rgba(0,0,0,0.5)); transition: transform 0.5s cubic-bezier(0.25, 1, 0.5, 1); }
        .model-card:hover .model-img img { transform: scale(1.03); }
        
        .model-content { padding: 32px; display: flex; flex-direction: column; flex: 1; }
        .model-meta { font-family: var(--font-data); font-size: 13px; color: var(--accent-cyan); margin-bottom: 12px; display: block; letter-spacing: 1px; text-transform: uppercase; }
        .model-card h4 { font-size: 24px; font-weight: 800; margin-bottom: 24px; color: var(--text-light); }
        
        /* Tech Specs Grid within Card */
        .tech-specs { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 32px; border-top: 1px solid var(--border-dark); padding-top: 24px; }
        .spec-item { display: flex; flex-direction: column; gap: 4px; }
        .spec-label { font-family: var(--font-data); font-size: 11px; color: var(--text-muted); text-transform: uppercase; }
        .spec-value { font-size: 14px; font-weight: 700; color: var(--text-light); }
        
        .view-specs { font-size: 13px; font-weight: 700; color: var(--text-light); text-transform: uppercase; letter-spacing: 1px; display: flex; align-items: center; gap: 8px; margin-top: auto; }
        .view-specs::after { content: '→'; transition: transform 0.2s; }
        .model-card:hover .view-specs::after { transform: translateX(6px); }

        /* ==========================================
           PAGE CONTENT (HOME PAGE)
        ========================================== */
        .hero {
            height: calc(100vh - 80px);
            background: linear-gradient(to right, rgba(11,17,33,0.95), rgba(11,17,33,0.2)), url('https://images.unsplash.com/photo-1541187764121-717013809cb8?auto=format&fit=crop&q=80&w=2000') center/cover;
            display: flex;
            align-items: center;
        }
        .hero-text h1 { font-size: 64px; font-weight: 800; line-height: 1.1; margin-bottom: 20px; max-width: 800px; letter-spacing: -1px; }
        .hero-text p { font-size: 20px; color: var(--text-muted); max-width: 600px; margin-bottom: 40px; font-family: var(--font-data); }

        /* ==========================================
           GLOBAL FOOTER
        ========================================== */
        footer { background: var(--bg-deep); border-top: 1px solid var(--border-dark); margin-top: auto; }
        .map-container { width: 100%; height: 350px; background: #111; border-bottom: 1px solid var(--border-dark); }
        .map-container iframe { width: 100%; height: 100%; border: 0; filter: invert(90%) hue-rotate(180deg) contrast(1.1); }
        
        .footer-content { padding: 80px 0 40px; display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 40px; border-bottom: 1px solid var(--border-dark); margin-bottom: 24px; }
        .footer-brand .logo { font-size: 24px; font-weight: 800; margin-bottom: 16px; display: block; }
        .footer-brand .logo span { color: var(--accent-cyan); }
        .footer-brand p { color: var(--text-muted); font-size: 14px; line-height: 1.6; margin-bottom: 24px; max-width: 300px; }
        .contact-info li { display: flex; align-items: center; gap: 12px; color: var(--text-muted); font-size: 14px; margin-bottom: 12px; }
        
        .footer-links h4 { font-size: 13px; font-weight: 700; letter-spacing: 1px; margin-bottom: 20px; color: var(--text-light); text-transform: uppercase; }
        .footer-links ul li { margin-bottom: 12px; }
        .footer-links ul a { color: var(--text-muted); font-size: 14px; transition: color 0.2s; }
        .footer-links ul a:hover { color: var(--accent-cyan); }

        .footer-bottom { padding-bottom: 40px; display: flex; justify-content: space-between; align-items: center; color: var(--text-muted); font-size: 14px; }
        
        /* Layout for Content Sections */
        .page-section { padding: 120px 0; min-height: 80vh; border-bottom: 1px solid var(--border-dark); }
        .page-section h2 { font-size: 40px; font-weight: 800; margin-bottom: 24px; color: var(--text-light); }
        .page-section p { font-size: 18px; color: var(--text-muted); }
</style>

<main id="models-page">
        
        <!-- Standardized Page Header -->
        <section style="padding: 80px 0 40px; border-bottom: 1px solid var(--border-dark);">
            <div class="container">
                <h4 style="font-family: var(--font-data); color: var(--accent-cyan); font-size: 14px; margin-bottom: 12px; letter-spacing: 1px; text-transform: uppercase;">HARDWARE ASSETS</h4>
                <h2 style="font-size: 48px; font-weight: 800; margin-bottom: 16px; color: var(--text-light); letter-spacing: -1px;">The Fleet</h2>
                <p style="color: var(--text-muted); font-size: 20px; line-height: 1.6; max-width: 700px;">Active UAV platforms, autonomous systems, and competition airframes engineered by the division.</p>
            </div>
        </section>

        <!-- Fleet Grid -->
        <section style="padding: 80px 0 100px;">
            <div class="container">
                <div style="margin-bottom: 40px;">
                    <h4 style="font-family: var(--font-data); color: var(--accent-cyan); font-size: 14px; margin-bottom: 12px; letter-spacing: 1px; text-transform: uppercase;">TECHNICAL FLEET</h4>
                    <h3 style="font-size: 36px; font-weight: 800; color: var(--text-light); letter-spacing: -0.5px;">Active Fleet</h3>
                </div>
                <div class="model-grid">
                    {% for model in collections.models %}
                    <a href="{{ model.url }}" class="model-card">
                        <div class="model-img">
                            <img src="{{ model.data.image }}" alt="{{ model.data.title }}">
                        </div>
                        <div class="model-content">
                            <span class="model-meta">{{ model.data.card_meta }}</span>
                            <h4>{{ model.data.title }}</h4>
                            <div class="tech-specs">
                                {% for spec in model.data.card_specs %}
                                <div class="spec-item">
                                    <span class="spec-label">{{ spec.label }}</span>
                                    <span class="spec-value">{{ spec.value }}</span>
                                </div>
                                {% endfor %}
                            </div>
                            <span class="view-specs">View Hardware Data</span>
                        </div>
                    </a>
                    {% endfor %}
                </div>
            </div>
        </section>
    </main>
