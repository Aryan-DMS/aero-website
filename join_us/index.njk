    <section style="padding: clamp(60px, 8vw, 100px) 0 clamp(40px, 5vw, 60px); border-bottom: 1px solid var(--border-dark);">
        <div class="container">
            <h2 style="font-size: clamp(40px, 8vw, 56px); font-weight: 800; margin-bottom: 16px; color: var(--text-light); letter-spacing: -1px; line-height: 1.1;">Recruitment Drives</h2>
            <p style="color: var(--text-muted); font-size: clamp(16px, 4vw, 20px); line-height: 1.6; max-width: 700px;">Review active induction cycles and historical recruitment archives. Select a drive to view the comprehensive multi-stage dashboard.</p>
        </div>
    </section>

    <!-- The Master Drives Grid -->
    <section style="padding: clamp(60px, 8vw, 100px) 0;">
        <div class="container">
            <div class="drives-grid">
                
