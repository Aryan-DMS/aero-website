---
layout: base.njk
title: "AeroClub | Recruitment Drives"
---
<style>
    /* ==========================================
       RECRUITMENT MASTER ARCHIVE STYLES
    ========================================== */
    .drives-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 350px), 1fr));
        gap: clamp(24px, 4vw, 40px);
    }

    /* Clean, Architectural Vertical Cards */
    .drive-card {
        background: var(--bg-deep);
        border: 1px solid var(--border-dark);
        display: flex;
        flex-direction: column;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        border-radius: 4px;
        overflow: hidden;
        text-decoration: none;
    }

    .drive-card:hover {
        border-color: var(--text-light);
        transform: translateY(-4px);
        box-shadow: 0 12px 24px rgba(0,0,0,0.2);
    }

    /* Cinematic Image Header */
    .drive-img {
        height: 240px;
        overflow: hidden;
        border-bottom: 1px solid var(--border-dark);
        position: relative;
    }

    .drive-img img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        filter: grayscale(80%) brightness(0.7);
        transition: all 0.5s ease;
    }

    .drive-card:hover .drive-img img {
        filter: grayscale(0%) brightness(1);
        transform: scale(1.05);
    }

    /* Floating Status Badges */
    .status-badge {
        position: absolute;
        top: 16px;
        right: 16px;
        background: rgba(11, 17, 33, 0.85);
        border: 1px solid var(--border-dark);
        padding: 6px 12px;
        border-radius: 4px;
        font-family: var(--font-data);
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 1px;
        display: flex;
        align-items: center;
        gap: 8px;
        backdrop-filter: blur(4px);
    }
    
    .status-badge.active { color: #10B981; border-color: rgba(16, 185, 129, 0.3); }
    .status-badge.active::before { content: ''; width: 6px; height: 6px; background: #10B981; border-radius: 50%; box-shadow: 0 0 8px #10B981; }
    
    .status-badge.archived { color: var(--text-muted); }

    /* Card Content Formatting */
    .drive-content {
        padding: 32px;
        flex: 1;
        display: flex;
        flex-direction: column;
    }

    .drive-meta {
        font-family: var(--font-data);
        font-size: 12px;
        color: var(--accent-cyan);
        margin-bottom: 12px;
        display: block;
        letter-spacing: 1px;
        text-transform: uppercase;
    }

    .drive-card h4 {
        font-size: 24px;
        font-weight: 800;
        margin-bottom: 16px;
        color: var(--text-light);
        letter-spacing: -0.5px;
    }

    .drive-card p {
        font-size: 15px;
        color: var(--text-muted);
        line-height: 1.6;
        margin-bottom: 32px;
        flex: 1;
    }

    /* Clean bottom link (No buttons) */
    .view-dashboard {
        font-size: 13px;
        font-weight: 700;
        color: var(--text-light);
        text-transform: uppercase;
        letter-spacing: 1px;
        display: flex;
        align-items: center;
        gap: 8px;
        border-top: 1px solid var(--border-dark);
        padding-top: 24px;
        margin-top: auto;
        transition: color 0.2s;
    }

    .view-dashboard::after {
        content: '→';
        color: var(--text-light); /* Enforce white arrow */
        transition: transform 0.2s;
    }

    .drive-card:hover .view-dashboard {
        color: var(--accent-cyan);
    }

    .drive-card:hover .view-dashboard::after {
        transform: translateX(6px);
    }
</style>

<main id="join-page">
    
