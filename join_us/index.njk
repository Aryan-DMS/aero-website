---
layout: base.njk
title: "AeroClub | Recruitment Drives"
---
<style>
    /* ==========================================
       RECRUITMENT MASTER ARCHIVE STYLES
    ========================================== */
    .drives-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 350px), 1fr));
        gap: clamp(24px, 4vw, 40px);
    }

    /* Clean, Architectural Vertical Cards */
    .drive-card {
        background: var(--bg-deep);
        border: 1px solid var(--border-dark);
        display: flex;
        flex-direction: column;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        border-radius: 4px;
        overflow: hidden;
        text-decoration: none;
    }

    .drive-card:hover {
        border-color: var(--text-light);
        transform: translateY(-4px);
        box-shadow: 0 12px 24px rgba(0,0,0,0.2);
    }

    /* Cinematic Image Header */
    .drive-img {
        height: 240px;
        overflow: hidden;
        border-bottom: 1px solid var(--border-dark);
        position: relative;
    }

    .drive-img img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        filter: grayscale(80%) brightness(0.7);
        transition: all 0.5s ease;
    }

    .drive-card:hover .drive-img img {
        filter: grayscale(0%) brightness(1);
        transform: scale(1.05);
    }

    /* Card Content Formatting */
    .drive-content {
        padding: 32px;
        flex: 1;
        display: flex;
        flex-direction: column;
    }

    .drive-meta {
        font-family: var(--font-data);
        font-size: 12px;
        color: var(--accent-cyan);
        margin-bottom: 12px;
        display: block;
        letter-spacing: 1px;
        text-transform: uppercase;
    }

    .drive-card h4 {
        font-size: 24px;
        font-weight: 800;
        margin-bottom: 16px;
        color: var(--text-light);
        letter-spacing: -0.5px;
    }

    .drive-card p {
        font-size: 15px;
        color: var(--text-muted);
        line-height: 1.6;
        margin-bottom: 32px;
        flex: 1;
    }

    /* Clean bottom link (No buttons) */
    .view-dashboard {
        font-family: var(--font-data);
        font-size: 13px;
        font-weight: 700;
        color: var(--text-light);
        text-transform: uppercase;
        letter-spacing: 1px;
        display: flex;
        align-items: center;
        gap: 8px;
        border-top: 1px solid var(--border-dark);
        padding-top: 24px;
        margin-top: auto;
        transition: color 0.2s;
    }

    .view-dashboard::after {
        content: '→';
        transition: transform 0.2s;
    }

    /* Prevents the text and arrow from turning cyan on hover - maintains strict cohesive policy */
    .drive-card:hover .view-dashboard {
        color: var(--text-light); 
    }

    .drive-card:hover .view-dashboard::after {
        transform: translateX(6px);
    }
</style>

<main id="join-page">
    
    <!-- Standardized Page Header -->
    <section style="padding: clamp(60px, 8vw, 100px) 0 clamp(40px, 5vw, 60px); border-bottom: 1px solid var(--border-dark);">
        <div class="container">
            <span style="font-family: var(--font-data); color: var(--accent-cyan); letter-spacing: 1px; text-transform: uppercase; margin-bottom: 16px; display: block; font-size: 13px;">JOIN THE FLEET</span>
            <h1 style="font-size: clamp(40px, 8vw, 56px); font-weight: 800; margin-bottom: 16px; color: var(--text-light); letter-spacing: -1px; line-height: 1.1;">Recruitment Drives</h1>
            <p style="color: var(--text-muted); font-size: clamp(16px, 4vw, 20px); line-height: 1.6; max-width: 700px;">Review active induction cycles and historical recruitment archives. Select a drive to view the comprehensive multi-stage dashboard.</p>
        </div>
    </section>

    <section style="padding: clamp(60px, 8vw, 100px) 0;">
        <div class="container">
            
            <!-- LIVE SECTION -->
            <div style="margin-bottom: 80px;">
                <div style="margin-bottom: 40px;">
                    <span style="font-family: var(--font-data); color: var(--accent-cyan); font-size: 12px; letter-spacing: 1px; text-transform: uppercase; display: block; margin-bottom: 8px;">CURRENT CYCLE</span>
                    <h2 style="font-size: 28px; font-weight: 700; color: var(--text-light); letter-spacing: -0.5px; margin: 0;">Live Operations</h2>
                </div>
                
                <div class="drives-grid">
                    {% set hasLive = false %}
                    {% for driveEntry in collections.drives | reverse %}
                        {% if driveEntry.data.status == 'Live' %}
                            {% set hasLive = true %}
                            <a href="/join_us/{{ driveEntry.fileSlug }}/" class="drive-card">
                                <div class="drive-img">
                                    <img src="{{ driveEntry.data.image | default('https://images.unsplash.com/photo-1581092160562-40aa08e78837?auto=format&fit=crop&q=80&w=800') }}" alt="{{ driveEntry.data.title }}">
                                </div>
                                <div class="drive-content">
                                    <span class="drive-meta">CYCLE // {{ driveEntry.data.title | upper }}</span>
                                    <h4>{{ driveEntry.data.title }}</h4>
                                    <p>{{ driveEntry.data.description | default('Recruitment and induction data for this cycle.') }}</p>
                                    <span class="view-dashboard">Enter Dashboard</span>
                                </div>
                            </a>
                        {% endif %}
                    {% endfor %}
                    {% if not hasLive %}
                        <p style="color: var(--text-muted); font-size: 15px;">No active recruitment drives at this time.</p>
                    {% endif %}
                </div>
            </div>

            <!-- ARCHIVED SECTION -->
            <div>
                <div style="margin-bottom: 40px;">
                    <span style="font-family: var(--font-data); color: var(--accent-cyan); font-size: 12px; letter-spacing: 1px; text-transform: uppercase; display: block; margin-bottom: 8px;">HISTORICAL DATA</span>
                    <h2 style="font-size: 28px; font-weight: 700; color: var(--text-light); letter-spacing: -0.5px; margin: 0;">Archived Drives</h2>
                </div>

                <div class="drives-grid">
                    {% for driveEntry in collections.drives | reverse %}
                        {% if driveEntry.data.status == 'Archived' %}
                            <a href="/join_us/{{ driveEntry.fileSlug }}/" class="drive-card">
                                <div class="drive-img">
                                    <img src="{{ driveEntry.data.image | default('https://images.unsplash.com/photo-1581092160562-40aa08e78837?auto=format&fit=crop&q=80&w=800') }}" alt="{{ driveEntry.data.title }}">
                                </div>
                                <div class="drive-content">
                                    <span class="drive-meta">CYCLE // {{ driveEntry.data.title | upper }}</span>
                                    <h4>{{ driveEntry.data.title }}</h4>
                                    <p>{{ driveEntry.data.description | default('Recruitment and induction data for this cycle.') }}</p>
                                    <span class="view-dashboard">View Archive</span>
                                </div>
                            </a>
                        {% endif %}
                    {% endfor %}
                </div>
            </div>

        </div>
    </section>
</main>

