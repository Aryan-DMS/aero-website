                <!-- CARD 3: ARCHIVED DRIVE -->
                <a href="/join_us/spring-2026/" class="drive-card">
                    <div class="drive-img">
                        <img src="https://images.unsplash.com/photo-1508614589041-895b88991e3e?auto=format&fit=crop&q=80&w=800" alt="Spring 2026">
                        <div class="status-badge archived">ARCHIVED</div>
                    </div>
                    <div class="drive-content">
                        <span class="drive-meta">CYCLE // SP-26</span>
