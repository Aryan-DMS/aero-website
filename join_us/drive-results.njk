---
layout: base.njk
pagination:
  data: collections.drives
  size: 1
  alias: driveEntry
permalink: "join_us/{{ driveEntry.fileSlug }}/results/index.html"
---
<style>
    /* Full 2-Column Structural Grid */
    .report-container { max-width: 1200px; margin: 0 auto; padding: clamp(40px, 8vw, 80px) 24px clamp(80px, 12vw, 140px); box-sizing: border-box; width: 100%; }
    
    /* FIX: minmax(0, 1fr) mathematically prevents Grid Blowout by locking the max width */
    .report-grid { display: grid; grid-template-columns: 350px minmax(0, 1fr); gap: clamp(40px, 6vw, 80px); align-items: start; width: 100%; box-sizing: border-box; }
    
    /* STICKY HUD STYLING */
    .hud-anchor { position: sticky; top: 120px; background: var(--bg-panel-dark); border: 1px solid var(--border-dark); padding: clamp(24px, 4vw, 32px); border-radius: 8px; }
    .hud-metric { font-size: clamp(28px, 4vw, 32px); font-weight: 900; color: var(--text-light); line-height: 1.1; margin-bottom: 8px; letter-spacing: -1px; text-transform: uppercase; }
    .hud-label { font-family: var(--font-ui), sans-serif; font-size: 12px; font-weight: 700; color: var(--accent-cyan); letter-spacing: 1.5px; text-transform: uppercase; margin-bottom: 32px; display: block; }
    .hud-grid { display: flex; flex-direction: column; gap: 20px; margin-bottom: 32px; }
    .hud-item span { display: block; }
    .hud-item-label { font-family: var(--font-ui), sans-serif; font-size: 11px; font-weight: 700; color: var(--text-muted); letter-spacing: 1px; text-transform: uppercase; margin-bottom: 4px; }
    .hud-item-value { font-size: 15px; color: var(--text-light); font-weight: 600; }
    .btn-hud { display: inline-block; width: 100%; text-align: center; padding: 14px; background: var(--text-light); color: var(--bg-deep); font-weight: 800; border-radius: 4px; text-decoration: none; transition: background 0.2s; border: none; cursor: pointer; font-size: 15px; font-family: var(--font-ui), sans-serif; }
    .btn-hud:hover { background: var(--accent-cyan); color: var(--bg-deep); }
    
    /* Right Column Markdown / Fallback */
    .report-content h3 { font-size: 32px; font-weight: 700; color: var(--text-light); margin: 0 0 24px 0; letter-spacing: -0.5px; }
    .report-content p { color: var(--text-muted); font-size: 16px; line-height: 1.7; margin-bottom: 24px; }
    
    /* Terminal Data Table */
    .data-table-wrapper { background: var(--bg-panel-dark); border: 1px solid var(--border-dark); border-radius: 4px; overflow-x: auto; margin-top: 32px; margin-bottom: 40px; width: 100%; box-sizing: border-box; -webkit-overflow-scrolling: touch; }
    /* PDF Action Button */
    .btn-pdf { display: flex; align-items: center; justify-content: center; gap: 8px; padding: 12px 24px; background: transparent; border: 1px solid var(--border-dark); color: var(--text-light); border-radius: 6px; cursor: pointer; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; font-size: 14px; font-weight: 700; transition: all 0.2s ease; white-space: nowrap; outline: none; }
    .btn-pdf:hover { background: var(--text-light); color: var(--bg-deep); border-color: var(--text-light); }
    .btn-pdf svg { width: 16px; height: 16px; }

    table { width: 100%; border-collapse: collapse; text-align: left; }
    th { padding: 20px 24px; font-family: var(--font-data); font-size: 12px; color: var(--text-muted); border-bottom: 1px solid var(--border-dark); text-transform: uppercase; letter-spacing: 1px; background: rgba(0,0,0,0.2); }
    td { padding: 16px 24px; font-size: 15px; color: var(--text-light); border-bottom: 1px solid rgba(255,255,255,0.05); }
    tr:last-child td { border-bottom: none; }
    tr:hover td { background: rgba(255,255,255,0.02); }

    /* NARRATIVE AUTOMATION STYLES */
    .narrative-flow { display: flex; flex-direction: column; gap: 80px; }
    .narrative-phase { display: flex; flex-direction: column; }
    .phase-header { margin-bottom: 24px; }
    .phase-overline { font-family: var(--font-data); font-size: 12px; color: var(--accent-cyan); letter-spacing: 2px; text-transform: uppercase; margin-bottom: 12px; display: block; }
    .phase-heading { font-size: 32px; font-weight: 800; color: var(--text-light); margin: 0; letter-spacing: -0.5px; }
    .phase-text { font-size: 18px; color: var(--text-muted); line-height: 1.8; margin-bottom: 24px; }
    .phase-hook { font-size: 20px; color: var(--text-muted); line-height: 1.8; font-weight: 500; margin: 0; }
    .subsystem-matrix { display: flex; flex-direction: column; border-top: 1px solid var(--border-dark); border-bottom: 1px solid var(--border-dark); margin-top: 24px; margin-bottom: 32px; }
    .matrix-row { display: grid; grid-template-columns: 200px 1fr; border-bottom: 1px solid var(--border-dark); transition: background 0.2s; }
    .matrix-row:last-child { border-bottom: none; }
    .matrix-row:hover { background: rgba(255, 255, 255, 0.02); }
    .matrix-left { padding: 24px 24px 24px 0; font-family: var(--font-ui), sans-serif; font-size: 12px; font-weight: 700; color: var(--text-light); text-transform: uppercase; letter-spacing: 1px; border-right: 1px solid var(--border-dark); }
    .matrix-right { padding: 24px; color: var(--text-muted); font-size: 16px; line-height: 1.6; }
    
    /* Ensure tables trigger horizontal scroll on mobile instead of crushing text */
    th, td { white-space: nowrap; }

    /* ==========================================
       MOBILE RESPONSIVE OVERRIDES
    ========================================== */
    @media (max-width: 1024px) { 
        .report-grid { grid-template-columns: minmax(0, 1fr); }
        .hud-anchor { position: relative; top: 0; margin-bottom: 16px; width: 100%; box-sizing: border-box; }
        .narrative-flow { width: 100%; min-width: 0; }
    }
    @media (max-width: 768px) {
        .matrix-row { grid-template-columns: 1fr; gap: 8px; padding: 24px 0; }
        .matrix-left { padding: 0; border-right: none; }
        .matrix-right { padding: 0; }
    }
</style>

<main>
    <!-- MAGIC BINDING: Dynamically pull the exact CMS data for this specific URL -->
    {% set drive = driveEntry.data %}

    <!-- Cinematic Phase Header -->
    <section style="min-height: 35vh; height: auto; background: linear-gradient(to top, var(--bg-deep) 10%, rgba(11,17,33,0.7)), url('{{ drive.image }}') center/cover; position: relative; display: flex; align-items: flex-end; padding-top: 120px; padding-bottom: clamp(32px, 6vw, 40px); border-bottom: 1px solid var(--border-dark);">
        <div class="container" style="width: 100%;">
            <a href="/join_us/{{ driveEntry.fileSlug }}/" style="font-family: var(--font-data); color: var(--text-muted); font-size: 13px; letter-spacing: 1px; text-transform: uppercase; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; margin-bottom: 24px; transition: color 0.2s;">← Back to Dashboard</a>
            <span style="margin-bottom: 12px; font-family: var(--font-data); font-size: 13px; color: var(--accent-cyan); letter-spacing: 1px; text-transform: uppercase; display: block;">PHASE 04 // {{ drive.phase4.status | default('COMPLETED') | upper }}</span>
            <h1 style="font-size: 48px; font-weight: 800; color: var(--text-light); letter-spacing: -1px; margin: 0; line-height: 1.1;">Final Induction Roster</h1>
        </div>
    </section>

    <div class="report-container">
        <!-- 2-Column Split -->
        <div class="report-grid">
            
            <!-- LEFT COLUMN: Premium Sticky HUD -->
            <aside class="hud-anchor">
                <div class="hud-metric">PHASE 04</div>
                <span class="hud-label" {% if drive.phase4.status == 'Completed' or drive.phase4.status == 'COMPLETED' %}style="color: var(--accent-cyan);"{% endif %}>{{ drive.phase4.status | default('Pending') }}</span>
                
                {% if drive.phase4.metrics %}
                <div class="hud-grid" style="margin-top: 24px;">
                    {% for metric in drive.phase4.metrics %}
                    <div class="hud-item"><span class="hud-item-label">{{ metric.label }}</span><span class="hud-item-value" {% if metric.value == 'Completed' or metric.value == 'COMPLETED' %}style="color: var(--accent-cyan);"{% endif %}>{{ metric.value }}</span></div>
                    {% endfor %}
                </div>
                {% endif %}
            </aside>

            <!-- RIGHT COLUMN: Narrative Engine + Command Terminal Data -->
            <article class="narrative-flow">
                {% set mode = drive.phase4.report_mode | default('Automation') %}
                {% if mode == 'Automation' and drive.phase4.automation_payload %}
                    {% set rawPayload = drive.phase4.automation_payload.code if drive.phase4.automation_payload.code else drive.phase4.automation_payload %}
                    {% set p = rawPayload | parseJSON %}
                    
                    <!-- GENERALIZED BLOCK BUILDER ENGINE -->
                    {% for section in p.sections %}
                    <div class="narrative-phase">
                        
                        <!-- Architectural Header -->
                        <div class="phase-header">
                            {% if section.overline %}<span class="phase-overline">{{ section.overline }}</span>{% endif %}
                            <h3 class="phase-heading">{{ section.heading }}</h3>
                        </div>
                        
                        <!-- Infinite Paragraph Loop -->
                        {% if section.paragraphs %}
                            {% for para in section.paragraphs %}
                                <p class="phase-text">{{ para }}</p>
                            {% endfor %}
                        {% endif %}
                        
                        <!-- Dynamic Visual Injection Engine -->
                        {% if section.visual_type == 'matrix' and section.visual_data %}
                            <div class="subsystem-matrix">
                                {% for row in section.visual_data %}
                                <div class="matrix-row">
                                    <div class="matrix-left">{{ row.label }}</div>
                                    <div class="matrix-right">{{ row.val }}</div>
                                </div>
                                {% endfor %}
                            </div>
                        {% endif %}
                        
                    </div>
                    {% endfor %}
                {% else %}
                    <!-- LEGACY MANUAL FALLBACK -->
                    <div class="report-content" style="white-space: pre-wrap;">
                        <h3>Final Induction Results</h3>
                        {{ drive.phase4.report | default("Final results will appear here once published in CMS.") }}
                    </div>
                {% endif %}

                <!-- SECURE DECLASSIFICATION GATE (HIDDEN BY DEFAULT) -->
                <div id="countdown-wrapper" style="display: none; background: var(--bg-panel-dark); border: 1px solid var(--border-dark); padding: 60px 20px; text-align: center; border-radius: 4px; margin-top: 32px; margin-bottom: 40px;">
                    <span style="font-family: var(--font-data); color: var(--accent-cyan); letter-spacing: 2px; text-transform: uppercase; font-size: 12px; margin-bottom: 16px; display: block;">PUBLISHING OUTCOMES IN</span>
                    <div id="countdown-timer" style="font-size: clamp(40px, 8vw, 64px); font-weight: 900; color: var(--text-light); letter-spacing: -2px; font-variant-numeric: tabular-nums;">--:--:--</div>
                </div>

                <!-- CSV TERMINAL INJECTION (HIDDEN BY DEFAULT) -->
                <div id="secure-data" style="display: none; margin-top: 32px; margin-bottom: 40px;">
                    
                    <!-- ARCHITECTURAL TABLE HEADER -->
                    <div style="margin-bottom: 24px;">
                        <span style="font-family: var(--font-data); color: var(--accent-cyan); font-size: 13px; letter-spacing: 1px; text-transform: uppercase; display: block; margin-bottom: 8px;">PHASE 04 // FINAL</span>
                        <h3 style="font-size: 28px; font-weight: 800; color: var(--text-light); letter-spacing: -0.5px; margin: 0;">Inducted Operatives</h3>
                    </div>

                    <!-- SEARCH & EXPORT ACTION BAR -->
                    <div style="display: flex; gap: 12px; margin-bottom: 16px; flex-wrap: wrap;">
                        <div style="position: relative; flex: 1; min-width: 250px;">
                            <span style="position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: var(--text-muted); display: flex; align-items: center; pointer-events: none;">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                            </span>
                            <input type="text" id="candidate-search" onkeyup="filterTable()" placeholder="Search by inductee name..." style="width: 100%; box-sizing: border-box; padding: 12px 16px 12px 42px; background: var(--bg-panel-dark); border: 1px solid var(--border-dark); color: var(--text-light); font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; font-size: 15px; border-radius: 6px; outline: none; transition: all 0.2s ease-in-out;" onfocus="this.style.borderColor='var(--text-light)';" onblur="this.style.borderColor='var(--border-dark)';">
                        </div>
                        <button onclick="downloadPDF()" class="btn-pdf" title="Download Current Roster as PDF">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                            Download PDF
                        </button>
                    </div>
                    
                    <div class="data-table-wrapper" style="margin: 0;">
                        <table id="roster-table" style="border-left: 4px solid var(--accent-cyan);">
                            <thead><tr><th>Inductee Name</th><th>Assigned Division</th><th>Status</th></tr></thead>
                            <tbody>
                                {% for applicant in csvData[driveEntry.fileSlug] %}
                                    <!-- Looking for "Yes" or "Inducted" so the Captain has flexibility -->
                                    {% if applicant['Final Status'] == 'Yes' or applicant['Final Status'] == 'Inducted' %}
                                    <tr>
                                        <td>{{ applicant['Full Name'] }}</td>
                                        <td>{{ applicant['Division Preference'] }}</td>
                                        <td style="color: var(--accent-cyan); font-weight: 700;">INDUCTED</td>
                                    </tr>
                                    {% endif %}
                                {% endfor %}
                            </tbody>
                        </table>
                        
                        <!-- SEARCH EMPTY STATE -->
                        <div id="empty-search-state" style="display: none; padding: 60px 20px; text-align: center; background: var(--bg-deep);">
                            <span style="font-family: var(--font-data); font-size: 13px; color: var(--accent-cyan); letter-spacing: 2px; text-transform: uppercase; display: block; margin-bottom: 12px;">QUERY RETURNED ZERO MATCHES</span>
                            <p style="color: var(--text-muted); font-size: 15px; margin: 0; font-family: var(--font-ui), sans-serif;">Applicant dossier not found in the final induction roster.</p>
                        </div>
                    </div>
                </div>

                <!-- DELAYED TRANSMISSION FAILSAFE (HIDDEN BY DEFAULT) -->
                <div id="delayed-transmission" style="display: none; background: rgba(239, 68, 68, 0.05); border: 1px solid rgba(239, 68, 68, 0.3); padding: 40px 20px; text-align: center; border-radius: 4px; margin-top: 32px; margin-bottom: 40px;">
                    <span style="font-family: var(--font-data); color: #ef4444; letter-spacing: 2px; text-transform: uppercase; font-size: 13px; display: block; margin-bottom: 12px;">OUTCOMES PENDING</span>
                    <p style="color: var(--text-muted); font-size: 15px; margin: 0; font-family: var(--font-data);">The final outcome roster is currently being processed. Please check back shortly.</p>
                </div>
            </article>
        </div>
    </div>
</main>

<!-- PDF Generation Libraries -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.31/jspdf.plugin.autotable.min.js"></script>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        const releaseString = "{{ drive.timeline.phase4_release }}"; 
        const wrapper = document.getElementById('countdown-wrapper');
        const timerDisplay = document.getElementById('countdown-timer');
        const secureData = document.getElementById('secure-data');
        const delayedTransmission = document.getElementById('delayed-transmission');

        const tbody = secureData.querySelector('tbody');
        const hasData = tbody && tbody.children.length > 0;

        if (!releaseString) {
            if (hasData) secureData.style.display = 'block';
            else delayedTransmission.style.display = 'block';
            return;
        }

        const releaseDate = new Date(releaseString).getTime();

        function checkAndRender() {
            const now = new Date().getTime();
            const distance = releaseDate - now;

            if (distance <= 0) {
                wrapper.style.display = 'none';
                if (hasData) {
                    secureData.style.display = 'block';
                } else {
                    delayedTransmission.style.display = 'block';
                }
                return true; 
            } else {
                wrapper.style.display = 'block';
                secureData.style.display = 'none';
                delayedTransmission.style.display = 'none';
                
                const hours = Math.floor(distance / (1000 * 60 * 60));
                const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
                const seconds = Math.floor((distance % (1000 * 60)) / 1000);

                timerDisplay.innerHTML = 
                    (hours < 10 ? "0" : "") + hours + "<span>:</span>" + 
                    (minutes < 10 ? "0" : "") + minutes + "<span>:</span>" + 
                    (seconds < 10 ? "0" : "") + seconds;
                return false;
            }
        }

        if (!checkAndRender()) {
            const x = setInterval(function() {
                if (checkAndRender()) clearInterval(x);
            }, 1000);
        }
    });

    // Live Search Filter Logic (Targets Column 0: Inductee Name)
    window.filterTable = function() {
        const input = document.getElementById("candidate-search");
        const filter = input.value.toUpperCase();
        const tbody = document.querySelector("#roster-table tbody");
        const trs = tbody.getElementsByTagName("tr");
        let visibleCount = 0;

        for (let i = 0; i < trs.length; i++) {
            const tds = trs[i].getElementsByTagName("td");
            if (tds.length > 0) {
                const nameCell = tds[0]; // Name is in the first column
                const nameText = nameCell.textContent || nameCell.innerText;
                if (nameText.toUpperCase().indexOf(filter) > -1) {
                    trs[i].style.display = "";
                    visibleCount++;
                } else {
                    trs[i].style.display = "none";
                }
            }
        }
        
        document.getElementById('empty-search-state').style.display = visibleCount === 0 ? 'block' : 'none';
        document.getElementById('roster-table').style.display = visibleCount === 0 ? 'none' : 'table';
    };

    // Professional PDF Generation Engine
    window.downloadPDF = function() {
        const { jsPDF } = window.jspdf;
        const doc = new jsPDF();
        
        const driveName = "{{ driveEntry.data.title | default('Recruitment Drive') | upper }}";
        const phaseName = document.querySelector('.hud-metric').innerText; // Grabs Phase 02, 03, etc.
        const dateString = new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

        // AeroClub Corporate Header
        doc.setFontSize(22);
        doc.setFont("helvetica", "bold");
        doc.text("AEROCLUB", 14, 20);
        
        doc.setFontSize(10);
        doc.setFont("helvetica", "bold");
        doc.text("OFFICIAL ROSTER DATA", 14, 28);
        
        doc.setFontSize(10);
        doc.setFont("helvetica", "normal");
        doc.text(`CYCLE: ${driveName}`, 14, 34);
        doc.text(`STAGE: ${phaseName}`, 14, 39);
        doc.text(`GENERATED: ${dateString}`, 14, 44);

        // Auto-Scrape & Render Table
        doc.autoTable({
            html: '#roster-table',
            startY: 52,
            theme: 'grid',
            headStyles: { fillColor: [14, 165, 233], textColor: [255, 255, 255], fontStyle: 'bold', fontSize: 10 },
            styles: { font: 'helvetica', fontSize: 9, cellPadding: 5 },
            alternateRowStyles: { fillColor: [245, 245, 245] },
            useCss: true // CRITICAL: This ensures filtered/hidden rows are NOT printed
        });

        // Trigger Native Download
        doc.save(`AeroClub_${phaseName}_Roster.pdf`.replace(/\s+/g, '_'));
    };
</script>
