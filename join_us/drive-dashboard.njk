---
layout: base.njk
pagination:
  data: collections.drives
  size: 1
  alias: driveEntry
permalink: "join_us/{{ driveEntry.fileSlug }}/index.html"
---
<style>
    /* ==========================================
        CLEAN NATIVE UI - COMMAND DASHBOARD
    ========================================== */
    .dashboard-grid { 
        display: grid; 
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); 
        gap: 32px; 
    }
    
    .mission-card {
        background: var(--bg-deep);
        border: 1px solid var(--border-dark);
        border-radius: 4px;
        display: flex;
        flex-direction: column;
        text-decoration: none;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
    
    .mission-card:hover {
        border-color: var(--text-muted);
        transform: translateY(-4px);
    }

    /* CSS Lock for Time-Gating */
    .mission-card.status-locked {
        opacity: 0.5;
        pointer-events: none;
        cursor: not-allowed;
    }

    .card-content {
        padding: 40px;
        display: flex;
        flex-direction: column;
        flex-grow: 1;
    }

    .card-meta {
        font-family: var(--font-data);
        font-size: 13px;
        color: var(--accent-cyan);
        letter-spacing: 1px;
        text-transform: uppercase;
        margin-bottom: 16px;
        display: block;
    }
    
    /* Unique colors for JS states */
    .meta-closed { color: #ef4444 !important; }
    .meta-decrypting { color: #f59e0b !important; animation: pulse 2s infinite; }
    @keyframes pulse { 0% { opacity: 1; } 50% { opacity: 0.5; } 100% { opacity: 1; } }

    .card-title {
        font-size: 24px;
        font-weight: 700;
        color: var(--text-light);
        margin-bottom: 16px;
        letter-spacing: -0.5px;
    }

    .card-desc {
        color: var(--text-muted);
        font-size: 16px;
        line-height: 1.6;
        margin-bottom: 32px;
        flex-grow: 1;
    }

    .card-footer {
        border-top: 1px solid var(--border-dark);
        padding-top: 24px;
        margin-top: auto;
    }

    .card-cta {
        font-family: var(--font-data);
        font-size: 13px;
        font-weight: 700;
        color: var(--text-light);
        letter-spacing: 1px;
        text-transform: uppercase;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .card-cta span {
        color: var(--text-light);
        transition: transform 0.2s;
    }

    .mission-card:hover .card-cta span {
        transform: translateX(6px);
    }
</style>

<main id="command-dashboard">
    <!-- MAGIC BINDING: Dynamically pull the exact CMS data for this specific URL -->
    {% set drive = driveEntry.data %}

    <!-- Massive Cinematic Header -->
    <section style="height: 60vh; background: linear-gradient(to top, var(--bg-deep), transparent 60%), url('{{ drive.image }}') center/cover; position: relative; display: flex; align-items: flex-end; padding-bottom: 60px; border-bottom: 1px solid var(--border-dark);">
        <div class="container" style="width: 100%;">
            <a href="/join_us/" style="font-family: var(--font-data); color: var(--text-muted); text-transform: uppercase; font-size: 13px; display: inline-flex; align-items: center; gap: 8px; margin-bottom: 24px; transition: color 0.2s;">← Back to Archives</a>
            
            <span style="display: block; color: var(--accent-cyan); font-family: var(--font-data); letter-spacing: 1px; margin-bottom: 16px; text-transform: uppercase;">
                RECRUITMENT CYCLE
            </span>
            
            <h1 style="font-size: clamp(40px, 8vw, 64px); font-weight: 800; line-height: 1.1; max-width: 900px; letter-spacing: -1px; color: var(--text-light); margin-bottom: 32px;">
                {{ drive.title | default("Induction Cycle") }}
            </h1>
            
            <div style="background: rgba(15, 23, 42, 0.85); backdrop-filter: blur(8px); border: 1px solid var(--border-dark); padding: 24px; border-radius: 4px; max-width: 800px;">
                <h4 style="font-family: var(--font-data); font-size: 12px; color: var(--text-muted); letter-spacing: 1px; margin-bottom: 12px; text-transform: uppercase;">ACTIVE RECRUITMENT ROLES</h4>
                <p style="color: var(--text-light); font-size: 16px; line-height: 1.6; font-weight: 500; margin: 0;">
                    {{ drive.roles | default("Aerodynamics, Embedded Systems, Payload Integration, Web Design") }}
                </p>
            </div>
        </div>
    </section>

    <!-- Clean Card Grid -->
    <section style="padding: clamp(60px, 8vw, 100px) 0;">
        <div class="container">
            <div class="dashboard-grid">
                
                <!-- PHASE 01: Defaults to Unlocked -->
                <a href="/join_us/{{ driveEntry.fileSlug }}/application/" id="card-phase1" class="mission-card">
                    <div class="card-content">
                        <span class="card-meta" id="label-phase1">PHASE 01 // OPEN</span>
                        <h3 class="card-title">The Directive</h3>
                        <p class="card-desc">Role breakdowns, technical test syllabus, and the primary application portal.</p>
                        <div class="card-footer">
                            <span class="card-cta">ACCESS PORTAL <span>→</span></span>
                        </div>
                    </div>
                </a>

                <!-- PHASE 02: Defaults to Locked -->
                <a href="/join_us/{{ driveEntry.fileSlug }}/shortlist/" id="card-phase2" class="mission-card status-locked">
                    <div class="card-content">
                        <span class="card-meta" id="label-phase2">PHASE 02 // PENDING</span>
                        <h3 class="card-title">First Filter</h3>
                        <p class="card-desc">Official roster of candidates who cleared the technical exam and advanced to interviews.</p>
                        <div class="card-footer">
                            <span class="card-cta">VIEW DATA <span>→</span></span>
                        </div>
                    </div>
                </a>

                <!-- PHASE 03: Defaults to Locked -->
                <a href="/join_us/{{ driveEntry.fileSlug }}/interview/" id="card-phase3" class="mission-card status-locked">
                    <div class="card-content">
                        <span class="card-meta" id="label-phase3">PHASE 03 // PENDING</span>
                        <h3 class="card-title">Engagement</h3>
                        <p class="card-desc">Panel schedules, time-slots, and preparation guidelines for shortlisted applicants.</p>
                        <div class="card-footer">
                            <span class="card-cta">VIEW LOGISTICS <span>→</span></span>
                        </div>
                    </div>
                </a>

                <!-- PHASE 04: Defaults to Locked -->
                <a href="/join_us/{{ driveEntry.fileSlug }}/results/" id="card-phase4" class="mission-card status-locked">
                    <div class="card-content">
                        <span class="card-meta" id="label-phase4">PHASE 04 // PENDING</span>
                        <h3 class="card-title">Outcomes</h3>
                        <p class="card-desc">The finalized list of inducted engineering operatives for the competition cycle.</p>
                        <div class="card-footer">
                            <span class="card-cta">VIEW ROSTER <span>→</span></span>
                        </div>
                    </div>
                </a>

            </div>
        </div>
    </section>
</main>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        
        // --- PHASE 1 DEADLINE ENGINE ---
        function evaluateDeadline(cardId, labelId, deadlineStr) {
            const card = document.getElementById(cardId);
            const label = document.getElementById(labelId);
            if (!card || !deadlineStr) return; 

            const deadlineDate = new Date(deadlineStr).getTime();
            
            function checkDeadline() {
                const now = new Date().getTime();
                if (now >= deadlineDate) {
                    card.classList.add('status-locked'); // Lock it
                    label.innerText = 'PHASE 01 // CLOSED';
                    label.classList.add('meta-closed');
                } else {
                    card.classList.remove('status-locked');
                    label.innerText = 'PHASE 01 // OPEN';
                    label.classList.remove('meta-closed');
                }
            }
            checkDeadline();
            setInterval(checkDeadline, 1000);
        }

        // --- PHASE 2, 3, 4 RELEASE ENGINE (With 60s Teaser) ---
        function evaluateRelease(cardId, labelId, phaseNum, releaseStr) {
            const card = document.getElementById(cardId);
            const label = document.getElementById(labelId);
            
            // If the Captain hasn't set a release time yet, keep it locked indefinitely
            if (!card || !releaseStr) return; 

            const releaseDate = new Date(releaseStr).getTime();
            const teaserDate = releaseDate - 60000; // Exactly 60 seconds before release
            
            function checkRelease() {
                const now = new Date().getTime();
                
                // STATE 1: Too early. Keep locked.
                if (now < teaserDate) {
                    card.classList.add('status-locked');
                    label.innerText = `PHASE 0${phaseNum} // PENDING`;
                    label.className = 'card-meta'; // Reset colors
                } 
                // STATE 2: The 60-Second Teaser Window! Unlock card, pulse text.
                else if (now >= teaserDate && now < releaseDate) {
                    card.classList.remove('status-locked');
                    label.innerText = `PHASE 0${phaseNum} // DECRYPTING...`;
                    label.className = 'card-meta meta-decrypting'; 
                } 
                // STATE 3: Fully Released.
                else if (now >= releaseDate) {
                    card.classList.remove('status-locked');
                    label.innerText = `PHASE 0${phaseNum} // DECLARED`;
                    label.className = 'card-meta'; 
                }
            }
            
            checkRelease();
            setInterval(checkRelease, 1000);
        }

        // Initialize all engines dynamically using the CMS timestamps
        evaluateDeadline('card-phase1', 'label-phase1', '{{ drive.phase1.deadline }}');
        evaluateRelease('card-phase2', 'label-phase2', '2', '{{ drive.phase2.release_time }}');
        evaluateRelease('card-phase3', 'label-phase3', '3', '{{ drive.phase3.release_time }}');
        evaluateRelease('card-phase4', 'label-phase4', '4', '{{ drive.phase4.release_time }}');
    });
</script>

