---
layout: base.njk
pagination:
  data: collections.drives
  size: 1
  alias: driveEntry
permalink: "join_us/{{ driveEntry.fileSlug }}/index.html"
---
<style>
    .dashboard-grid { 
        display: grid; 
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); 
        gap: var(--space-gap); 
    }
    
    .mission-card {
        background: var(--bg-deep);
        border: 1px solid var(--border-dark);
        border-radius: 4px;
        display: flex;
        flex-direction: column;
        text-decoration: none;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
    
    .mission-card:hover {
        border-color: var(--text-muted);
        transform: translateY(-4px);
    }

    .mission-card.status-locked {
        opacity: 0.5;
        pointer-events: none;
        cursor: not-allowed;
    }

    .card-content {
        padding: 40px;
        display: flex;
        flex-direction: column;
        flex-grow: 1;
    }

    .card-meta {
        font-family: var(--font-data);
        font-size: 13px;
        color: var(--accent-cyan);
        letter-spacing: 1px;
        text-transform: uppercase;
        margin-bottom: 16px;
        display: block;
        transition: color 0.3s ease;
    }
    
    .card-title {
        font-size: 24px;
        font-weight: 700;
        color: var(--text-light);
        margin-bottom: 16px;
        letter-spacing: -0.5px;
    }

    .card-desc {
        color: var(--text-muted);
        font-size: 16px;
        line-height: 1.6;
        margin-bottom: 24px;
        flex-grow: 1;
    }

    /* Cleaned up, elegant schedule text (No more terminal box) */
    .card-schedule {
        font-size: 15px;
        color: var(--text-muted);
        margin-bottom: 32px;
        font-weight: 500;
    }

    .card-footer {
        border-top: 1px solid var(--border-dark);
        padding-top: 24px;
        margin-top: auto;
    }

    .card-cta {
        font-family: var(--font-data);
        font-size: 13px;
        font-weight: 700;
        color: var(--text-light);
        letter-spacing: 1px;
        text-transform: uppercase;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .card-cta span {
        transition: transform 0.2s;
    }

    .mission-card:hover .card-cta span {
        transform: translateX(6px);
    }
</style>

<main id="command-dashboard">
    {% set drive = driveEntry.data %}

    <!-- Massive Cinematic Header -->
    <section style="height: 60vh; background: linear-gradient(to top, var(--bg-deep), transparent 60%), url('{{ drive.image }}') center/cover; position: relative; display: flex; align-items: flex-end; padding-bottom: 60px; border-bottom: 1px solid var(--border-dark);">
        <div class="container" style="width: 100%;">
            <a href="/join_us/" style="font-family: var(--font-data); color: var(--text-muted); text-transform: uppercase; font-size: 13px; display: inline-flex; align-items: center; gap: 8px; margin-bottom: 24px; transition: color 0.2s;">← Back to Archives</a>
            
            <span style="display: block; color: var(--accent-cyan); font-family: var(--font-data); letter-spacing: 1px; margin-bottom: 16px; text-transform: uppercase;">
                RECRUITMENT CYCLE
            </span>
            
            <h1 style="font-size: clamp(40px, 8vw, 64px); font-weight: 800; line-height: 1.1; max-width: 900px; letter-spacing: -1px; color: var(--text-light); margin-bottom: 0;">
                {{ drive.title | default("Induction Cycle") }}
            </h1>
        </div>
    </section>

    <!-- Clean Card Grid -->
    <section style="padding: clamp(60px, 8vw, 100px) 0;">
        <div class="container">
            
            <!-- ACTIVE ROLES CARD -->
            <div style="background: var(--bg-deep); border: 1px solid var(--border-dark); border-radius: 4px; padding: 32px 40px; margin-bottom: 48px;">
                <h4 style="font-family: var(--font-data); font-size: 13px; color: var(--accent-cyan); letter-spacing: 1px; text-transform: uppercase; margin-bottom: 16px;">Active Recruitment Roles</h4>
                <div style="display: flex; flex-wrap: wrap; gap: 12px;">
                    {% set rolesList = drive.roles | default("Aerodynamics, Embedded Systems, Payload Integration, Web Design") %}
                    {% for role in rolesList.split(',') %}
                        <span style="background: rgba(14, 165, 233, 0.05); border: 1px solid rgba(14, 165, 233, 0.2); color: var(--text-light); padding: 8px 16px; border-radius: 4px; font-size: 14px; font-weight: 600; font-family: var(--font-ui), sans-serif;">{{ role | trim }}</span>
                    {% endfor %}
                </div>
            </div>

            <div class="dashboard-grid">
                
                <!-- PHASE 01 -->
                <a href="/join_us/{{ driveEntry.fileSlug }}/application/" id="card-phase1" class="mission-card">
                    <div class="card-content">
                        <span class="card-meta" id="label-phase1">PHASE 01 // OPEN</span>
                        <h3 class="card-title">The Directive</h3>
                        <p class="card-desc">Role breakdowns, technical test syllabus, and the primary application portal.</p>
                        <div class="card-schedule" id="time-phase1">Deadline: TBD</div>
                        <div class="card-footer">
                            <span class="card-cta">ACCESS PORTAL <span>→</span></span>
                        </div>
                    </div>
                </a>

                <!-- PHASE 02 -->
                <a href="/join_us/{{ driveEntry.fileSlug }}/shortlist/" id="card-phase2" class="mission-card status-locked">
                    <div class="card-content">
                        <span class="card-meta" id="label-phase2">PHASE 02 // PENDING</span>
                        <h3 class="card-title">First Filter</h3>
                        <p class="card-desc">Official roster of candidates who cleared the technical exam and advanced to interviews.</p>
                        <div class="card-schedule" id="time-phase2">Scheduled: TBD</div>
                        <div class="card-footer">
                            <span class="card-cta">VIEW DATA <span>→</span></span>
                        </div>
                    </div>
                </a>

                <!-- PHASE 03 -->
                <a href="/join_us/{{ driveEntry.fileSlug }}/interview/" id="card-phase3" class="mission-card status-locked">
                    <div class="card-content">
                        <span class="card-meta" id="label-phase3">PHASE 03 // PENDING</span>
                        <h3 class="card-title">Engagement</h3>
                        <p class="card-desc">Panel schedules, time-slots, and preparation guidelines for shortlisted applicants.</p>
                        <div class="card-schedule" id="time-phase3">Scheduled: TBD</div>
                        <div class="card-footer">
                            <span class="card-cta">VIEW LOGISTICS <span>→</span></span>
                        </div>
                    </div>
                </a>

                <!-- PHASE 04 -->
                <a href="/join_us/{{ driveEntry.fileSlug }}/results/" id="card-phase4" class="mission-card status-locked">
                    <div class="card-content">
                        <span class="card-meta" id="label-phase4">PHASE 04 // PENDING</span>
                        <h3 class="card-title">Outcomes</h3>
                        <p class="card-desc">The finalized list of inducted engineering operatives for the competition cycle.</p>
                        <div class="card-schedule" id="time-phase4">Scheduled: TBD</div>
                        <div class="card-footer">
                            <span class="card-cta">VIEW ROSTER <span>→</span></span>
                        </div>
                    </div>
                </a>

            </div>
        </div>
    </section>
</main>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        
        // Clean display time format
        function formatDisplayTime(isoString, prefix) {
            if (!isoString) return prefix + " TBD";
            const d = new Date(isoString);
            return prefix + " " + d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', hour: '2-digit', minute:'2-digit' });
        }

        function evaluateDeadline(cardId, labelId, timeId, deadlineStr) {
            const card = document.getElementById(cardId);
            const label = document.getElementById(labelId);
            const timeDisplay = document.getElementById(timeId);
            if (!card || !deadlineStr) return; 

            timeDisplay.innerText = formatDisplayTime(deadlineStr, "Deadline:");
            const deadlineDate = new Date(deadlineStr).getTime();
            
            function checkDeadline() {
                const now = new Date().getTime();
                if (now >= deadlineDate) {
                    card.classList.add('status-locked');
                    label.innerText = 'PHASE 01 // CLOSED';
                    label.style.color = 'var(--text-muted)';
                } else {
                    card.classList.remove('status-locked');
                    label.innerText = 'PHASE 01 // OPEN';
                    label.style.color = 'var(--accent-cyan)';
                }
            }
            checkDeadline();
            setInterval(checkDeadline, 1000);
        }

        // Clean Professional 3-State Engine
        function evaluateRelease(cardId, labelId, timeId, phaseNum, releaseStr) {
            const card = document.getElementById(cardId);
            const label = document.getElementById(labelId);
            const timeDisplay = document.getElementById(timeId);
            
            if (!card || !releaseStr) return; 

            timeDisplay.innerText = formatDisplayTime(releaseStr, "Scheduled:");
            const releaseDate = new Date(releaseStr).getTime();
            const teaserDate = releaseDate - 60000; 
            
            function checkRelease() {
                const now = new Date().getTime();
                
                if (now < teaserDate) {
                    card.classList.add('status-locked');
                    label.innerText = `PHASE 0${phaseNum} // PENDING`;
                    label.style.color = 'var(--accent-cyan)';
                } 
                else if (now >= teaserDate && now < releaseDate) {
                    card.classList.remove('status-locked');
                    label.innerText = `PHASE 0${phaseNum} // PROCESSING`;
                    label.style.color = 'var(--text-light)'; // Clean white during processing
                } 
                else if (now >= releaseDate) {
                    card.classList.remove('status-locked');
                    label.innerText = `PHASE 0${phaseNum} // PUBLISHED`;
                    label.style.color = 'var(--accent-cyan)';
                    timeDisplay.innerText = "Status: Released"; 
                }
            }
            checkRelease();
            setInterval(checkRelease, 1000);
        }

        evaluateDeadline('card-phase1', 'label-phase1', 'time-phase1', '{{ drive.timeline.phase1_deadline }}');
        evaluateRelease('card-phase2', 'label-phase2', 'time-phase2', '2', '{{ drive.timeline.phase2_release }}');
        evaluateRelease('card-phase3', 'label-phase3', 'time-phase3', '3', '{{ drive.timeline.phase3_release }}');
        evaluateRelease('card-phase4', 'label-phase4', 'time-phase4', '4', '{{ drive.timeline.phase4_release }}');
    });
</script>
