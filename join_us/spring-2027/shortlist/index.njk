<style>
    .report-container { max-width: 900px; margin: 0 auto; padding: 100px 20px 140px; }
    .report-meta { font-family: var(--font-data); font-size: 13px; color: var(--text-muted); letter-spacing: 1px; text-transform: uppercase; margin-bottom: 16px; display: block; }
    .report-title { font-size: 48px; font-weight: 800; color: var(--text-light); letter-spacing: -1px; margin-bottom: 40px; line-height: 1.1; }
    
    /* Clean, highly technical data tables */
    .data-table-wrapper { background: var(--bg-panel-dark); border: 1px solid var(--border-dark); border-radius: 4px; overflow-x: auto; }
    table { width: 100%; border-collapse: collapse; text-align: left; }
    th { padding: 20px 24px; font-family: var(--font-data); font-size: 12px; color: var(--text-muted); border-bottom: 1px solid var(--border-dark); text-transform: uppercase; letter-spacing: 1px; background: rgba(0,0,0,0.2); }
    td { padding: 16px 24px; font-size: 15px; color: var(--text-light); border-bottom: 1px solid rgba(255,255,255,0.05); }
    tr:last-child td { border-bottom: none; }
    tr:hover td { background: rgba(255,255,255,0.02); }
    
    .status-pass { color: #10B981; font-weight: 700; font-family: var(--font-data); font-size: 13px; }
    .id-hash { font-family: var(--font-data); color: var(--accent-cyan); font-size: 14px; }
