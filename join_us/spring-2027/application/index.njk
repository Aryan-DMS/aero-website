---
layout: base.njk
title: "AeroClub | Phase 01: Application"
---
<style>
    /* Full 2-Column Structural Grid */
    .report-container { max-width: 1200px; margin: 0 auto; padding: 80px 24px 140px; }
    
    .report-grid { display: grid; grid-template-columns: 350px 1fr; gap: clamp(40px, 6vw, 80px); align-items: start; }
    @media (max-width: 900px) { .report-grid { grid-template-columns: 1fr; } }

    /* STICKY HUD STYLING (Replaces hacky boxes) */
    .hud-anchor { position: sticky; top: 120px; background: var(--bg-panel-dark); border: 1px solid var(--border-dark); padding: 32px; border-radius: 8px; }
    .hud-metric { font-size: 32px; font-weight: 900; color: var(--text-light); line-height: 1.1; margin-bottom: 8px; letter-spacing: -1px; text-transform: uppercase; }
    .hud-label { font-family: var(--font-ui), sans-serif; font-size: 12px; font-weight: 700; color: var(--accent-cyan); letter-spacing: 1.5px; text-transform: uppercase; margin-bottom: 32px; display: block; }
    .hud-grid { display: flex; flex-direction: column; gap: 20px; margin-bottom: 32px; }
    .hud-item span { display: block; }
    .hud-item-label { font-family: var(--font-ui), sans-serif; font-size: 11px; font-weight: 700; color: var(--text-muted); letter-spacing: 1px; text-transform: uppercase; margin-bottom: 4px; }
    .hud-item-value { font-size: 15px; color: var(--text-light); font-weight: 600; }
    .btn-hud { display: inline-block; width: 100%; text-align: center; padding: 14px; background: var(--text-light); color: var(--bg-deep); font-weight: 800; border-radius: 4px; text-decoration: none; transition: background 0.2s; text-transform: uppercase; font-size: 12px; letter-spacing: 1px; cursor: pointer; border: none; font-family: var(--font-ui); }
    .btn-hud:hover { background: var(--accent-cyan); color: var(--bg-deep); }
    
    /* RIGHT COLUMN: Markdown Content Styling */
    .report-content h3 { font-size: 32px; font-weight: 700; color: var(--text-light); margin: 0 0 24px 0; letter-spacing: -0.5px; }
    .report-content p { color: var(--text-muted); font-size: 16px; line-height: 1.7; margin-bottom: 24px; }
    .report-content ul { margin-left: 20px; margin-bottom: 32px; color: var(--text-muted); font-size: 16px; line-height: 1.7; }
    .report-content li { margin-bottom: 8px; }

    /* NARRATIVE AUTOMATION STYLES */
    .narrative-flow { display: flex; flex-direction: column; gap: 40px; }
    .narrative-phase { display: flex; flex-direction: column; }
    .phase-header { margin-bottom: 24px; }
    .phase-overline { font-family: var(--font-data); font-size: 12px; color: var(--accent-cyan); letter-spacing: 2px; text-transform: uppercase; margin-bottom: 12px; display: block; }
    .phase-heading { font-size: 32px; font-weight: 800; color: var(--text-light); margin: 0; letter-spacing: -0.5px; }
    .phase-text { font-size: 16px; color: var(--text-muted); line-height: 1.8; margin-bottom: 24px; }
    .phase-hook { font-size: 18px; color: var(--text-muted); line-height: 1.8; font-weight: 500; margin: 0; }
    .subsystem-matrix { display: flex; flex-direction: column; border-top: 1px solid var(--border-dark); border-bottom: 1px solid var(--border-dark); margin-top: 24px; margin-bottom: 32px; }
    .matrix-row { display: grid; grid-template-columns: 200px 1fr; border-bottom: 1px solid var(--border-dark); transition: background 0.2s; }
    .matrix-row:last-child { border-bottom: none; }
    .matrix-row:hover { background: rgba(255, 255, 255, 0.02); }
    .matrix-left { padding: 16px 16px 16px 0; font-family: var(--font-ui), sans-serif; font-size: 12px; font-weight: 700; color: var(--text-light); text-transform: uppercase; letter-spacing: 1px; border-right: 1px solid var(--border-dark); }
    .matrix-right { padding: 16px; color: var(--text-muted); font-size: 15px; line-height: 1.6; }
</style>

<main>
    <!-- Fetch the CMS Data specifically for Spring 2027 -->
    {% set drive = null %}
    {% for item in collections.drives %}
        {% if item.fileSlug == 'spring-2027' %}
            {% set drive = item.data %}
        {% endif %}
    {% endfor %}

    <!-- Cinematic Phase Header -->
    <section style="height: 40vh; background: linear-gradient(to top, var(--bg-deep) 10%, rgba(11,17,33,0.7)), url('{{ drive.image }}') center/cover; position: relative; display: flex; align-items: flex-end; padding-bottom: 40px; border-bottom: 1px solid var(--border-dark);">
        <div class="container" style="width: 100%;">
            <a href="/join_us/spring-2027/" style="font-family: var(--font-data); color: var(--text-muted); font-size: 13px; letter-spacing: 1px; text-transform: uppercase; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; margin-bottom: 24px; transition: color 0.2s;">← Back to Dashboard</a>
            <span style="margin-bottom: 12px; font-family: var(--font-data); font-size: 13px; color: var(--accent-cyan); letter-spacing: 1px; text-transform: uppercase; display: block;">PHASE 01 // {{ drive.phase1.status | default('OVERVIEW') | upper }}</span>
            <h1 style="font-size: 48px; font-weight: 800; color: var(--text-light); letter-spacing: -1px; margin: 0; line-height: 1.1;">Initial Applications</h1>
        </div>
    </section>

    <div class="report-container">
        <!-- 2-Column Split -->
        <div class="report-grid">
            
            <!-- LEFT COLUMN: Premium Sticky HUD -->
            <aside class="hud-anchor">
                <div class="hud-metric">PHASE 01</div>
                
                {% if drive.phase1.metrics %}
                <div class="hud-grid" style="margin-top: 24px;">
                    {% for metric in drive.phase1.metrics %}
                    <div class="hud-item"><span class="hud-item-label">{{ metric.label }}</span><span class="hud-item-value" {% if metric.value == 'Open' or metric.value == 'OPEN' or metric.value == 'COMPLETED' %}style="color: #10B981;"{% endif %}>{{ metric.value }}</span></div>
                    {% endfor %}
                </div>
                {% endif %}

                {% if drive.phase1.action_tracker %}
                    <div style="border-top: 1px solid var(--border-dark); margin-top: 8px; padding-top: 24px;">
                        <!-- STATE 1: Enter Name -->
                        <div id="auth-gate">
                            <span style="font-family: var(--font-data); font-size: 11px; color: var(--text-muted); letter-spacing: 1px; text-transform: uppercase; margin-bottom: 12px; display: block;">APPLICATION TRACKER</span>
                            <input type="text" id="applicant-name" style="width: 100%; padding: 12px; background: var(--bg-deep); border: 1px solid var(--border-dark); color: var(--text-light); font-family: var(--font-ui); font-size: 14px; border-radius: 4px; margin-bottom: 16px; outline: none; transition: border-color 0.2s;" placeholder="Full Legal Name">
                            <button onclick="registerApplicant()" class="btn-hud">Initialize Session</button>
                        </div>

                        <!-- STATE 2: Tracking Active (Waiting on CSV) -->
                        <div id="auth-success" style="display: none;">
                            <span style="font-family: var(--font-data); font-size: 11px; color: var(--accent-cyan); letter-spacing: 1px; text-transform: uppercase; margin-bottom: 8px; display: block;">SESSION ACTIVE</span>
                            <p style="color: var(--text-light); font-size: 16px; font-weight: 700; margin-bottom: 16px;" id="display-name"></p>
                            <a href="{{ drive.phase1.form_link | default('#') }}" target="_blank" rel="noopener noreferrer" class="btn-hud">Open Form ↗</a>
                        </div>

                        <!-- STATE 3: Verified in CSV -->
                        <div id="auth-verified" style="display: none;">
                            <span style="font-family: var(--font-data); font-size: 11px; color: #10B981; letter-spacing: 1px; text-transform: uppercase; margin-bottom: 8px; display: block;">VERIFIED DOSSIER</span>
                            <p style="color: var(--text-light); font-size: 16px; font-weight: 700; margin-bottom: 16px;" id="verified-name"></p>
                            <a href="{{ drive.phase1.form_link | default('#') }}" target="_blank" rel="noopener noreferrer" class="btn-hud" style="background: transparent; border: 1px solid var(--border-dark); color: var(--text-light);">Edit Submission ↗</a>
                        </div>
                    </div>
                {% else %}
                    <!-- CLOSED STATE -->
                    <div class="btn-hud" style="background: rgba(255,255,255,0.05); color: var(--text-muted); cursor: not-allowed; margin-top: 16px;">Portal Closed</div>
                {% endif %}
            </aside>

            <!-- RIGHT COLUMN: Narrative Engine -->
            <article class="narrative-flow">
                {% set mode = drive.phase1.report_mode | default('Automation') %}
                {% if mode == 'Automation' and drive.phase1.automation_payload %}
                    {% set rawPayload = drive.phase1.automation_payload.code if drive.phase1.automation_payload.code else drive.phase1.automation_payload %}
                    {% set p = rawPayload | parseJSON %}
                    
                    <div class="narrative-phase">
                        <div class="phase-header">
                            <span class="phase-overline">{{ p.overline | default('PHASE 01 // OVERVIEW') }}</span>
                            <h3 class="phase-heading">{{ p.heading | default('Logistical Briefing') }}</h3>
                        </div>
                        <p class="phase-hook">{{ p.hook }}</p>
                        {% if p.text %}<p class="phase-text">{{ p.text }}</p>{% endif %}
                    </div>
                    
                    {% if p.matrix %}
                    <div class="subsystem-matrix">
                        {% for row in p.matrix %}
                        <div class="matrix-row">
                            <div class="matrix-left">{{ row.label }}</div>
                            <div class="matrix-right">{{ row.value }}</div>
                        </div>
                        {% endfor %}
                    </div>
                    {% endif %}
                {% else %}
                    <!-- LEGACY MANUAL FALLBACK -->
                    <div class="report-content" style="white-space: pre-wrap;">
                        <h3>Engineering Summary</h3>
                        {{ drive.phase1.report | default("Report data will appear here once published in CMS.") }}
                    </div>
                {% endif %}
            </article>

        </div>
    </div>
</main>


<script>
    // 1. We dump the names from Eleventy's CSV into a JavaScript array
    const verifiedApplicants = [
        {% for applicant in csvData %}
        "{{ applicant['Full Name'] | trim | lower }}"{% if not loop.last %},{% endif %}
        {% endfor %}
    ];

    function checkStatus() {
        const savedName = localStorage.getItem('aeroclub_sp27_applicant');
        
        if (savedName) {
            const normalizedName = savedName.trim().toLowerCase();
            
            // 2. Check if the name in localStorage matches any name in the CSV
            if (verifiedApplicants.includes(normalizedName)) {
                // STATE 3: Verified in Database!
                document.getElementById('auth-gate').style.display = 'none';
                document.getElementById('auth-success').style.display = 'none';
                document.getElementById('auth-verified').style.display = 'block';
                document.getElementById('verified-name').innerText = savedName;
            } else {
                // STATE 2: Local tracking on, but not synced to CSV yet
                document.getElementById('auth-gate').style.display = 'none';
                document.getElementById('auth-verified').style.display = 'none';
                document.getElementById('auth-success').style.display = 'block';
                document.getElementById('display-name').innerText = savedName;
            }
        } else {
            // STATE 1: Enter Name
            document.getElementById('auth-gate').style.display = 'block';
            document.getElementById('auth-success').style.display = 'none';
            document.getElementById('auth-verified').style.display = 'none';
        }
    }

    function registerApplicant() {
        const nameInput = document.getElementById('applicant-name').value;
        if (nameInput.trim().length > 2) { 
            localStorage.setItem('aeroclub_sp27_applicant', nameInput.trim()); 
            checkStatus(); 
        } else { 
            alert("Please enter your name to proceed."); 
        }
    }

    document.addEventListener("DOMContentLoaded", checkStatus);
</script>
