---
layout: base.njk
title: "AeroClub | Phase 01: Application"
---
<style>
    /* Widened container for the 2-column layout */
    .report-container { max-width: 1200px; margin: 0 auto; padding: 80px 20px 140px; }
    .report-meta { font-family: var(--font-data); font-size: 13px; color: var(--accent-cyan); letter-spacing: 1px; text-transform: uppercase; margin-bottom: 16px; display: block; }
    .report-title { font-size: 48px; font-weight: 800; color: var(--text-light); letter-spacing: -1px; margin-bottom: 40px; line-height: 1.1; }
    
    /* 2-Column Grid matching the "Hardware Data" layout */
    .report-grid {
        display: grid;
        grid-template-columns: 350px 1fr;
        gap: clamp(40px, 6vw, 80px);
        align-items: start;
    }
    @media (max-width: 900px) {
        .report-grid { grid-template-columns: 1fr; }
    }

    /* LEFT COLUMN: Sidebar Styling */
    .data-box {
        background: var(--bg-panel-dark);
        border: 1px solid var(--border-dark);
        border-radius: 4px;
        padding: 32px;
        margin-bottom: 24px;
    }
    .data-row {
        display: flex;
        justify-content: space-between;
        padding: 12px 0;
        border-bottom: 1px solid rgba(255,255,255,0.05);
        font-size: 14px;
    }
    .data-row:last-child { border-bottom: none; }
    .data-label { color: var(--text-muted); font-family: var(--font-data); }
    .data-value { color: var(--text-light); font-weight: 500; text-align: right; }

    .setup-box {
        background: var(--bg-panel-dark);
        border: 1px solid var(--border-dark);
        border-radius: 4px;
        padding: 32px;
        margin-bottom: 24px;
    }
    .input-field {
        width: 100%; padding: 12px 16px; background: var(--bg-deep);
        border: 1px solid var(--border-dark); color: var(--text-light);
        font-family: var(--font-ui); font-size: 15px; border-radius: 4px;
        margin-bottom: 16px; outline: none; transition: border-color 0.2s;
    }
    .input-field:focus { border-color: var(--accent-cyan); }
    
    /* RIGHT COLUMN: Markdown Content Styling */
    .report-content h3 { font-size: 32px; font-weight: 700; color: var(--text-light); margin: 0 0 24px 0; letter-spacing: -0.5px; }
    .report-content p { color: var(--text-muted); font-size: 16px; line-height: 1.7; margin-bottom: 24px; }
    .report-content ul { margin-left: 20px; margin-bottom: 32px; color: var(--text-muted); font-size: 16px; line-height: 1.7; }
    .report-content li { margin-bottom: 8px; }

    /* NARRATIVE AUTOMATION STYLES */
    .narrative-flow { display: flex; flex-direction: column; gap: 40px; }
    .narrative-phase { display: flex; flex-direction: column; }
    .phase-header { margin-bottom: 24px; }
    .phase-overline { font-family: var(--font-data); font-size: 12px; color: var(--accent-cyan); letter-spacing: 2px; text-transform: uppercase; margin-bottom: 12px; display: block; }
    .phase-heading { font-size: 32px; font-weight: 800; color: var(--text-light); margin: 0; letter-spacing: -0.5px; }
    .phase-text { font-size: 16px; color: var(--text-muted); line-height: 1.8; margin-bottom: 24px; }
    .phase-hook { font-size: 18px; color: var(--text-muted); line-height: 1.8; font-weight: 500; margin: 0; }
    .subsystem-matrix { display: flex; flex-direction: column; border-top: 1px solid var(--border-dark); border-bottom: 1px solid var(--border-dark); margin-top: 24px; margin-bottom: 32px; }
    .matrix-row { display: grid; grid-template-columns: 200px 1fr; border-bottom: 1px solid var(--border-dark); transition: background 0.2s; }
    .matrix-row:last-child { border-bottom: none; }
    .matrix-row:hover { background: rgba(255, 255, 255, 0.02); }
    .matrix-left { padding: 16px 16px 16px 0; font-family: var(--font-ui), sans-serif; font-size: 12px; font-weight: 700; color: var(--text-light); text-transform: uppercase; letter-spacing: 1px; border-right: 1px solid var(--border-dark); }
    .matrix-right { padding: 16px; color: var(--text-muted); font-size: 15px; line-height: 1.6; }
</style>

<main>
    <!-- Fetch the CMS Data specifically for Spring 2027 -->
    {% set drive = null %}
    {% for item in collections.drives %}
        {% if item.fileSlug == 'spring-2027' %}
            {% set drive = item.data %}
        {% endif %}
    {% endfor %}

    <div class="report-container">
        <!-- Header (Full Width) -->
        <a href="/join_us/spring-2027/" style="font-family: var(--font-data); color: var(--text-muted); font-size: 13px; letter-spacing: 1px; text-transform: uppercase; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; margin-bottom: 40px; transition: color 0.2s;">← Back to Dashboard</a>
        <span class="report-meta">PHASE 01 // {{ drive.phase1.status | default('OVERVIEW') | upper }}</span>
        <h1 class="report-title">Initial Applications</h1>

        <!-- 2-Column Split -->
        <div class="report-grid">
            
            <!-- LEFT COLUMN: Logistics & Tracker -->
            <aside>
                <span style="font-family: var(--font-data); font-size: 11px; color: var(--text-muted); letter-spacing: 1.5px; text-transform: uppercase; margin-bottom: 12px; display: block;">PHASE DATA</span>
                
                <div class="data-box">
                    <span style="font-family: var(--font-data); font-size: 10px; color: var(--accent-cyan); letter-spacing: 1px; text-transform: uppercase; margin-bottom: 12px; display: block;">LOGISTICS</span>
                    <div class="data-row">
                        <span class="data-label">Deadline</span>
                        <span class="data-value">{{ drive.phase1.deadline | default("TBA") }}</span>
                    </div>
                    <div class="data-row">
                        <span class="data-label">Status</span>
                        <span class="data-value" {% if drive.phase1.status == 'Open' %}style="color: #10B981;"{% endif %}>{{ drive.phase1.status | default("Pending") }}</span>
                    </div>
                </div>

                {% if drive.phase1.status == 'Open' %}
                    <!-- STATE 1: Enter Name -->
                    <div id="auth-gate" class="setup-box">
                        <span style="font-family: var(--font-data); font-size: 10px; color: var(--accent-cyan); letter-spacing: 1px; text-transform: uppercase; margin-bottom: 12px; display: block;">APPLICATION TRACKER</span>
                        <p style="color: var(--text-muted); font-size: 14px; margin-bottom: 20px; line-height: 1.6;">Enter your exact name used in the Google Form to sync your local dossier.</p>
                        <input type="text" id="applicant-name" class="input-field" placeholder="Full Legal Name">
                        <button onclick="registerApplicant()" class="btn-join" style="width: 100%; border: none; cursor: pointer;">Initialize Session</button>
                    </div>

                    <!-- STATE 2: Tracking Active (Waiting on CSV) -->
                    <div id="auth-success" class="setup-box" style="display: none; border-top: 4px solid var(--border-dark);">
                        <span style="font-family: var(--font-data); font-size: 10px; color: var(--accent-cyan); letter-spacing: 1px; text-transform: uppercase; margin-bottom: 12px; display: block;">SESSION ACTIVE</span>
                        <p style="color: var(--text-light); font-size: 16px; font-weight: 500; margin-bottom: 8px;" id="display-name"></p>
                        <p style="color: var(--text-muted); font-size: 14px; margin-bottom: 24px; line-height: 1.6;">Proceed to the official portal to complete your submission.</p>
                        <a href="{{ drive.phase1.form_link | default('#') }}" target="_blank" rel="noopener noreferrer" class="btn-join" style="display: block; text-align: center; background: var(--text-light); color: var(--bg-deep); text-decoration: none;">Open Form ↗</a>
                    </div>

                    <!-- STATE 3: Verified in CSV -->
                    <div id="auth-verified" class="setup-box" style="display: none; border-top: 4px solid #10B981; background: rgba(16, 185, 129, 0.05);">
                        <span style="font-family: var(--font-data); font-size: 10px; color: #10B981; letter-spacing: 1px; text-transform: uppercase; margin-bottom: 12px; display: block;">VERIFIED DOSSIER</span>
                        <p style="color: var(--text-light); font-size: 16px; font-weight: 500; margin-bottom: 8px;" id="verified-name"></p>
                        <p style="color: var(--text-muted); font-size: 14px; margin-bottom: 24px; line-height: 1.6;">Application successfully synced with the command database.</p>
                        <a href="{{ drive.phase1.form_link | default('#') }}" target="_blank" rel="noopener noreferrer" class="btn-join" style="display: block; text-align: center; background: transparent; border: 1px solid var(--border-dark); color: var(--text-light); text-decoration: none;">Edit Submission ↗</a>
                    </div>
                {% else %}
                    <!-- CLOSED STATE -->
                    <div class="setup-box" style="border-left: 4px solid var(--border-dark); opacity: 0.6;">
                        <span style="font-family: var(--font-data); font-size: 10px; color: var(--text-muted); letter-spacing: 1px; text-transform: uppercase; margin-bottom: 12px; display: block;">PORTAL CLOSED</span>
                        <p style="color: var(--text-muted); font-size: 14px; margin-bottom: 0; line-height: 1.6;">The application portal is not currently accepting submissions.</p>
                    </div>
                {% endif %}
            </aside>

            <!-- RIGHT COLUMN: Narrative Engine -->
            <article class="narrative-flow">
                {% set mode = drive.phase1.report_mode | default('Automation') %}
                {% if mode == 'Automation' and drive.phase1.automation_payload %}
                    {% set rawPayload = drive.phase1.automation_payload.code if drive.phase1.automation_payload.code else drive.phase1.automation_payload %}
                    {% set p = rawPayload | parseJSON %}
                    
                    <div class="narrative-phase">
                        <div class="phase-header">
                            <span class="phase-overline">{{ p.overline | default('PHASE 01 // OVERVIEW') }}</span>
                            <h3 class="phase-heading">{{ p.heading | default('Logistical Briefing') }}</h3>
                        </div>
                        <p class="phase-hook">{{ p.hook }}</p>
                        {% if p.text %}<p class="phase-text">{{ p.text }}</p>{% endif %}
                    </div>
                    
                    {% if p.matrix %}
                    <div class="subsystem-matrix">
                        {% for row in p.matrix %}
                        <div class="matrix-row">
                            <div class="matrix-left">{{ row.label }}</div>
                            <div class="matrix-right">{{ row.value }}</div>
                        </div>
                        {% endfor %}
                    </div>
                    {% endif %}
                {% else %}
                    <!-- LEGACY MANUAL FALLBACK -->
                    <div class="report-content" style="white-space: pre-wrap;">
                        <h3>Engineering Summary</h3>
                        {{ drive.phase1.report | default("Report data will appear here once published in CMS.") }}
                    </div>
                {% endif %}
            </article>

        </div>
    </div>
</main>


<script>
    // 1. We dump the names from Eleventy's CSV into a JavaScript array
    const verifiedApplicants = [
        {% for applicant in csvData %}
        "{{ applicant['Full Name'] | trim | lower }}"{% if not loop.last %},{% endif %}
        {% endfor %}
    ];

    function checkStatus() {
        const savedName = localStorage.getItem('aeroclub_sp27_applicant');
        
        if (savedName) {
            const normalizedName = savedName.trim().toLowerCase();
            
            // 2. Check if the name in localStorage matches any name in the CSV
            if (verifiedApplicants.includes(normalizedName)) {
                // STATE 3: Verified in Database!
                document.getElementById('auth-gate').style.display = 'none';
                document.getElementById('auth-success').style.display = 'none';
                document.getElementById('auth-verified').style.display = 'block';
                document.getElementById('verified-name').innerText = savedName;
            } else {
                // STATE 2: Local tracking on, but not synced to CSV yet
                document.getElementById('auth-gate').style.display = 'none';
                document.getElementById('auth-verified').style.display = 'none';
                document.getElementById('auth-success').style.display = 'block';
                document.getElementById('display-name').innerText = savedName;
            }
        } else {
            // STATE 1: Enter Name
            document.getElementById('auth-gate').style.display = 'block';
            document.getElementById('auth-success').style.display = 'none';
            document.getElementById('auth-verified').style.display = 'none';
        }
    }

    function registerApplicant() {
        const nameInput = document.getElementById('applicant-name').value;
        if (nameInput.trim().length > 2) { 
            localStorage.setItem('aeroclub_sp27_applicant', nameInput.trim()); 
            checkStatus(); 
        } else { 
            alert("Please enter your name to proceed."); 
        }
    }

    document.addEventListener("DOMContentLoaded", checkStatus);
</script>
