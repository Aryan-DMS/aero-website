---
layout: base.njk
title: "AeroClub | Spring 2027 Command Dashboard"
---
<style>
    /* ==========================================
       CLEAN NATIVE UI - COMMAND DASHBOARD
    ========================================== */
    .dashboard-grid { 
        display: grid; 
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); 
        gap: 32px; 
    }
    
    .mission-card {
        background: var(--bg-deep);
        border: 1px solid var(--border-dark);
        border-radius: 4px;
        display: flex;
        flex-direction: column;
        text-decoration: none;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
    
    .mission-card:hover {
        border-color: var(--text-muted);
        transform: translateY(-4px);
    }

    /* Lock down pending cards smoothly */
    .mission-card.status-pending {
        opacity: 0.5;
        pointer-events: none;
        cursor: not-allowed;
    }

    .card-content {
        padding: 40px;
        display: flex;
        flex-direction: column;
        flex-grow: 1;
    }

    .card-meta {
        font-family: var(--font-data);
        font-size: 13px;
        color: var(--accent-cyan);
        letter-spacing: 1px;
        text-transform: uppercase;
        margin-bottom: 16px;
        display: block;
    }

    .card-title {
        font-size: 24px;
        font-weight: 700;
        color: var(--text-light);
        margin-bottom: 16px;
        letter-spacing: -0.5px;
    }

    .card-desc {
        color: var(--text-muted);
        font-size: 16px;
        line-height: 1.6;
        margin-bottom: 32px;
        flex-grow: 1;
    }

    .card-footer {
        border-top: 1px solid var(--border-dark);
        padding-top: 24px;
        margin-top: auto;
    }

    .card-cta {
        font-family: var(--font-data);
        font-size: 13px;
        font-weight: 700;
        color: var(--text-light);
        letter-spacing: 1px;
        text-transform: uppercase;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .card-cta span {
        color: var(--accent-cyan);
        transition: transform 0.2s;
    }

    .mission-card:hover .card-cta span {
        transform: translateX(6px);
    }
</style>

<main id="command-dashboard">
    <!-- Fetch the CMS Data specifically for Spring 2027 -->
    {% set drive = null %}
    {% for item in collections.drives %}
        {% if item.fileSlug == 'spring-2027' %}
            {% set drive = item.data %}
        {% endif %}
    {% endfor %}

    <!-- Clean Header mirroring the "Our Team" aesthetic -->
    <section style="padding: clamp(60px, 8vw, 100px) 0 clamp(40px, 5vw, 60px); border-bottom: 1px solid var(--border-dark);">
        <div class="container">
            <a href="/join_us/" style="font-family: var(--font-data); color: var(--text-muted); font-size: 13px; letter-spacing: 1px; text-transform: uppercase; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; margin-bottom: 40px; transition: color 0.2s;">← Back to Archives</a>
            
            <span style="font-family: var(--font-data); font-size: 13px; color: var(--accent-cyan); letter-spacing: 1px; text-transform: uppercase; margin-bottom: 16px; display: block;">
                RECRUITMENT CYCLE
            </span>
            
            <h1 style="font-size: clamp(40px, 8vw, 56px); font-weight: 800; color: var(--text-light); letter-spacing: -1px; margin-bottom: 24px; line-height: 1.1;">
                {{ drive.title | default("Spring 2027 Induction") }}
            </h1>
            
            <!-- Roles organically integrated into the description -->
            <p style="color: var(--text-muted); font-size: 18px; line-height: 1.6; max-width: 800px;">
                Currently recruiting for: {{ drive.roles | default("Aerodynamics, Embedded Systems, Payload Integration, and Web Design") }}. Track phase progressions and access required materials below.
            </p>
        </div>
    </section>

    <!-- Clean Card Grid mirroring the Archive aesthetic -->
    <section style="padding: clamp(60px, 8vw, 100px) 0;">
        <div class="container">
            <div class="dashboard-grid">
                
                <!-- PHASE 01 -->
                <a href="/join_us/spring-2027/application/" class="mission-card status-{{ (drive.phase1.status | default('Open')) | lower }}">
                    <div class="card-content">
                        <span class="card-meta">PHASE 01 // {{ drive.phase1.status | default('Open') }}</span>
                        <h3 class="card-title">Initial Applications</h3>
                        <p class="card-desc">Role breakdowns, technical expectations, and the primary application portal.</p>
                        <div class="card-footer">
                            <span class="card-cta">ACCESS PORTAL <span>→</span></span>
                        </div>
                    </div>
                </a>

                <!-- PHASE 02 -->
                <a href="/join_us/spring-2027/test/" class="mission-card status-{{ (drive.phase2.status | default('Pending')) | lower }}">
                    <div class="card-content">
                        <span class="card-meta">PHASE 02 // {{ drive.phase2.status | default('Pending') }}</span>
                        <h3 class="card-title">Technical Test</h3>
                        <p class="card-desc">Syllabus breakdown, evaluation metrics, and logistical details for the written examination.</p>
                        <div class="card-footer">
                            <span class="card-cta">READ REPORT <span>→</span></span>
                        </div>
                    </div>
                </a>

                <!-- PHASE 03 -->
                <a href="/join_us/spring-2027/shortlist/" class="mission-card status-{{ (drive.phase3.status | default('Pending')) | lower }}">
                    <div class="card-content">
                        <span class="card-meta">PHASE 03 // {{ drive.phase3.status | default('Pending') }}</span>
                        <h3 class="card-title">Test Shortlist</h3>
                        <p class="card-desc">Official roster of candidates advancing to the technical interview rounds.</p>
                        <div class="card-footer">
                            <span class="card-cta">VIEW DATA <span>→</span></span>
                        </div>
                    </div>
                </a>

                <!-- PHASE 04 -->
                <a href="/join_us/spring-2027/interview/" class="mission-card status-{{ (drive.phase4.status | default('Pending')) | lower }}">
                    <div class="card-content">
                        <span class="card-meta">PHASE 04 // {{ drive.phase4.status | default('Pending') }}</span>
                        <h3 class="card-title">Interviews</h3>
                        <p class="card-desc">Panel schedules, time-slots, and preparation guidelines for shortlisted applicants.</p>
                        <div class="card-footer">
                            <span class="card-cta">VIEW LOGISTICS <span>→</span></span>
                        </div>
                    </div>
                </a>

                <!-- PHASE 05 -->
                <a href="/join_us/spring-2027/results/" class="mission-card status-{{ (drive.phase5.status | default('Pending')) | lower }}">
                    <div class="card-content">
                        <span class="card-meta">PHASE 05 // {{ drive.phase5.status | default('Pending') }}</span>
                        <h3 class="card-title">Final Results</h3>
                        <p class="card-desc">The finalized list of inducted members for the Spring 2027 competition cycle.</p>
                        <div class="card-footer">
                            <span class="card-cta">VIEW ROSTER <span>→</span></span>
                        </div>
                    </div>
                </a>

            </div>
        </div>
    </section>
</main>
