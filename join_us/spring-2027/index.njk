---
layout: base.njk
title: "AeroClub | Spring 2027 Command Dashboard"
---
<style>
    /* ==========================================
       COMMAND DASHBOARD (LEVEL 2) STYLES
    ========================================== */
    .dashboard-grid {
        display: grid;
        /* Creates a fluid grid that handles 5 cards beautifully */
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
        gap: clamp(24px, 4vw, 40px);
    }

    /* Vertical Phase Report Cards */
    .phase-card {
        background: var(--bg-deep);
        border: 1px solid var(--border-dark);
        border-top: 4px solid var(--border-dark);
        padding: 40px;
        display: flex;
        flex-direction: column;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        border-radius: 4px;
        text-decoration: none;
        position: relative;
        overflow: hidden;
    }

    .phase-card:hover {
        border-color: var(--text-light);
        transform: translateY(-4px);
        box-shadow: 0 12px 24px rgba(0,0,0,0.2);
    }

    /* Massive background numbers for aesthetic */
    .phase-number {
        position: absolute;
        top: -20px;
        right: -10px;
        font-size: 140px;
        font-weight: 900;
        line-height: 1;
        color: transparent;
        -webkit-text-stroke: 1px rgba(255,255,255,0.05);
        z-index: 0;
        pointer-events: none;
        transition: all 0.3s ease;
    }
    
    .phase-card:hover .phase-number {
        -webkit-text-stroke: 1px rgba(14, 165, 233, 0.15);
        transform: translateX(-10px);
    }

    /* Status-specific styling */
    .phase-card.status-open { border-top-color: var(--accent-cyan); }
    .phase-card.status-completed { border-top-color: #10B981; }
    .phase-card.status-pending { border-top-color: var(--border-dark); opacity: 0.6; }
    
    /* Pending cards don't get the hover lift, they feel "locked" */
    .phase-card.status-pending:hover {
        border-color: var(--border-dark);
        transform: none;
        box-shadow: none;
        cursor: not-allowed;
    }

    /* Card Content */
    .phase-content {
        position: relative;
        z-index: 1;
        flex: 1;
        display: flex;
        flex-direction: column;
    }

    .phase-meta {
        font-family: var(--font-data);
        font-size: 12px;
        margin-bottom: 24px;
        display: inline-block;
        letter-spacing: 1px;
        text-transform: uppercase;
        padding: 4px 10px;
        border-radius: 4px;
        width: fit-content;
    }
    
    .status-open .phase-meta { background: rgba(14, 165, 233, 0.1); color: var(--accent-cyan); border: 1px solid rgba(14, 165, 233, 0.2); }
    .status-completed .phase-meta { background: rgba(16, 185, 129, 0.1); color: #10B981; border: 1px solid rgba(16, 185, 129, 0.2); }
    .status-pending .phase-meta { background: var(--bg-panel-dark); color: var(--text-muted); border: 1px solid var(--border-dark); }

    .phase-card h4 {
        font-size: 24px;
        font-weight: 800;
        margin-bottom: 16px;
        color: var(--text-light);
        letter-spacing: -0.5px;
    }

    .phase-card p {
        font-size: 15px;
        color: var(--text-muted);
        line-height: 1.6;
        margin-bottom: 32px;
        flex: 1;
    }

    .view-report {
        font-size: 13px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        display: flex;
        align-items: center;
        gap: 8px;
        border-top: 1px solid var(--border-dark);
        padding-top: 24px;
        margin-top: auto;
        transition: color 0.2s;
    }

    .status-open .view-report { color: var(--accent-cyan); }
    .status-completed .view-report { color: var(--text-light); }
    .status-pending .view-report { color: var(--text-muted); display: none; } /* Hide link for pending */

    .view-report::after {
        content: '→';
        transition: transform 0.2s;
    }

    .phase-card:not(.status-pending):hover .view-report::after {
        transform: translateX(6px);
    }
</style>

<main id="command-dashboard">
    
    <!-- Executive Summary Header -->
    <section style="padding: clamp(60px, 8vw, 100px) 0 clamp(40px, 5vw, 60px); border-bottom: 1px solid var(--border-dark);">
        <div class="container">
            <a href="/join_us/" style="font-family: var(--font-data); color: var(--text-muted); font-size: 13px; letter-spacing: 1px; text-transform: uppercase; text-decoration: none; display: flex; align-items: center; gap: 8px; margin-bottom: 32px; transition: color 0.2s;">
                ← Back to Archives
            </a>
            
            <h4 style="font-family: var(--font-data); color: #10B981; font-size: 14px; margin-bottom: 12px; letter-spacing: 1px; text-transform: uppercase; display: flex; align-items: center; gap: 8px;">
                <span style="width: 8px; height: 8px; background: #10B981; border-radius: 50%; display: inline-block; box-shadow: 0 0 12px #10B981;"></span>
                STATUS: LIVE DATASTREAM
            </h4>
            
            <h2 style="font-size: clamp(40px, 8vw, 56px); font-weight: 800; margin-bottom: 24px; color: var(--text-light); letter-spacing: -1px; line-height: 1.1;">Spring 2027 Dashboard</h2>
            
            <div style="background: var(--bg-panel-dark); border: 1px solid var(--border-dark); padding: 24px; border-radius: 4px; max-width: 800px;">
                <h4 style="font-family: var(--font-data); font-size: 12px; color: var(--text-muted); letter-spacing: 1px; margin-bottom: 12px;">ACTIVE RECRUITMENT ROLES</h4>
                <p style="color: var(--text-light); font-size: 16px; line-height: 1.6; font-weight: 500;">
                    Aerodynamics <span style="color: var(--border-dark);">//</span> 
                    Embedded Systems <span style="color: var(--border-dark);">//</span> 
                    Payload Integration <span style="color: var(--border-dark);">//</span> 
                    Web Design
                </p>
            </div>
        </div>
    </section>

    <!-- The 5-Phase Grid -->
    <section style="padding: clamp(60px, 8vw, 100px) 0;">
        <div class="container">
            <div class="dashboard-grid">
                
                <!-- PHASE 1: APPLICATION -->
                <!-- Note: The link goes to Level 3 -->
                <a href="/join_us/spring-2027/application/" class="phase-card status-open">
                    <span class="phase-number">01</span>
                    <div class="phase-content">
                        <span class="phase-meta">STATUS // OPEN</span>
                        <h4>Initial Applications</h4>
                        <p>Submit your technical background dossier and role preferences. Contains official syllabus requirements and the Google Form portal.</p>
                        <span class="view-report">Access Application Portal</span>
                    </div>
                </a>

                <!-- PHASE 2: TEST -->
                <!-- Disabled/Pending link -->
                <a href="#" class="phase-card status-pending" onclick="event.preventDefault();">
                    <span class="phase-number">02</span>
                    <div class="phase-content">
                        <span class="phase-meta">STATUS // PENDING</span>
                        <h4>Aptitude & Tech Test</h4>
                        <p>Written examination covering core physics, logical reasoning, and domain-specific knowledge. Schedule and venue pending Phase 01 completion.</p>
                        <span class="view-report">View Test Report</span>
                    </div>
                </a>

                <!-- PHASE 3: SHORTLIST -->
                <a href="#" class="phase-card status-pending" onclick="event.preventDefault();">
                    <span class="phase-number">03</span>
                    <div class="phase-content">
                        <span class="phase-meta">STATUS // PENDING</span>
                        <h4>Test Shortlist</h4>
                        <p>Declassified data table of all candidates who successfully cleared the technical evaluation barrier.</p>
                        <span class="view-report">View Shortlist Data</span>
                    </div>
                </a>

                <!-- PHASE 4: INTERVIEW -->
                <a href="#" class="phase-card status-pending" onclick="event.preventDefault();">
                    <span class="phase-number">04</span>
                    <div class="phase-content">
                        <span class="phase-meta">STATUS // PENDING</span>
                        <h4>Panel Interviews</h4>
                        <p>Logistical information, panel details, and exact time-slots for shortlisted candidates.</p>
                        <span class="view-report">View Interview Schedule</span>
                    </div>
                </a>

                <!-- PHASE 5: RESULTS -->
                <a href="#" class="phase-card status-pending" onclick="event.preventDefault();">
                    <span class="phase-number">05</span>
                    <div class="phase-content">
                        <span class="phase-meta">STATUS // PENDING</span>
                        <h4>Final Results</h4>
                        <p>The official, finalized roster of newly inducted members into the engineering division.</p>
                        <span class="view-report">View Final Roster</span>
                    </div>
                </a>

            </div>
        </div>
    </section>
</main>
