---
layout: base.njk
title: "AeroClub | Spring 2027 Command Dashboard"
---
<style>
    /* ==========================================
       CLEAN NATIVE UI - COMMAND DASHBOARD
    ========================================== */
    .dashboard-grid { 
        display: grid; 
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); 
        gap: 32px; 
    }
    
    .mission-card {
        background: var(--bg-deep);
        border: 1px solid var(--border-dark);
        border-radius: 4px;
        display: flex;
        flex-direction: column;
        text-decoration: none;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
    
    .mission-card:hover {
        border-color: var(--text-muted);
        transform: translateY(-4px);
    }

    /* Lock down pending cards smoothly */
    .mission-card.status-pending {
        opacity: 0.5;
        pointer-events: none;
        cursor: not-allowed;
    }

    .card-content {
        padding: 40px;
        display: flex;
        flex-direction: column;
        flex-grow: 1;
    }

    .card-meta {
        font-family: var(--font-data);
        font-size: 13px;
        color: var(--accent-cyan);
        letter-spacing: 1px;
        text-transform: uppercase;
        margin-bottom: 16px;
        display: block;
    }

    .card-title {
        font-size: 24px;
        font-weight: 700;
        color: var(--text-light);
        margin-bottom: 16px;
        letter-spacing: -0.5px;
    }

    .card-desc {
        color: var(--text-muted);
        font-size: 16px;
        line-height: 1.6;
        margin-bottom: 32px;
        flex-grow: 1;
    }

    .card-footer {
        border-top: 1px solid var(--border-dark);
        padding-top: 24px;
        margin-top: auto;
    }

    .card-cta {
        font-family: var(--font-data);
        font-size: 13px;
        font-weight: 700;
        color: var(--text-light);
        letter-spacing: 1px;
        text-transform: uppercase;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .card-cta span {
        color: var(--accent-cyan);
        transition: transform 0.2s;
    }

    .mission-card:hover .card-cta span {
        transform: translateX(6px);
    }
</style>

<main id="command-dashboard">
    <!-- Fetch the CMS Data specifically for Spring 2027 -->
    {% set drive = null %}
    {% for item in collections.drives %}
        {% if item.fileSlug == 'spring-2027' %}
            {% set drive = item.data %}
        {% endif %}
    {% endfor %}

    <!-- Cinematic Hero Section -->
    <section style="position: relative; width: 100%; min-height: 60vh; display: flex; align-items: flex-end; padding-top: 120px; padding-bottom: 140px; background-color: var(--bg-deep);">
        <!-- Background Image with Heavy Gradient Overlay -->
        <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 0;">
            <img src="{{ drive.image | default('https://images.unsplash.com/photo-1581092160562-40aa08e78837?auto=format&fit=crop&q=80&w=2000') }}" alt="Recruitment Cover" style="width: 100%; height: 100%; object-fit: cover; opacity: 0.5;">
            <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: linear-gradient(to bottom, rgba(10, 15, 25, 0.1) 0%, rgba(10, 15, 25, 0.7) 60%, var(--bg-deep) 100%);"></div>
        </div>

        <!-- Hero Content -->
        <div class="container" style="position: relative; z-index: 1; width: 100%;">
            <a href="/join_us/" style="font-family: var(--font-data); color: rgba(255,255,255,0.7); font-size: 13px; letter-spacing: 1px; text-transform: uppercase; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; margin-bottom: 40px; transition: color 0.2s;">
                <span style="display: inline-block; transform: translateY(-1px);">←</span> Back to Archives
            </a>
            
            <span style="font-family: var(--font-data); font-size: 13px; color: var(--accent-cyan); letter-spacing: 1px; text-transform: uppercase; margin-bottom: 16px; display: block;">
                RECRUITMENT CYCLE
            </span>
            
            <h1 style="font-size: clamp(40px, 8vw, 64px); font-weight: 800; color: var(--text-light); letter-spacing: -1px; margin-bottom: 0; line-height: 1.1; max-width: 900px;">
                {{ drive.title | default("Spring 2027 Induction") }}
            </h1>
        </div>
    </section>

    <!-- Floating Info Panel (Overlapping the Hero) -->
    <section style="position: relative; z-index: 2; margin-top: -60px; padding: 0 20px;">
        <div class="container" style="max-width: 100%; margin: 0;">
            <div style="background: var(--bg-panel-dark); border: 1px solid var(--border-dark); padding: 32px 40px; border-radius: 4px; display: flex; flex-direction: column; box-shadow: 0 20px 40px rgba(0,0,0,0.4); max-width: 800px;">
                <span style="font-family: var(--font-data); font-size: 12px; color: var(--text-muted); letter-spacing: 1px; text-transform: uppercase; margin-bottom: 12px;">Active Recruitment Roles</span>
                <p style="color: var(--accent-cyan); font-size: 18px; line-height: 1.6; font-weight: 500; margin: 0;">
                    {{ drive.roles | default("Aerodynamics, Embedded Systems, Payload Integration, Web Design") }}
                </p>
            </div>
        </div>
    </section>

    <!-- Clean Card Grid mirroring the Archive aesthetic -->
    <section style="padding: clamp(60px, 8vw, 100px) 0;">
        <div class="container">
            <div class="dashboard-grid">
                
                <!-- PHASE 01 -->
                <a href="/join_us/spring-2027/application/" class="mission-card status-{{ (drive.phase1.status | default('Open')) | lower }}">
                    <div class="card-content">
                        <span class="card-meta">PHASE 01 // {{ drive.phase1.status | default('Open') }}</span>
                        <h3 class="card-title">Initial Applications</h3>
                        <p class="card-desc">Role breakdowns, technical expectations, and the primary application portal.</p>
                        <div class="card-footer">
                            <span class="card-cta">ACCESS PORTAL <span>→</span></span>
                        </div>
                    </div>
                </a>

                <!-- PHASE 02 -->
                <a href="/join_us/spring-2027/test/" class="mission-card status-{{ (drive.phase2.status | default('Pending')) | lower }}">
                    <div class="card-content">
                        <span class="card-meta">PHASE 02 // {{ drive.phase2.status | default('Pending') }}</span>
                        <h3 class="card-title">Technical Test</h3>
                        <p class="card-desc">Syllabus breakdown, evaluation metrics, and logistical details for the written examination.</p>
                        <div class="card-footer">
                            <span class="card-cta">READ REPORT <span>→</span></span>
                        </div>
                    </div>
                </a>

                <!-- PHASE 03 -->
                <a href="/join_us/spring-2027/shortlist/" class="mission-card status-{{ (drive.phase3.status | default('Pending')) | lower }}">
                    <div class="card-content">
                        <span class="card-meta">PHASE 03 // {{ drive.phase3.status | default('Pending') }}</span>
                        <h3 class="card-title">Test Shortlist</h3>
                        <p class="card-desc">Official roster of candidates advancing to the technical interview rounds.</p>
                        <div class="card-footer">
                            <span class="card-cta">VIEW DATA <span>→</span></span>
                        </div>
                    </div>
                </a>

                <!-- PHASE 04 -->
                <a href="/join_us/spring-2027/interview/" class="mission-card status-{{ (drive.phase4.status | default('Pending')) | lower }}">
                    <div class="card-content">
                        <span class="card-meta">PHASE 04 // {{ drive.phase4.status | default('Pending') }}</span>
                        <h3 class="card-title">Interviews</h3>
                        <p class="card-desc">Panel schedules, time-slots, and preparation guidelines for shortlisted applicants.</p>
                        <div class="card-footer">
                            <span class="card-cta">VIEW LOGISTICS <span>→</span></span>
                        </div>
                    </div>
                </a>

                <!-- PHASE 05 -->
                <a href="/join_us/spring-2027/results/" class="mission-card status-{{ (drive.phase5.status | default('Pending')) | lower }}">
                    <div class="card-content">
                        <span class="card-meta">PHASE 05 // {{ drive.phase5.status | default('Pending') }}</span>
                        <h3 class="card-title">Final Results</h3>
                        <p class="card-desc">The finalized list of inducted members for the Spring 2027 competition cycle.</p>
                        <div class="card-footer">
                            <span class="card-cta">VIEW ROSTER <span>→</span></span>
                        </div>
                    </div>
                </a>

            </div>
        </div>
    </section>
</main>
