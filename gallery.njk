                    </a>
                </div>
            </div>
        </section>

        <!-- Category 2: Flight Logs (Videos) -->
        <section class="gallery-section" style="background: var(--bg-panel-dark);">
            <div class="container">
                <div class="gallery-header">
                    <h4>VIDEO ARCHIVE</h4>
                    <h2>Flight Logs</h2>
                </div>
                <div class="video-grid">
                    <a href="#" class="gallery-item" style="aspect-ratio: 21/9;">
                        <img src="https://images.unsplash.com/photo-1579825633390-2e45bbd4fb63?auto=format&fit=crop&q=80&w=1200" alt="Maiden Flight">
