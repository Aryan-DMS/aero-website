            <div style="display: flex; gap: 24px;">
                <a href="#" style="color: var(--text-muted); text-decoration: none; font-size: 13px; transition: color 0.2s;">Instagram</a>
                <a href="#" style="color: var(--text-muted); text-decoration: none; font-size: 13px; transition: color 0.2s;">LinkedIn</a>
                <a href="#" style="color: var(--text-muted); text-decoration: none; font-size: 13px; transition: color 0.2s;">YouTube</a>
            </div>
        </div>
    </footer>
    

<!-- Professional Lightbox Overlay -->
    <!-- Professional Lightbox Overlay with Custom Player -->
    <div class="lightbox" id="media-lightbox">
        <button class="lightbox-close" id="lightbox-close">×</button>
        <div class="lightbox-content-wrapper">
            
            <!-- Image Viewer -->
            <img src="" alt="" class="lightbox-img" id="lightbox-img">
            
            <!-- Custom Video Player -->
            <div class="video-container" id="video-container">
                <video src="" class="lightbox-video" id="lightbox-video"></video>
                <div class="video-controls">
                    <button class="control-btn" id="play-pause-btn">⏸</button>
                    <input type="range" class="progress-bar" id="progress-bar" value="0" min="0" step="0.1">
                    <span class="time-display" id="time-display">0:00 / 0:00</span>
                    <button class="control-btn" id="mute-btn">🔊</button>
                </div>
            </div>
            
            <div class="lightbox-meta-container">
                <div class="lightbox-caption-text" id="lightbox-caption"></div>
                <div class="lightbox-meta-tag" id="lightbox-tag"></div>
            </div>
        </div>
    </div>

    <!-- Lightbox Logic -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const lightbox = document.getElementById('media-lightbox');
            const lbImg = document.getElementById('lightbox-img');
            const videoContainer = document.getElementById('video-container');
            const lbVid = document.getElementById('lightbox-video');
            const lbCaption = document.getElementById('lightbox-caption');
            const lbTag = document.getElementById('lightbox-tag');
            const closeBtn = document.getElementById('lightbox-close');
            
            // Custom Video Controls
            const playPauseBtn = document.getElementById('play-pause-btn');
            const progressBar = document.getElementById('progress-bar');
            const timeDisplay = document.getElementById('time-display');
            const muteBtn = document.getElementById('mute-btn');

            // Open Lightbox
            document.querySelectorAll('.gallery-item').forEach(item => {
                item.addEventListener('click', () => {
                    const type = item.getAttribute('data-type');
                    const src = item.getAttribute('data-src');
                    const caption = item.querySelector('.gallery-caption').textContent;
                    const meta = item.getAttribute('data-meta') || 'ARCHIVE';

                    lbCaption.textContent = caption;
                    lbTag.textContent = meta;

                    if (type === 'video') {
                        lbImg.style.display = 'none';
                        videoContainer.style.display = 'block';
                        lbVid.src = src;
                        lbVid.play();
                        playPauseBtn.textContent = '⏸';
                    } else {
                        videoContainer.style.display = 'none';
                        lbImg.src = src;
                        lbImg.style.display = 'block';
                    }
                    
                    lightbox.classList.add('active');
                });
            });

            // Format time utility
            const formatTime = (time) => {
                const minutes = Math.floor(time / 60);
                const seconds = Math.floor(time % 60);
                return `${minutes}:${seconds < 10 ? '0' : ''}${seconds}`;
            };

            // Video Player Logic
            playPauseBtn.addEventListener('click', () => {
                if (lbVid.paused) {
                    lbVid.play();
                    playPauseBtn.textContent = '⏸';
                } else {
                    lbVid.pause();
                    playPauseBtn.textContent = '▶';
                }
            });

            lbVid.addEventListener('timeupdate', () => {
                progressBar.value = (lbVid.currentTime / lbVid.duration) * 100 || 0;
                timeDisplay.textContent = `${formatTime(lbVid.currentTime)} / ${formatTime(lbVid.duration || 0)}`;
            });

            progressBar.addEventListener('input', () => {
                const time = (progressBar.value / 100) * lbVid.duration;
                lbVid.currentTime = time;
            });

            muteBtn.addEventListener('click', () => {
                lbVid.muted = !lbVid.muted;
                muteBtn.textContent = lbVid.muted ? '🔇' : '🔊';
            });

            // Close & Hard-Clear Cache Logic
            const closeLightbox = () => {
                lightbox.classList.remove('active');
                
                // Pause and clear everything to prevent ghost caching
                lbVid.pause();
                
                setTimeout(() => {
                    lbVid.removeAttribute('src'); // Hard clear video
                    lbImg.removeAttribute('src'); // Hard clear image
                    lbVid.load(); // Forces browser to drop the frame memory
                    lbImg.style.display = 'none';
                    videoContainer.style.display = 'none';
                }, 300); // Wait for fade out animation
            };

            closeBtn.addEventListener('click', closeLightbox);
            
            // Close if clicking outside
            lightbox.addEventListener('click', (e) => {
                if (e.target === lightbox || e.target.classList.contains('lightbox-content-wrapper')) {
                    closeLightbox();
                }
            });

            // Close on Escape key
            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape' && lightbox.classList.contains('active')) {
                    closeLightbox();
                }
            });
        });
    </script>
</body>
</html>
