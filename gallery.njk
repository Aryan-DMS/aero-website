<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AeroClub | Home</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Roboto+Mono:wght@400;500&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --bg-deep: #0B1121;
            --bg-panel-dark: #151E32;
            --bg-light: #F8FAFC;
            --bg-white: #FFFFFF;
            
            --accent-cyan: #0EA5E9;
            
            --text-light: #F8FAFC;
            --text-muted: #94A3B8;
            --text-dark: #0F172A;
            
            --border-dark: rgba(255, 255, 255, 0.1);
            
            --font-ui: 'Inter', sans-serif;
            --font-data: 'Roboto Mono', monospace;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; scroll-behavior: smooth; }
        body { font-family: var(--font-ui); background: var(--bg-deep); color: var(--text-light); -webkit-font-smoothing: antialiased; display: flex; flex-direction: column; min-height: 100vh; }
        a { text-decoration: none; color: inherit; }
        ul { list-style: none; }
        
        .container { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
        main { flex: 1; }

        /* ==========================================
           CLEAN, FLAT, HIGH-CONTRAST NAVIGATION
        ========================================== */
        header {
            background: var(--bg-deep); /* Solid, integrated background */
            border-bottom: 1px solid var(--border-dark);
            height: 80px; /* Taller for better breathing room */
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 40px;
            position: sticky;
            top: 0;
            z-index: 1000;
        }
        
        .nav-logo { font-weight: 800; font-size: 24px; letter-spacing: -0.5px; }
        .nav-logo span { color: var(--accent-cyan); }
        
        /* Removed the pill container styling completely */
        .nav-links { 
            display: flex; 
            gap: 4px; 
        }
        
        /* Larger, bolder, more readable links */
        .nav-links a { 
            color: var(--text-light); 
            font-size: 16px; 
            font-weight: 600; 
            padding: 10px 18px; 
            border-radius: 4px; /* Subtle architectural rounding */
            transition: all 0.2s ease;
        }
        
        /* High contrast DW.com style hover & active states */
        .nav-links a:hover, 
        .nav-links a.active {
            background-color: var(--bg-white); 
            color: var(--bg-deep); 
        }

        /* High-Contrast, Dual-Color Buttons */
        .btn-join { display: inline-block; background: var(--accent-cyan); color: var(--bg-deep); padding: 12px 28px; border-radius: 4px; font-size: 15px; font-weight: 800; border: 1px solid var(--accent-cyan); transition: all 0.2s ease; }
        .btn-join:hover { background: var(--text-light); color: var(--bg-deep); border-color: var(--text-light); }

        .btn-outline { display: inline-block; padding: 12px 28px; border: 1px solid var(--border-dark); background: transparent; color: var(--text-light); border-radius: 4px; font-size: 15px; font-weight: 800; transition: all 0.2s ease; }
        .btn-outline:hover { background: var(--text-light); color: var(--bg-deep); border-color: var(--text-light); }

        /* ==========================================
           FIXED BENTO-BOX GALLERY GRID
        ========================================== */
        .gallery-section { padding: 80px 0; border-bottom: 1px solid var(--border-dark); }
        .gallery-header { margin-bottom: 40px; }
        .gallery-header h4 { font-family: var(--font-data); color: var(--accent-cyan); font-size: 14px; margin-bottom: 12px; letter-spacing: 1px; text-transform: uppercase; }
        .gallery-header h2 { font-size: 36px; font-weight: 800; color: var(--text-light); letter-spacing: -0.5px; }
        
        .bento-grid { 
            display: grid; 
            grid-template-columns: repeat(4, 1fr); 
            grid-auto-rows: 300px; /* Fixed height for uniformity */
            gap: 24px; 
        }
        
        /* Responsive Breakpoints */
        @media (max-width: 1024px) { .bento-grid { grid-template-columns: repeat(2, 1fr); } }
        @media (max-width: 600px) { .bento-grid { grid-template-columns: 1fr; grid-auto-rows: 250px; } .bento-grid > div { grid-column: span 1 !important; grid-row: span 1 !important; } }
        
        /* Grid Span Utilities */
        .span-2-col { grid-column: span 2; }
        .span-2-row { grid-row: span 2; }
        .featured-item { grid-column: span 2; grid-row: span 2; }
        
        .gallery-item { position: relative; border-radius: 8px; overflow: hidden; border: 1px solid var(--border-dark); background: var(--bg-panel-dark); cursor: pointer; display: block; }
        
        /* Object-fit cover ensures it fills the rigid grid without EVER squishing */
        .gallery-item img, .gallery-item .thumbnail-video { width: 100%; height: 100%; object-fit: cover; filter: grayscale(80%) contrast(1.1); transition: all 0.4s ease; display: block; }
        .gallery-item:hover img, .gallery-item:hover .thumbnail-video { filter: grayscale(0%); transform: scale(1.05); }
        
        .gallery-caption { position: absolute; bottom: 0; left: 0; right: 0; padding: 48px 24px 24px; background: linear-gradient(to top, rgba(11,17,33,0.95) 10%, transparent); color: var(--text-light); font-weight: 700; font-size: 16px; opacity: 0; transform: translateY(10px); transition: all 0.3s ease; pointer-events: none; z-index: 5; }
        .gallery-item:hover .gallery-caption { opacity: 1; transform: translateY(0); }
        
        .play-btn { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 64px; height: 64px; background: rgba(11,17,33,0.7); border: 2px solid var(--text-light); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: var(--text-light); transition: all 0.2s ease; z-index: 2; }
        .gallery-item:hover .play-btn { background: var(--accent-cyan); color: var(--text-light); border-color: var(--accent-cyan); transform: translate(-50%, -50%) scale(1.1); }
        .play-btn::after { content: '▶'; margin-left: 4px; font-size: 20px; }

        /* ==========================================
           CUSTOM LIGHTBOX & VIDEO PLAYER
        ========================================== */
        .lightbox { position: fixed; inset: 0; background: rgba(11, 17, 33, 0.98); z-index: 9999; display: flex; flex-direction: column; align-items: center; justify-content: center; opacity: 0; pointer-events: none; transition: opacity 0.3s ease; backdrop-filter: blur(10px); }
        .lightbox.active { opacity: 1; pointer-events: auto; }
        
        .lightbox-close { position: absolute; top: 40px; right: 40px; background: transparent; border: 1px solid var(--border-dark); color: var(--text-light); width: 48px; height: 48px; border-radius: 50%; font-size: 24px; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: all 0.2s ease; z-index: 10000; }
        .lightbox-close:hover { background: var(--text-light); color: var(--bg-deep); border-color: var(--text-light); }
        
        .lightbox-content-wrapper { position: relative; width: 90vw; height: 85vh; display: flex; justify-content: center; align-items: center; flex-direction: column; }
        
        .lightbox-img, .lightbox-video { max-width: 100%; max-height: calc(85vh - 100px); border-radius: 4px; border: 1px solid var(--border-dark); box-shadow: 0 20px 40px rgba(0,0,0,0.5); display: none; object-fit: contain; }
        
        /* Custom Video Player UI */
        .video-container { position: relative; display: none; max-width: 100%; max-height: calc(85vh - 100px); }
        .video-controls { position: absolute; bottom: 0; left: 0; right: 0; background: linear-gradient(to top, rgba(11,17,33,0.95), transparent); padding: 30px 20px 15px; display: flex; align-items: center; gap: 16px; opacity: 0; transition: opacity 0.3s ease; border-bottom-left-radius: 4px; border-bottom-right-radius: 4px; }
        .video-container:hover .video-controls { opacity: 1; }
        
        .control-btn { background: transparent; border: none; color: var(--text-light); font-size: 18px; cursor: pointer; transition: color 0.2s; padding: 0; }
        .control-btn:hover { color: var(--accent-cyan); }
        
        .progress-bar { flex: 1; -webkit-appearance: none; height: 4px; background: rgba(255,255,255,0.2); border-radius: 2px; outline: none; cursor: pointer; }
        .progress-bar::-webkit-slider-thumb { -webkit-appearance: none; width: 12px; height: 12px; border-radius: 50%; background: var(--accent-cyan); cursor: pointer; }
        
        .time-display { font-family: var(--font-data); font-size: 12px; color: var(--text-light); min-width: 80px; text-align: center; }

        .lightbox-meta-container { text-align: center; margin-top: 24px; }
        .lightbox-caption-text { font-size: 20px; font-weight: 800; color: var(--text-light); margin-bottom: 8px; }
        .lightbox-meta-tag { font-family: var(--font-data); color: var(--accent-cyan); font-size: 12px; text-transform: uppercase; letter-spacing: 1px; }

        /* ==========================================
           PAGE CONTENT (HOME PAGE)
        ========================================== */
        .hero {
            height: calc(100vh - 80px);
            background: linear-gradient(to right, rgba(11,17,33,0.95), rgba(11,17,33,0.2)), url('https://images.unsplash.com/photo-1541187764121-717013809cb8?auto=format&fit=crop&q=80&w=2000') center/cover;
            display: flex;
            align-items: center;
        }
        .hero-text h1 { font-size: 64px; font-weight: 800; line-height: 1.1; margin-bottom: 20px; max-width: 800px; letter-spacing: -1px; }
        .hero-text p { font-size: 20px; color: var(--text-muted); max-width: 600px; margin-bottom: 40px; font-family: var(--font-data); }

        /* ==========================================
           GLOBAL FOOTER
        ========================================== */
        footer { background: var(--bg-deep); border-top: 1px solid var(--border-dark); margin-top: auto; }
        .map-container { width: 100%; height: 350px; background: #111; border-bottom: 1px solid var(--border-dark); }
        .map-container iframe { width: 100%; height: 100%; border: 0; filter: invert(90%) hue-rotate(180deg) contrast(1.1); }
        
        .footer-content { padding: 80px 0 40px; display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 40px; border-bottom: 1px solid var(--border-dark); margin-bottom: 24px; }
        .footer-brand .logo { font-size: 24px; font-weight: 800; margin-bottom: 16px; display: block; }
        .footer-brand .logo span { color: var(--accent-cyan); }
        .footer-brand p { color: var(--text-muted); font-size: 14px; line-height: 1.6; margin-bottom: 24px; max-width: 300px; }
        .contact-info li { display: flex; align-items: center; gap: 12px; color: var(--text-muted); font-size: 14px; margin-bottom: 12px; }
        
        .footer-links h4 { font-size: 13px; font-weight: 700; letter-spacing: 1px; margin-bottom: 20px; color: var(--text-light); text-transform: uppercase; }
        .footer-links ul li { margin-bottom: 12px; }
        .footer-links ul a { color: var(--text-muted); font-size: 14px; transition: color 0.2s; }
        .footer-links ul a:hover { color: var(--accent-cyan); }

        .footer-bottom { padding-bottom: 40px; display: flex; justify-content: space-between; align-items: center; color: var(--text-muted); font-size: 14px; }
        
        /* Layout for Content Sections */
        .page-section { padding: 120px 0; min-height: 80vh; border-bottom: 1px solid var(--border-dark); }
        .page-section h2 { font-size: 40px; font-weight: 800; margin-bottom: 24px; color: var(--text-light); }
        .page-section p { font-size: 18px; color: var(--text-muted); }
    </style>
</head>
<body>

    <!-- Integrated, High-Contrast Navigation -->
    <header>
        <a href="index.html" class="nav-logo">Aero<span>Club</span></a>
        
        <nav>
            <ul class="nav-links">
                <li><a href="/about/" {% if '/about/' in page.url %}class="active"{% endif %}>About</a></li>
                <li><a href="/achievements/" {% if '/achievements/' in page.url %}class="active"{% endif %}>Achievements</a></li>
                <li><a href="/gallery/" {% if '/gallery/' in page.url %}class="active"{% endif %}>Gallery</a></li>
                <li><a href="/models/" {% if '/models/' in page.url %}class="active"{% endif %}>Models</a></li>
                <li><a href="/events/" {% if '/events/' in page.url %}class="active"{% endif %}>Events</a></li>
                <li><a href="/team/" {% if '/team/' in page.url %}class="active"{% endif %}>Team</a></li>
                <li><a href="/contact/" {% if '/contact/' in page.url %}class="active"{% endif %}>Contact</a></li>
            </ul>
        </nav>
        <a href="/join_us/" class="btn-join">Join Us</a>
    </header>

    <!-- Page Specific Content Wrapper -->
    <!-- Page Specific Content Wrapper -->
    <main id="gallery-page">
        
        <!-- Header -->
        <section style="padding: 80px 0 40px; border-bottom: 1px solid var(--border-dark);">
            <div class="container">
                <h2 style="font-size: 48px; font-weight: 800; margin-bottom: 16px; color: var(--text-light); letter-spacing: -1px;">Media & Archives</h2>
                <p style="color: var(--text-muted); font-size: 20px; line-height: 1.6; max-width: 700px;">A visual record of our engineering process, testing deployments, and competition history.</p>
            </div>
        </section>

        <!-- Section 1: Field Operations & Flight Logs (Mixed Media) -->
        <section class="gallery-section">
            <div class="container">
                <div class="gallery-header">
                    <h4>MEDIA ARCHIVE</h4>
                    <h2>Project & Flight Media</h2>
                </div>
                
                <div class="bento-grid">
                    {% for page in collections.all %}
                        {% if page.fileSlug == 'gallery' %}
                            {% for item in page.data.operations %}
                            <div class="gallery-item {% if item.grid_span != 'standard' %}{{ item.grid_span }}{% endif %}" data-type="{{ item.type }}" data-src="{{ item.src }}" data-meta="{{ item.meta }}">
                                <img src="{% if item.thumbnail %}{{ item.thumbnail }}{% else %}{{ item.src }}{% endif %}" alt="{{ item.caption }}">
                                {% if item.type == 'video' %}<div class="play-btn"></div>{% endif %}
                                <div class="gallery-caption">{{ item.caption }}</div>
                            </div>
                            {% endfor %}
                        {% endif %}
                    {% endfor %}
                </div>
            </div>
        </section>

        <!-- Section 2: Hall of Records / Ceremonial -->
        <section class="gallery-section" style="border-bottom: none; background: var(--bg-panel-dark);">
            <div class="container">
                <div class="gallery-header">
                    <h4>ACCOLADES</h4>
                    <h2>Hall of Records</h2>
                </div>
                
                <div class="bento-grid" style="grid-auto-rows: 250px;">
                    {% for page in collections.all %}
                        {% if page.fileSlug == 'gallery' %}
                            {% for item in page.data.awards %}
                            <div class="gallery-item {% if item.grid_span != 'standard' %}{{ item.grid_span }}{% endif %}" data-type="{{ item.type }}" data-src="{{ item.src }}" data-meta="{{ item.meta }}">
                                <img src="{% if item.thumbnail %}{{ item.thumbnail }}{% else %}{{ item.src }}{% endif %}" alt="{{ item.caption }}">
                                {% if item.type == 'video' %}<div class="play-btn"></div>{% endif %}
                                <div class="gallery-caption">{{ item.caption }}</div>
                            </div>
                            {% endfor %}
                        {% endif %}
                    {% endfor %}
                </div>
            </div>
        </section>

    </main>
    
    
    <!-- Global Footer -->
    <footer style="background: var(--bg-deep); border-top: 1px solid var(--border-dark); padding: 80px 0 40px; margin-top: auto;">
