    <!-- Page Specific Content Wrapper -->
    <main id="gallery-page">
        
        <!-- Header -->
        <section style="padding: 80px 0 40px; border-bottom: 1px solid var(--border-dark);">
            <div class="container">
                <h2 style="font-size: 48px; font-weight: 800; margin-bottom: 16px; color: var(--text-light); letter-spacing: -1px;">Media & Archives</h2>
                <p style="color: var(--text-muted); font-size: 20px; line-height: 1.6; max-width: 700px;">A visual record of our engineering process, testing deployments, and competition history.</p>
            </div>
        </section>

        <!-- Category 1: Field Operations (Photos) -->
        <section class="gallery-section">
            <div class="container">
                <div class="gallery-header">
                    <h4>IMAGE ARCHIVE</h4>
