                        <div class="gallery-caption">Project Valkyrie // Maiden Autonomous Flight</div>
                    </a>
                    <a href="#" class="gallery-item" style="aspect-ratio: 21/9;">
                        <img src="https://images.unsplash.com/photo-1540962351504-03099e0a754b?auto=format&fit=crop&q=80&w=1200" alt="Competition Run">
                        <div class="play-btn"></div>
                        <div class="gallery-caption">National Techfest // Final Deployment Circuit</div>
                    </a>
                </div>
            </div>
        </section>

        <!-- Category 3: Hall of Records (Awards) -->
        <section class="gallery-section" style="border-bottom: none;">
            <div class="container">
                <div class="gallery-header">
                    <h4>ACCOLADES</h4>
                    <h2>Hall of Records</h2>
                </div>
                <div class="gallery-grid">
                    <a href="#" class="gallery-item">
                        <img src="https://images.unsplash.com/photo-1517433670267-08bbd4be890f?auto=format&fit=crop&q=80&w=800" alt="Team Award">
                        <div class="gallery-caption">Best Embedded System // 2025 Expo</div>
                    </a>
                    <a href="#" class="gallery-item">
                        <img src="https://images.unsplash.com/photo-1552664730-d307ca884978?auto=format&fit=crop&q=80&w=800" alt="Podium">
                        <div class="gallery-caption">Overall Team Champions // 2024 Regionals</div>
                    </a>
                </div>
            </div>
        </section>

    </main>

    <!-- Global Footer -->
