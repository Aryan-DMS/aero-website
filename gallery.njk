---
layout: base.njk
title: "AeroClub | Gallery"
---
<style>

        /* High-Contrast, Dual-Color Buttons */
        .btn-join { display: inline-block; background: var(--accent-cyan); color: var(--bg-deep); padding: 12px 28px; border-radius: 4px; font-size: 15px; font-weight: 800; border: 1px solid var(--accent-cyan); transition: all 0.2s ease; }
        .btn-join:hover { background: var(--text-light); color: var(--bg-deep); border-color: var(--text-light); }

        .btn-outline { display: inline-block; padding: 12px 28px; border: 1px solid var(--border-dark); background: transparent; color: var(--text-light); border-radius: 4px; font-size: 15px; font-weight: 800; transition: all 0.2s ease; }
        .btn-outline:hover { background: var(--text-light); color: var(--bg-deep); border-color: var(--text-light); }

        /* ==========================================
           YOUTUBE-STYLE CLEAN ARCHITECTURE
        ========================================== */
        .gallery-section { padding: 40px 0 80px; border-bottom: 1px solid var(--border-dark); }
        .gallery-header { margin-bottom: 24px; }
        .gallery-header h4 { font-family: var(--font-data); color: var(--accent-cyan); font-size: 13px; margin-bottom: 12px; letter-spacing: 1px; text-transform: uppercase; }
        .gallery-header h2 { font-size: 32px; font-weight: 800; color: var(--text-light); letter-spacing: -0.5px; }
        
        /* Clean Apple/YT style pills - NO NEON */
        .media-tabs { display: flex; gap: 12px; margin-top: 24px; flex-wrap: wrap; }
        .tab-btn { background: var(--bg-panel-dark); border: 1px solid var(--border-dark); color: var(--text-light); font-size: 14px; font-weight: 500; padding: 8px 24px; cursor: pointer; transition: all 0.2s ease; border-radius: 8px; }
        .tab-btn:hover { background: rgba(255,255,255,0.1); }
        .tab-btn.active { color: var(--bg-deep); background: var(--text-light); border-color: var(--text-light); font-weight: 700; }
        
        .feed-grid { display: grid; column-gap: 16px; row-gap: 40px; transition: opacity 0.3s ease; }
        .feed-grid.hidden { display: none; }
        
        /* 16:9 Horizontal Feed */
        .grid-horizontal { grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr)); gap: var(--space-gap); }
        .grid-horizontal .thumb-wrapper { aspect-ratio: 16 / 9; }
        
        /* 9:16 Vertical Feed */
        .grid-vertical { grid-template-columns: repeat(auto-fill, minmax(min(100%, 160px), 1fr)); gap: var(--space-gap); }
        .grid-vertical .thumb-wrapper { aspect-ratio: 9 / 16; }
        
        /* Separate Thumbnail and Text */
        .gallery-card { display: flex; flex-direction: column; cursor: pointer; text-decoration: none; }
        .thumb-wrapper { position: relative; width: 100%; border-radius: 8px; overflow: hidden; background: var(--bg-panel-dark); border: 1px solid rgba(255,255,255,0.05); }
        
        .thumb-wrapper img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s ease; }
        .gallery-card:hover .thumb-wrapper img { transform: scale(1.03); }
        
        .play-indicator { position: absolute; top: 12px; right: 12px; background: rgba(0,0,0,0.8); color: white; font-family: var(--font-data); font-size: 11px; padding: 4px 8px; border-radius: 4px; font-weight: 700; }
        
        .card-info { margin-top: 12px; display: flex; flex-direction: column; gap: 4px; padding-right: 16px; }
        .card-info h3 { font-size: clamp(15px, 2vw, 17px) !important; font-weight: 600; color: var(--text-light) !important; line-height: 1.4 !important; margin: 0 !important; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; letter-spacing: normal !important; }
        .card-info span { font-family: var(--font-data); font-size: 12px; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px; }

        /* ==========================================
           PREMIUM CINEMATIC LIGHTBOX
        ========================================== */
        .lightbox { position: fixed; inset: 0; background: var(--bg-deep); z-index: 9999; display: flex; opacity: 0; pointer-events: none; transition: opacity 0.3s ease; flex-direction: column; }
        .lightbox.active { opacity: 1; pointer-events: auto; }
        
        /* Minimal Top Header */
        .lightbox-header { width: 100%; height: 72px; display: flex; align-items: center; justify-content: space-between; padding: 0 32px; background: rgba(11, 17, 33, 0.95); border-bottom: 1px solid var(--border-dark); z-index: 10000; flex-shrink: 0; }
        
        /* Brand Left */
        .lb-brand { font-size: 20px; font-weight: 800; color: var(--text-light); text-decoration: none; letter-spacing: -0.5px; }
        .lb-brand span { color: var(--accent-cyan); }
        
        /* Controls Right */
        .lb-controls { display: flex; align-items: center; gap: 24px; }
        
        /* The Information Link Icon (Media Overlay) */
        .lb-info-btn { position: absolute; top: 16px; right: 16px; color: rgba(255, 255, 255, 0.7); font-size: 16px; text-decoration: none; display: none; align-items: center; justify-content: center; width: 32px; height: 32px; border-radius: 50%; transition: all 0.2s ease; font-family: monospace; font-weight: bold; background: rgba(0, 0, 0, 0.5); border: 1px solid rgba(255, 255, 255, 0.1); z-index: 100; }
        .lb-info-btn:hover { background: rgba(255, 255, 255, 0.15); color: #ffffff; border-color: rgba(255, 255, 255, 0.4); }
        
        /* Close Button */
        .lightbox-close { background: transparent; border: none; color: var(--text-light); font-size: 36px; cursor: pointer; transition: color 0.2s ease; display: flex; align-items: center; line-height: 1; padding: 0; }
        .lightbox-close:hover { color: #ef4444; } /* Subtle red on hover for close */
        
        /* 2-Column Split - Adjusted for Header */
        .yt-layout { width: 100%; height: calc(100vh - 72px); display: grid; grid-template-columns: 1fr 360px; padding: 32px; gap: 32px; box-sizing: border-box; overflow: hidden; }
        
        .yt-main { display: flex; flex-direction: column; max-height: calc(100vh - 100px); }
        
        /* Main Player Area - Subtly Rounded */
        .yt-player-box { width: 100%; background: black; border-radius: 8px; overflow: hidden; display: flex; align-items: center; justify-content: center; position: relative; flex: 1; min-height: 0; }
        .lightbox-img, .lightbox-video { max-width: 100%; max-height: 100%; object-fit: contain; display: none; }
        
        .yt-meta-box { padding: 20px 0; flex-shrink: 0; }
        .yt-meta-box h2 { font-size: 24px; font-weight: 700; color: var(--text-light); margin-bottom: 8px; }
        .yt-meta-box span { font-family: var(--font-data); font-size: 14px; color: var(--text-muted); letter-spacing: 1px; text-transform: uppercase; }
        
        /* Sidebar Recommendations */
        .yt-sidebar { display: flex; flex-direction: column; gap: 16px; overflow-y: auto; padding-right: 8px; }
        .yt-sidebar::-webkit-scrollbar { width: 8px; }
        .yt-sidebar::-webkit-scrollbar-thumb { background: var(--border-dark); border-radius: 4px; }

        /* ==========================================
           MOBILE YOUTUBE UI STACK
        ========================================== */
        @media (max-width: 1024px) { 
            .lightbox-header { height: 60px; padding: 0 16px; }
            .yt-layout { display: flex; flex-direction: column; height: calc(100vh - 60px); padding: 0; gap: 0; overflow-y: auto; overflow-x: hidden; }
            
            .yt-main { max-height: none; }
            /* Edge-to-edge video player locking exactly to 16:9 ratio */
            .yt-player-box { border-radius: 0; flex: none; height: auto; aspect-ratio: 16 / 9; width: 100%; }
            
            .yt-meta-box { padding: 20px 16px; border-bottom: 1px solid var(--border-dark); }
            .yt-sidebar { padding: 20px 16px 40px; overflow-y: visible; }
        }
        
        .sidebar-card { display: grid; grid-template-columns: 160px 1fr; gap: 12px; cursor: pointer; }
        .sidebar-thumb { width: 100%; aspect-ratio: 16/9; border-radius: 6px; background-size: cover; background-position: center; border: 1px solid rgba(255,255,255,0.05); }
        .sidebar-info { display: flex; flex-direction: column; gap: 4px; padding-top: 4px; }
        .sidebar-info h4 { font-size: 14px; font-weight: 600; color: var(--text-light); line-height: 1.4; margin: 0; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
        .sidebar-info span { font-family: var(--font-data); font-size: 11px; color: var(--text-muted); }

        /* Custom Video Player UI */
        .video-controls { position: absolute; bottom: 0; left: 0; right: 0; background: linear-gradient(to top, rgba(0,0,0,0.95), transparent); padding: 30px 20px 15px; display: flex; align-items: center; gap: 16px; opacity: 0; transition: opacity 0.3s ease; }
        .yt-player-box:hover .video-controls { opacity: 1; }
        .control-btn { background: transparent; border: none; color: white; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: color 0.2s; }
        .control-btn:hover { color: var(--accent-cyan); }
        
        /* Dynamic Cyan Fill Track */
        .progress-bar { 
            flex: 1; -webkit-appearance: none; height: 4px; border-radius: 2px; cursor: pointer; 
            background: linear-gradient(to right, var(--accent-cyan) var(--progress, 0%), rgba(255,255,255,0.2) var(--progress, 0%)); 
            transition: height 0.1s ease;
        }
        .progress-bar:hover { height: 6px; }
        .progress-bar::-webkit-slider-thumb { -webkit-appearance: none; width: 14px; height: 14px; border-radius: 50%; background: var(--accent-cyan); cursor: pointer; box-shadow: 0 0 10px rgba(14, 165, 233, 0.4); }
        .time-display { font-family: var(--font-data); font-size: 12px; color: white; min-width: 80px; text-align: center; }

        /* ==========================================
           PAGE CONTENT (HOME PAGE)
        ========================================== */
        .hero {
            height: calc(100vh - 80px);
            background: linear-gradient(to right, rgba(11,17,33,0.95), rgba(11,17,33,0.2)), url('https://images.unsplash.com/photo-1541187764121-717013809cb8?auto=format&fit=crop&q=80&w=2000') center/cover;
            display: flex;
            align-items: center;
        }
        .hero-text h1 { font-size: 64px; font-weight: 800; line-height: 1.1; margin-bottom: 20px; max-width: 800px; letter-spacing: -1px; }
        .hero-text p { font-size: 20px; color: var(--text-muted); max-width: 600px; margin-bottom: 40px; font-family: var(--font-data); }

        /* ==========================================
           GLOBAL FOOTER
        ========================================== */
        footer { background: var(--bg-deep); border-top: 1px solid var(--border-dark); margin-top: auto; }
        .map-container { width: 100%; height: 350px; background: #111; border-bottom: 1px solid var(--border-dark); }
        .map-container iframe { width: 100%; height: 100%; border: 0; filter: invert(90%) hue-rotate(180deg) contrast(1.1); }
        
        .footer-content { padding: 80px 0 40px; display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 40px; border-bottom: 1px solid var(--border-dark); margin-bottom: 24px; }
        .footer-brand .logo { font-size: 24px; font-weight: 800; margin-bottom: 16px; display: block; }
        .footer-brand .logo span { color: var(--accent-cyan); }
        .footer-brand p { color: var(--text-muted); font-size: 14px; line-height: 1.6; margin-bottom: 24px; max-width: 300px; }
        .contact-info li { display: flex; align-items: center; gap: 12px; color: var(--text-muted); font-size: 14px; margin-bottom: 12px; }
        
        .footer-links h4 { font-size: 13px; font-weight: 700; letter-spacing: 1px; margin-bottom: 20px; color: var(--text-light); text-transform: uppercase; }
        .footer-links ul li { margin-bottom: 12px; }
        .footer-links ul a { color: var(--text-muted); font-size: 14px; transition: color 0.2s; }
        .footer-links ul a:hover { color: var(--accent-cyan); }

        .footer-bottom { padding-bottom: 40px; display: flex; justify-content: space-between; align-items: center; color: var(--text-muted); font-size: 14px; }
        
        /* Layout for Content Sections */
        .page-section { padding: 120px 0; min-height: 80vh; border-bottom: 1px solid var(--border-dark); }
        .page-section h2 { font-size: 40px; font-weight: 800; margin-bottom: 24px; color: var(--text-light); }
        .page-section p { font-size: 18px; color: var(--text-muted); }
</style>

<main id="gallery-page">
        
        <!-- Header with Universal Toggle -->
        <section style="padding: 80px 0 40px; border-bottom: 1px solid var(--border-dark);">
            <div class="container">
                <h4 style="font-family: var(--font-data); color: var(--accent-cyan); font-size: 14px; margin-bottom: 12px; letter-spacing: 1px; text-transform: uppercase;">VISUAL LOG</h4>
                <h2 style="font-size: 48px; font-weight: 800; margin-bottom: 16px; color: var(--text-light); letter-spacing: -1px;">Media & Archives</h2>
                <p style="color: var(--text-muted); font-size: 20px; line-height: 1.6; max-width: 700px; margin-bottom: 12px;">A visual record of our engineering process, testing deployments, and competition history.</p>
                
                <div class="media-tabs">
                    <button class="tab-btn active" onclick="switchGlobalFeed('horizontal', event)">Horizontal</button>
                    <button class="tab-btn" onclick="switchGlobalFeed('vertical', event)">Vertical</button>
                </div>
            </div>
        </section>

        <!-- Section 1: Field Operations & Flight Logs -->
        <section class="gallery-section">
            <div class="container" id="ops-container">
                <div class="gallery-header">
                    <h4>MEDIA ARCHIVE</h4>
                    <h2>Project & Flight Media</h2>
                </div>
                
                <!-- Horizontal Feed -->
                <div id="ops-horizontal" class="feed-grid grid-horizontal">
                    {% for page in collections.all %}
                        {% if page.fileSlug == 'gallery' %}
                            {% for item in page.data.operations %}
                                {% if item.media_format != 'Vertical' %}
                                <div class="gallery-card" data-type="{{ item.type }}" data-src="{{ item.src }}" data-meta="{{ item.meta }}" data-thumb="{% if item.thumbnail %}{{ item.thumbnail }}{% else %}{{ item.src }}{% endif %}" data-caption="{{ item.caption }}" data-url="{{ item.url }}">
                                    <div class="thumb-wrapper">
                                        <img src="{% if item.thumbnail %}{{ item.thumbnail }}{% else %}{{ item.src }}{% endif %}" alt="{{ item.caption }}">
                                        {% if item.type == 'video' %}<div class="play-indicator">▶ VIDEO</div>{% endif %}
                                    </div>
                                    <div class="card-info">
                                        <h3>{{ item.caption }}</h3>
                                        <span>{{ item.meta }}</span>
                                    </div>
                                </div>
                                {% endif %}
                            {% endfor %}
                        {% endif %}
                    {% endfor %}
                </div>

                <!-- Vertical Feed -->
                <div id="ops-vertical" class="feed-grid grid-vertical hidden">
                    {% for page in collections.all %}
                        {% if page.fileSlug == 'gallery' %}
                            {% for item in page.data.operations %}
                                {% if item.media_format == 'Vertical' %}
                                <div class="gallery-card" data-type="{{ item.type }}" data-src="{{ item.src }}" data-meta="{{ item.meta }}" data-thumb="{% if item.thumbnail %}{{ item.thumbnail }}{% else %}{{ item.src }}{% endif %}" data-caption="{{ item.caption }}" data-url="{{ item.url }}">
                                    <div class="thumb-wrapper">
                                        <img src="{% if item.thumbnail %}{{ item.thumbnail }}{% else %}{{ item.src }}{% endif %}" alt="{{ item.caption }}">
                                        {% if item.type == 'video' %}<div class="play-indicator">▶ VIDEO</div>{% endif %}
                                    </div>
                                    <div class="card-info">
                                        <h3>{{ item.caption }}</h3>
                                        <span>{{ item.meta }}</span>
                                    </div>
                                </div>
                                {% endif %}
                            {% endfor %}
                        {% endif %}
                    {% endfor %}
                </div>
            </div>
        </section>

        <!-- Section 2: Hall of Records / Ceremonial -->
        <section class="gallery-section" style="border-bottom: none; background: var(--bg-panel-dark);">
            <div class="container" id="awards-container">
                <div class="gallery-header">
                    <h4>ACCOLADES</h4>
                    <h2>Hall of Records</h2>
                </div>

                <!-- Toggle removed. Master Header Toggle now controls this section via switchGlobalFeed. -->
                
                <!-- Horizontal Feed -->
                <div id="awards-horizontal" class="feed-grid grid-horizontal">
                    {% for page in collections.all %}
                        {% if page.fileSlug == 'gallery' %}
                            {% for item in page.data.awards %}
                                {% if item.media_format != 'Vertical' %}
                                <div class="gallery-card" data-type="{{ item.type }}" data-src="{{ item.src }}" data-meta="{{ item.meta }}" data-thumb="{% if item.thumbnail %}{{ item.thumbnail }}{% else %}{{ item.src }}{% endif %}" data-caption="{{ item.caption }}" data-url="{{ item.url }}">
                                    <div class="thumb-wrapper">
                                        <img src="{% if item.thumbnail %}{{ item.thumbnail }}{% else %}{{ item.src }}{% endif %}" alt="{{ item.caption }}">
                                        {% if item.type == 'video' %}<div class="play-indicator">▶ VIDEO</div>{% endif %}
                                    </div>
                                    <div class="card-info">
                                        <h3>{{ item.caption }}</h3>
                                        <span>{{ item.meta }}</span>
                                    </div>
                                </div>
                                {% endif %}
                            {% endfor %}
                        {% endif %}
                    {% endfor %}
                </div>

                <!-- Vertical Feed -->
                <div id="awards-vertical" class="feed-grid grid-vertical hidden">
                    {% for page in collections.all %}
                        {% if page.fileSlug == 'gallery' %}
                            {% for item in page.data.awards %}
                                {% if item.media_format == 'Vertical' %}
                                <div class="gallery-card" data-type="{{ item.type }}" data-src="{{ item.src }}" data-meta="{{ item.meta }}" data-thumb="{% if item.thumbnail %}{{ item.thumbnail }}{% else %}{{ item.src }}{% endif %}" data-caption="{{ item.caption }}" data-url="{{ item.url }}">
                                    <div class="thumb-wrapper">
                                        <img src="{% if item.thumbnail %}{{ item.thumbnail }}{% else %}{{ item.src }}{% endif %}" alt="{{ item.caption }}">
                                        {% if item.type == 'video' %}<div class="play-indicator">▶ VIDEO</div>{% endif %}
                                    </div>
                                    <div class="card-info">
                                        <h3>{{ item.caption }}</h3>
                                        <span>{{ item.meta }}</span>
                                    </div>
                                </div>
                                {% endif %}
                            {% endfor %}
                        {% endif %}
                    {% endfor %}
                </div>
            </div>
        </section>

        <script>
            function switchGlobalFeed(format, event) {
                // Remove active class from all tabs, add to clicked
                document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
                event.currentTarget.classList.add('active');
                
                // Hide ALL grids on the page
                document.querySelectorAll('.feed-grid').forEach(grid => grid.classList.add('hidden'));
                
                // Show only the requested format for ALL sections
                document.querySelectorAll('.grid-' + format).forEach(grid => grid.classList.remove('hidden'));
            }
        </script>
    </main>
    

<!-- Premium Split Screen Lightbox -->
    <div class="lightbox" id="media-lightbox">
        
        <!-- Minimal Top Navigation -->
        <div class="lightbox-header">
            <a href="/" class="lb-brand">Aerial<span>Martial</span></a>
            <div class="lb-controls">
                <button class="lightbox-close" id="lightbox-close" title="Close Gallery">×</button>
            </div>
        </div>
        
        <div class="yt-layout">
            
            <!-- LEFT: Main Player Area -->
            <div class="yt-main">
                <div class="yt-player-box" id="video-container">
                    <a href="#" target="_blank" rel="noopener noreferrer" class="lb-info-btn" id="lightbox-link" title="View Source">ⓘ</a>
                    <img src="" alt="" class="lightbox-img" id="lightbox-img">
                    <video src="" class="lightbox-video" id="lightbox-video"></video>
                    
                    <div class="video-controls" id="vid-controls">
                        <button class="control-btn" id="play-pause-btn">
                            <svg id="icon-pp" viewBox="0 0 24 24" width="24" height="24" fill="currentColor"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
                        </button>
                        <input type="range" class="progress-bar" id="progress-bar" value="0" min="0" step="0.1">
                        <span class="time-display" id="time-display">0:00 / 0:00</span>
                        <button class="control-btn" id="mute-btn">
                            <svg id="icon-vol" viewBox="0 0 24 24" width="24" height="24" fill="currentColor"><path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"/></svg>
                        </button>
                    </div>
                </div>
                
                <div class="yt-meta-box">
                    <h2 id="lightbox-caption"></h2>
                    <span id="lightbox-tag"></span>
                </div>
            </div>
            
            <!-- RIGHT: Recommendation Sidebar -->
            <div class="yt-sidebar" id="lightbox-sidebar">
                <!-- Javascript injects related videos/images here -->
            </div>
            
        </div>
    </div>

    <!-- Advanced Lightbox Logic -->
    <!-- Advanced Lightbox Logic -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const lightbox = document.getElementById('media-lightbox');
            const lbImg = document.getElementById('lightbox-img');
            const lbVid = document.getElementById('lightbox-video');
            const vidControls = document.getElementById('vid-controls');
            const lbCaption = document.getElementById('lightbox-caption');
            const lbTag = document.getElementById('lightbox-tag');
            const sidebar = document.getElementById('lightbox-sidebar');
            const closeBtn = document.getElementById('lightbox-close');
            
            const playPauseBtn = document.getElementById('play-pause-btn');
            const progressBar = document.getElementById('progress-bar');
            const timeDisplay = document.getElementById('time-display');
            const muteBtn = document.getElementById('mute-btn');

            // The Master Function: Loads media and dynamically builds the sidebar relative to the clicked card
            window.openLightbox = function(card) {
                // Lock the main body from scrolling
                document.body.style.overflow = 'hidden';

                // Pause existing video if playing before swapping
                lbVid.pause();
                
                const src = card.getAttribute('data-src');
                const type = card.getAttribute('data-type');
                const meta = card.getAttribute('data-meta') || 'ARCHIVE';
                const caption = card.getAttribute('data-caption');
                const thumb = card.getAttribute('data-thumb');
                const extUrl = card.getAttribute('data-url');
                
                // Header Controls: Handle the external URL Icon
                const lbLink = document.getElementById('lightbox-link');
                if (extUrl && extUrl.trim() !== "") {
                    lbLink.href = extUrl;
                    lbLink.style.display = "flex";
                } else {
                    lbLink.style.display = "none";
                    lbLink.href = "#";
                }

                // 1. Load Main Item
                lbCaption.textContent = caption;
                lbTag.textContent = meta;

                // Reset Progress Bar
                progressBar.value = 0;
                progressBar.style.setProperty('--progress', `0%`);

                if (type === 'video') {
                    lbImg.style.display = 'none';
                    lbVid.style.display = 'block';
                    vidControls.style.display = 'flex';
                    lbVid.src = src;
                    lbVid.play();
                    document.querySelector('#icon-pp path').setAttribute('d', pausePath);
                } else {
                    lbVid.style.display = 'none';
                    vidControls.style.display = 'none';
                    lbImg.src = src;
                    lbImg.style.display = 'block';
                }

                // 2. Rebuild the Sidebar dynamically
                sidebar.innerHTML = ''; 
                const currentGrid = card.closest('.feed-grid');
                const allCards = currentGrid.querySelectorAll('.gallery-card');
                
                allCards.forEach(otherCard => {
                    // Only add cards to sidebar if they are NOT the one currently playing
                    if (otherCard !== card) {
                        const oMeta = otherCard.getAttribute('data-meta') || 'ARCHIVE';
                        const oCaption = otherCard.getAttribute('data-caption');
                        const oThumb = otherCard.getAttribute('data-thumb');
                        
                        const sideCard = document.createElement('div');
                        sideCard.className = 'sidebar-card';
                        sideCard.innerHTML = `
                            <div class="sidebar-thumb" style="background-image: url('${oThumb}')"></div>
                            <div class="sidebar-info">
                                <h4>${oCaption}</h4>
                                <span>${oMeta}</span>
                            </div>
                        `;
                        
                        // When a sidebar card is clicked, run this master function on IT
                        sideCard.addEventListener('click', () => {
                            window.openLightbox(otherCard);
                            // Scroll main viewer to top
                            document.querySelector('.yt-layout').scrollTop = 0;
                        });
                        
                        sidebar.appendChild(sideCard);
                    }
                });

                lightbox.classList.add('active');
            };

            // Attach click event to all cards on the main page
            document.querySelectorAll('.gallery-card').forEach(card => {
                card.addEventListener('click', (e) => {
                    e.preventDefault();
                    window.openLightbox(card);
                });
            });

            // Video Controls Logic & SVG Paths
            const playPath = "M8 5v14l11-7z";
            const pausePath = "M6 19h4V5H6v14zm8-14v14h4V5h-4z";
            const volPath = "M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z";
            const mutePath = "M16.5 12c0-1.77-1.02-3.29-2.5-4.03v2.21l2.45 2.45c.03-.2.05-.41.05-.63zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51C20.63 14.91 21 13.5 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3L3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06c1.38-.31 2.63-.95 3.69-1.81L19.73 21 21 19.73l-9-9L4.27 3zM12 4L9.91 6.09 12 8.18V4z";

            const formatTime = (time) => {
                if (isNaN(time)) return "0:00";
                const minutes = Math.floor(time / 60);
                const seconds = Math.floor(time % 60);
                return `${minutes}:${seconds < 10 ? '0' : ''}${seconds}`;
            };

            playPauseBtn.addEventListener('click', () => {
                if (lbVid.paused) { 
                    lbVid.play(); 
                    document.querySelector('#icon-pp path').setAttribute('d', pausePath); 
                } else { 
                    lbVid.pause(); 
                    document.querySelector('#icon-pp path').setAttribute('d', playPath); 
                }
            });

            lbVid.addEventListener('timeupdate', () => {
                const progress = (lbVid.currentTime / lbVid.duration) * 100 || 0;
                progressBar.value = progress;
                progressBar.style.setProperty('--progress', `${progress}%`);
                timeDisplay.textContent = `${formatTime(lbVid.currentTime)} / ${formatTime(lbVid.duration || 0)}`;
            });

            progressBar.addEventListener('input', () => {
                const time = (progressBar.value / 100) * lbVid.duration;
                lbVid.currentTime = time;
                progressBar.style.setProperty('--progress', `${progressBar.value}%`);
            });

            muteBtn.addEventListener('click', () => {
                lbVid.muted = !lbVid.muted;
                document.querySelector('#icon-vol path').setAttribute('d', lbVid.muted ? mutePath : volPath);
            });

            // Close & Hard-Clear Logic
            const closeLightbox = () => {
                lightbox.classList.remove('active');
                
                // Unlock the main body scrolling
                document.body.style.overflow = '';
                
                lbVid.pause();
                
                setTimeout(() => {
                    lbVid.removeAttribute('src'); 
                    lbImg.removeAttribute('src'); 
                    lbVid.load(); 
                    lbVid.style.display = 'none';
                    lbImg.style.display = 'none';
                }, 300); 
            };

            closeBtn.addEventListener('click', closeLightbox);
            
            lightbox.addEventListener('click', (e) => {
                if (e.target === lightbox || e.target.classList.contains('yt-layout')) {
                    closeLightbox();
                }
            });

            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape' && lightbox.classList.contains('active')) {
                    closeLightbox();
                }
            });
        });
    </script>
