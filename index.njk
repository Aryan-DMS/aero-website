---
layout: base.njk
title: "AeroClub | Home"
---
<style>
    /* ==========================================
       PAGE CONTENT (HOME PAGE)
    ========================================== */
    .hero {
        height: calc(100vh - 80px);
        position: relative;
        display: flex;
        align-items: center;
        justify-content: flex-start;
        overflow: hidden;
        background-color: var(--bg-deep);
        background-image: url('/images/hero-bg.jpg'); 
        background-size: cover;
        background-position: center right;
    }
    
    .hero::before {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(90deg, var(--bg-deep) 0%, rgba(11, 17, 33, 0.95) 45%, rgba(11, 17, 33, 0.1) 85%, transparent 100%);
        z-index: 1;
    }

    .hero-content {
        position: relative;
        z-index: 3;
        width: 100%;
        max-width: 650px;
        margin-left: 0;
    }

    .hero-overline {
        display: flex;
        align-items: center;
        gap: 16px;
        font-family: var(--font-data);
        font-size: 12px;
        color: var(--accent-cyan);
        letter-spacing: 2px;
        text-transform: uppercase;
        margin-bottom: 24px;
    }
    
    .hero-overline::after {
        content: '';
        width: 48px;
        height: 1px;
        background-color: var(--accent-cyan);
    }

    .hero-text h1 { font-size: 64px; font-weight: 800; line-height: 1.1; margin-bottom: 24px; letter-spacing: -2px; color: var(--text-light); }
    .hero-text h1 span { color: var(--accent-cyan); }
    .hero-text p { font-size: 17px; color: var(--text-muted); margin-bottom: 40px; line-height: 1.6; max-width: 500px; }

    .hero-footer-line {
        display: flex;
        align-items: center;
        gap: 16px;
        margin-top: 60px;
        font-family: var(--font-data);
        font-size: 12px;
        color: var(--text-muted);
        letter-spacing: 2px;
        text-transform: uppercase;
    }
    
    .hero-footer-line::before {
        content: '';
        width: 2px;
        height: 24px;
        background-color: var(--accent-cyan);
    }

    /* ==========================================
       HOMEPAGE SPECIFIC SECTIONS
    ========================================== */
    .stats-bar { background: var(--bg-panel-dark); border-bottom: 1px solid var(--border-dark); padding: 40px 0; }
    .stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); text-align: center; gap: 24px; }
    .stat-value { font-size: 48px; font-weight: 800; color: var(--accent-cyan); margin-bottom: 8px; line-height: 1; }
    .stat-label { font-family: var(--font-data); font-size: 13px; color: var(--text-muted); text-transform: uppercase; letter-spacing: 1px; }
    
    .home-section { padding: 80px 0; }
    
    .mission-split { display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: center; }
    .mission-text h2 { font-size: 40px; font-weight: 800; margin-bottom: 24px; letter-spacing: -0.5px; }
    .mission-text h2 span { color: var(--accent-cyan); }
    .mission-text p { font-size: 18px; color: var(--text-muted); line-height: 1.7; margin-bottom: 32px; }
    
    .btn-outline { display: inline-block; padding: 12px 28px; border: 1px solid var(--border-dark); background: var(--bg-deep); color: var(--text-light); border-radius: 4px; font-weight: 700; transition: all 0.2s ease; }
    .btn-outline:hover { background: var(--text-light); color: var(--bg-deep); border-color: var(--text-light); }
    
    .mission-typo { display: flex; flex-direction: column; gap: 12px; }
    .mission-typo h3 { 
        font-size: 72px; 
        font-weight: 900; 
        line-height: 0.9; 
        color: rgba(14, 165, 233, 0.10); 
        -webkit-text-stroke: 1px rgba(14, 165, 233, 0.25); 
        text-transform: uppercase; 
        transition: all 0.3s cubic-bezier(0.25, 0.1, 0.25, 1); 
        cursor: default; 
    }
    .mission-typo h3:hover { 
        color: var(--accent-cyan); 
        -webkit-text-stroke: 1px var(--accent-cyan); 
        transform: translateX(12px); 
    }
    
    .fleet-carousel { position: relative; display: flex; align-items: center; background: var(--bg-panel-dark); border-radius: 12px; border: 1px solid var(--border-dark); overflow: hidden; }
    .fleet-slide { display: flex; align-items: center; gap: 40px; padding: 60px 80px; width: 100%; }
    .fleet-info { flex: 1; z-index: 2; }
    .fleet-info h3 { font-size: 36px; font-weight: 800; margin-bottom: 16px; color: var(--text-light); }
    .fleet-info p { font-size: 18px; color: var(--text-muted); margin-bottom: 32px; line-height: 1.6; }
    .fleet-image { flex: 1; display: flex; justify-content: center; }
    .fleet-image img { max-width: 100%; max-height: 300px; object-fit: contain; filter: drop-shadow(0 20px 30px rgba(0,0,0,0.5)); }
    
    .carousel-btn { position: absolute; background: rgba(11, 17, 33, 0.5); border: 1px solid var(--border-dark); color: var(--text-light); width: 48px; height: 48px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 18px; cursor: pointer; transition: background 0.2s, border-color 0.2s; z-index: 10; }
    .carousel-btn:hover { background: var(--bg-deep); border-color: var(--text-light); }
    .carousel-prev { left: 16px; }
    .carousel-next { right: 16px; }
    
    .news-header { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 40px; }
    .news-header h2 { font-size: 32px; font-weight: 800; }
    .news-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
    
    .news-card { background: var(--bg-deep); border: 1px solid var(--border-dark); display: flex; flex-direction: column; transition: border-color 0.2s; overflow: hidden; }
    .news-card:hover { border-color: var(--text-light); }
    .news-img { height: 200px; overflow: hidden; border-bottom: 1px solid var(--border-dark); }
    .news-img img { width: 100%; height: 100%; object-fit: cover; filter: grayscale(40%); transition: filter 0.3s; }
    .news-card:hover .news-img img { filter: grayscale(0%); }
    .news-content { padding: 32px; flex: 1; display: flex; flex-direction: column; }
    .news-meta { font-family: var(--font-data); font-size: 12px; color: var(--accent-cyan); margin-bottom: 12px; display: block; letter-spacing: 1px; }
    .news-card h4 { font-size: 20px; font-weight: 700; margin-bottom: 12px; color: var(--text-light); }
    .news-card p { font-size: 15px; color: var(--text-muted); line-height: 1.6; margin-bottom: 24px; flex: 1; }
    .learn-more { font-size: 13px; font-weight: 700; color: var(--text-light); text-transform: uppercase; letter-spacing: 1px; display: flex; align-items: center; gap: 8px; }
    .learn-more::after { content: '→'; transition: transform 0.2s; }
    .news-card:hover .learn-more::after { transform: translateX(6px); }

    .partners-header { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 40px; }
    .partners-header h2 { font-size: 32px; font-weight: 800; }
    .partners-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; }
    
    .partner-logo { display: flex; justify-content: center; align-items: center; padding: 40px; height: 220px; border-radius: 4px; background: var(--bg-panel-dark); border: 1px solid var(--border-dark); transition: border-color 0.2s ease; }
    .partner-logo img { max-width: 85%; max-height: 90px; object-fit: contain; filter: brightness(0) invert(1); transition: transform 0.2s ease; }
    .partner-logo:hover { border-color: var(--text-light); }
    .partner-logo:hover img { transform: scale(1.05); }
    
    .marquee-wrapper { overflow: hidden; white-space: nowrap; padding: 60px 0; border-top: 1px solid var(--border-dark); border-bottom: 1px solid var(--border-dark); background: var(--bg-panel-dark); }
    .marquee-content { display: inline-flex; gap: 80px; align-items: center; animation: marquee 20s linear infinite; opacity: 0.5; }
    .marquee-content span { font-size: 24px; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 2px; }
    @keyframes marquee { 0% { transform: translateX(0); } 100% { transform: translateX(-50%); } }
    
    .launch-cta { text-align: center; padding: 100px 0; }
    .launch-cta h2 { font-size: 48px; font-weight: 800; margin-bottom: 24px; }
    .launch-cta p { font-size: 18px; color: var(--text-muted); margin-bottom: 40px; }
</style>

<main id="home">
    {% set homeData = null %}
    {% for page in collections.all %}
        {% if page.fileSlug == 'home' %}
            {% set homeData = page.data %}
        {% endif %}
    {% endfor %}

    {% if homeData %}
    <section class="hero">
        <div class="container" style="width: 100%; display: flex; justify-content: flex-start;">
            <div class="hero-content">
                
                <div class="hero-overline">{{ homeData.hero.overline }}</div>
                
                <div class="hero-text">
                    <h1>{{ homeData.hero.headline | safe }}</h1>
                    <p>{{ homeData.hero.desc }}</p>
                    
                    <div style="display: flex; gap: 16px; margin-top: 40px;">
                        <a href="/models/" class="btn-join" style="padding: 14px 32px; font-size: 15px; display: flex; align-items: center; gap: 8px;">View The Fleet &rarr;</a>
                        <a href="/about/" class="btn-outline" style="padding: 14px 32px; font-size: 15px;">Our Mission</a>
                    </div>
                    
                    <div class="hero-footer-line">
                        {{ homeData.hero.footer_line }}
                    </div>
                </div>
                
            </div>
        </div>
    </section>
    
    <section class="stats-bar">
        <div class="container stats-grid">
            {% for stat in homeData.stats %}
            <div>
                <div class="stat-value">{{ stat.value }}</div>
                <div class="stat-label">{{ stat.label }}</div>
            </div>
            {% endfor %}
        </div>
    </section>

    <section class="home-section container mission-split">
        <div class="mission-text">
            <h4 style="font-family: var(--font-data); color: var(--accent-cyan); font-size: 14px; margin-bottom: 12px; letter-spacing: 1px;">{{ homeData.mission.overline }}</h4>
            <h2>{{ homeData.mission.headline | safe }}</h2>
            <p>{{ homeData.mission.body }}</p>
            <a href="/about/" class="btn-outline">Learn More</a>
        </div>
        <div class="mission-typo">
            <h3>INNOVATE.</h3>
            <h3>BUILD.</h3>
            <h3>FLY.</h3>
        </div>
    </section>
    {% endif %}

    <section class="home-section container">
        <div style="margin-bottom: 40px;">
            <h4 style="font-family: var(--font-data); color: var(--accent-cyan); font-size: 14px; margin-bottom: 8px; letter-spacing: 1px;">AIRCRAFT SHOWCASE</h4>
            <h2 style="font-size: 32px; font-weight: 800;">The Fleet</h2>
        </div>
        <div class="fleet-carousel">
            {% set flagship = collections.models | reverse | first %}
            {% if flagship %}
            <div class="fleet-slide" style="width: 100%;">
                <div class="fleet-info">
                    <h4 style="font-family: var(--font-data); color: var(--accent-cyan); font-size: 14px; margin-bottom: 12px; letter-spacing: 1px;">{{ flagship.data.card_meta | default('FLAGSHIP HARDWARE') }}</h4>
                    <h3>{{ flagship.data.title }}</h3>
                    <p>{{ flagship.data.hero_meta }}</p>
                    <a href="/models/" class="btn-join">View Full Fleet</a>
                </div>
                <div class="fleet-image">
                    <img src="{{ flagship.data.image }}" alt="{{ flagship.data.title }}">
                </div>
            </div>
            {% endif %}
        </div>
    </section>
    
    <div class="marquee-wrapper">
        <div class="marquee-content">
            {% if homeData %}
                {% for item in homeData.marquee %}
                <span>{{ item }}</span><span>•</span>
                {% endfor %}
                <!-- Duplicate array for infinite scroll illusion -->
                {% for item in homeData.marquee %}
                <span>{{ item }}</span><span>•</span>
                {% endfor %}
            {% endif %}
        </div>
    </div>

    <section class="home-section container">
        <div class="news-header">
            <div>
                <h4 style="font-family: var(--font-data); color: var(--accent-cyan); font-size: 14px; margin-bottom: 8px; letter-spacing: 1px;">MISSION LOGS</h4>
                <h2>Recent Highlights</h2>
            </div>
            <a href="/achievements/" class="btn-outline" style="padding: 10px 20px; font-size: 14px;">View All Logs</a>
        </div>
        <div class="news-grid">
            {% for log in collections.achievements | reverse %}
            {% if loop.index <= 3 %}
            <a href="{{ log.url }}" class="news-card">
                <div class="news-img"><img src="{{ log.data.image }}" alt="{{ log.data.card_title }}"></div>
                <div class="news-content">
                    <span class="news-meta">{{ log.data.card_meta }}</span>
                    <h4>{{ log.data.card_title }}</h4>
                    <p>{{ log.data.summary }}</p>
                    <span class="learn-more">Learn More</span>
                </div>
            </a>
            {% endif %}
            {% endfor %}
        </div>
    </section>

    {% set sponsorData = null %}
    {% for page in collections.all %}
        {% if page.fileSlug == 'sponsors' %}
            {% set sponsorData = page.data %}
        {% endif %}
    {% endfor %}

    <section class="home-section container" style="padding-top: 0;">
        <div class="partners-header">
            <div>
                <h4 style="font-family: var(--font-data); color: var(--accent-cyan); font-size: 14px; margin-bottom: 8px; letter-spacing: 1px;">INDUSTRY ALLIANCES</h4>
                <h2>Strategic Partners</h2>
            </div>
            <a href="/sponsors/" class="btn-outline" style="padding: 10px 20px; font-size: 14px;">View All Partners</a>
        </div>
        <div class="partners-grid">
            {% if sponsorData and sponsorData.tiers[0] %}
                {% for sponsor in sponsorData.tiers[0].sponsors_list %}
                {% if loop.index <= 4 %}
                <a href="{{ sponsor.url | default('/sponsors/') }}" class="partner-logo" target="_blank" rel="noopener noreferrer">
                    <img src="{{ sponsor.logo }}" alt="{{ sponsor.name }}">
                </a>
                {% endif %}
                {% endfor %}
            {% endif %}
        </div>
    </section>

    <section class="launch-cta container">
        <h2>Ready for Takeoff?</h2>
        <p>Join the engineering team that competes, innovates, and builds the future of flight.</p>
        <a href="/contact/" class="btn-join" style="padding: 16px 36px; font-size: 18px;">Join Aerial Martial</a>
    </section>
</main>

