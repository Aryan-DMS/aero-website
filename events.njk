---
layout: base.njk
title: "AeroClub | Events"
---
<style>

        /* High-Contrast, Dual-Color Buttons */
        .btn-join { display: inline-block; background: var(--accent-cyan); color: var(--bg-deep); padding: 12px 28px; border-radius: 4px; font-size: 15px; font-weight: 800; border: 1px solid var(--accent-cyan); transition: all 0.2s ease; cursor: pointer; text-align: center; }
        .btn-join:hover { background: var(--text-light); color: var(--bg-deep); border-color: var(--text-light); }

        .btn-outline { display: inline-block; padding: 12px 28px; border: 1px solid var(--border-dark); background: transparent; color: var(--text-light); border-radius: 4px; font-size: 15px; font-weight: 800; transition: all 0.2s ease; }
        .btn-outline:hover { background: var(--text-light); color: var(--bg-deep); border-color: var(--text-light); }

        /* Upcoming Deployment Cards */
        .event-card { background: var(--bg-deep); border: 1px solid var(--border-dark); border-radius: 4px; display: flex; flex-direction: column; transition: border-color 0.2s ease; overflow: hidden; text-decoration: none; }
        .event-card:hover { border-color: var(--text-light); }
        
        .event-img { height: 260px; overflow: hidden; border-bottom: 1px solid var(--border-dark); }
        .event-img img { width: 100%; height: 100%; object-fit: cover; filter: contrast(1.1); transition: transform 0.4s ease; display: block; }
        .event-card:hover .event-img img { transform: scale(1.03); }
        
        .event-content { padding: 40px; display: flex; flex-direction: column; flex: 1; }
        .event-content-past { padding: 32px; display: flex; flex-direction: column; flex: 1; }

        /* ==========================================
           UNIFIED HORIZONTAL TIMELINE
        ========================================== */
        .timeline-wrapper { width: 100%; overflow-x: auto; padding-bottom: 32px; cursor: grab; user-select: none; -ms-overflow-style: none; scrollbar-width: none; }
        .timeline-wrapper:active { cursor: grabbing; }
        /* Completely hide the scrollbar */
        .timeline-wrapper::-webkit-scrollbar { display: none; }
        
        .timeline-track { display: flex; gap: 64px; min-width: max-content; padding: 40px 24px 0; border-top: 2px solid var(--border-dark); position: relative; margin-top: 32px; }
        .timeline-node { width: 340px; position: relative; display: flex; flex-direction: column; white-space: normal; }
        
        .timeline-dot { position: absolute; left: 0; top: -48px; width: 14px; height: 14px; border-radius: 50%; background: var(--bg-deep); border: 2px solid var(--text-muted); transition: all 0.2s ease; z-index: 2; }
        .timeline-node:hover .timeline-dot { background: var(--text-light); border-color: var(--accent-cyan); }
        
        .timeline-meta { font-family: var(--font-data); font-size: 13px; color: var(--accent-cyan); letter-spacing: 1px; margin-bottom: 12px; display: block; text-transform: uppercase; font-weight: 700; }
        .timeline-title { font-size: 22px; font-weight: 800; color: var(--text-light); margin-bottom: 12px; line-height: 1.3; }
        .timeline-desc { font-size: 15px; color: var(--text-muted); line-height: 1.6; }

        /* ==========================================
           PAGE CONTENT (HOME PAGE)
        ========================================== */
        .hero {
            height: calc(100vh - 80px);
            background: linear-gradient(to right, rgba(11,17,33,0.95), rgba(11,17,33,0.2)), url('https://images.unsplash.com/photo-1541187764121-717013809cb8?auto=format&fit=crop&q=80&w=2000') center/cover;
            display: flex;
            align-items: center;
        }
        .hero-text h1 { font-size: 64px; font-weight: 800; line-height: 1.1; margin-bottom: 20px; max-width: 800px; letter-spacing: -1px; }
        .hero-text p { font-size: 20px; color: var(--text-muted); max-width: 600px; margin-bottom: 40px; font-family: var(--font-data); }

        /* ==========================================
           GLOBAL FOOTER
        ========================================== */
        footer { background: var(--bg-deep); border-top: 1px solid var(--border-dark); margin-top: auto; }
        .map-container { width: 100%; height: 350px; background: #111; border-bottom: 1px solid var(--border-dark); }
        .map-container iframe { width: 100%; height: 100%; border: 0; filter: invert(90%) hue-rotate(180deg) contrast(1.1); }
        
        .footer-content { padding: 80px 0 40px; display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 40px; border-bottom: 1px solid var(--border-dark); margin-bottom: 24px; }
        .footer-brand .logo { font-size: 24px; font-weight: 800; margin-bottom: 16px; display: block; }
        .footer-brand .logo span { color: var(--accent-cyan); }
        .footer-brand p { color: var(--text-muted); font-size: 14px; line-height: 1.6; margin-bottom: 24px; max-width: 300px; }
        .contact-info li { display: flex; align-items: center; gap: 12px; color: var(--text-muted); font-size: 14px; margin-bottom: 12px; }
        
        .footer-links h4 { font-size: 13px; font-weight: 700; letter-spacing: 1px; margin-bottom: 20px; color: var(--text-light); text-transform: uppercase; }
        .footer-links ul li { margin-bottom: 12px; }
        .footer-links ul a { color: var(--text-muted); font-size: 14px; transition: color 0.2s; }
        .footer-links ul a:hover { color: var(--accent-cyan); }

        .footer-bottom { padding-bottom: 40px; display: flex; justify-content: space-between; align-items: center; color: var(--text-muted); font-size: 14px; }
        
        /* Layout for Content Sections */
        .page-section { padding: 120px 0; min-height: 80vh; border-bottom: 1px solid var(--border-dark); }
        .page-section h2 { font-size: 40px; font-weight: 800; margin-bottom: 24px; color: var(--text-light); }
        .page-section p { font-size: 18px; color: var(--text-muted); }
</style>

<main id="events-page">
        
        <!-- Standardized Page Header -->
        <section style="padding: 80px 0 40px; border-bottom: 1px solid var(--border-dark);">
            <div class="container">
                <h4 style="font-family: var(--font-data); color: var(--accent-cyan); font-size: 14px; margin-bottom: 12px; letter-spacing: 1px; text-transform: uppercase;">EVENT CALENDAR</h4>
                <h2 style="font-size: 48px; font-weight: 800; margin-bottom: 16px; color: var(--text-light); letter-spacing: -1px;">Events</h2>
                <p style="color: var(--text-muted); font-size: 20px; line-height: 1.6; max-width: 700px;">Official events, technical symposiums, and our competitive schedule.</p>
            </div>
        </section>

        <!-- Section 1: Upcoming Deployments -->
        <section style="padding: 80px 0; border-bottom: 1px solid var(--border-dark); background: var(--bg-panel-dark);">
            <div class="container">
                <div style="margin-bottom: 40px;">
                    <h4 style="font-family: var(--font-data); color: var(--accent-cyan); font-size: 14px; margin-bottom: 12px; letter-spacing: 1px; text-transform: uppercase;">CURRENT SEASON</h4>
                    <h3 style="font-size: 36px; font-weight: 800; color: var(--text-light); letter-spacing: -0.5px;">Upcoming Events</h3>
                </div>
                
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 32px;">
                    {% set activeTracker = namespace(count=0) %}
                    {% for event in collections.events | reverse %}
                        {% set eCard = event.data.card | default(event.data) %}
                        {% if eCard.category == "Active" and activeTracker.count < 4 %}
                            {% set activeTracker.count = activeTracker.count + 1 %}
                            <a href="{{ event.url }}" class="event-card">
                                {% if eCard.image %}
                                <div class="event-img">
                                    <img src="{{ eCard.image }}" alt="{{ eCard.title }}">
                                </div>
                                {% endif %}
                                <div class="event-content">
                                    <span style="font-family: var(--font-data); font-size: 14px; color: var(--accent-cyan); letter-spacing: 1px; margin-bottom: 16px; display: block;">{{ eCard.dateString }} // {{ eCard.location }}</span>
                                    <h3 style="font-size: 32px; font-weight: 800; color: var(--text-light); margin-bottom: 16px;">{{ eCard.title }}</h3>
                                    <p style="color: var(--text-muted); font-size: 16px; line-height: 1.6; margin-bottom: 32px; flex: 1;">{{ eCard.summary }}</p>
                                    <span style="font-size: 13px; font-weight: 700; color: var(--text-light); text-transform: uppercase; letter-spacing: 1px; display: flex; align-items: center; gap: 8px;">View Event Details →</span>
                                </div>
                            </a>
                        {% endif %}
                    {% endfor %}
                </div>
                
                <!-- "See All Active" Button -->
                {% if activeTracker.count >= 4 %}
                <div style="text-align: center; margin-top: 48px;">
                    <a href="/events/active/" class="btn-outline" style="padding: 16px 36px; font-size: 14px;">View All Active Events &rarr;</a>
                </div>
                {% endif %}
            </div>
        </section>

        <!-- Section 2: Past Deployments -->
        <section style="padding: 80px 0; border-bottom: 1px solid var(--border-dark);">
            <div class="container">
                <div style="margin-bottom: 40px;">
                    <h4 style="font-family: var(--font-data); color: var(--accent-cyan); font-size: 14px; margin-bottom: 12px; letter-spacing: 1px; text-transform: uppercase;">PAST EVENTS</h4>
                    <h3 style="font-size: 36px; font-weight: 800; color: var(--text-light); letter-spacing: -0.5px;">Past Events</h3>
                </div>
                
                <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px;">
                    {% set pastTracker = namespace(count=0) %}
                    {% for event in collections.events | reverse %}
                        {% set eCard = event.data.card | default(event.data) %}
                        {% if eCard.category == "Past" and pastTracker.count < 9 %}
                            {% set pastTracker.count = pastTracker.count + 1 %}
                            <a href="{{ event.url }}" class="event-card">
                                {% if eCard.image %}
                                <div class="event-img" style="height: 200px;">
                                    <img src="{{ eCard.image }}" alt="{{ eCard.title }}">
                                </div>
                                {% endif %}
                                <div class="event-content-past">
                                    <span style="font-family: var(--font-data); font-size: 12px; color: var(--text-muted); letter-spacing: 1px; margin-bottom: 12px; display: block;">{{ eCard.dateString }} // {{ eCard.location }}</span>
                                    <h4 style="font-size: 20px; font-weight: 700; color: var(--text-light); margin-bottom: 12px;">{{ eCard.title }}</h4>
                                    <p style="color: var(--text-muted); font-size: 14px; line-height: 1.6; margin-bottom: 24px; flex: 1;">{{ eCard.summary }}</p>
                                    <span style="font-size: 12px; font-weight: 700; color: var(--accent-cyan); text-transform: uppercase; letter-spacing: 1px;">Read Recap ↗</span>
                                </div>
                            </a>
                        {% endif %}
                    {% endfor %}
                </div>
                
                <!-- "See All Past" Button -->
                {% if pastTracker.count >= 9 %}
                <div style="text-align: center; margin-top: 48px;">
                    <a href="/events/past/" class="btn-outline" style="padding: 16px 36px; font-size: 14px;">View All Past Events &rarr;</a>
                </div>
                {% endif %}
            </div>
        </section>

        <!-- Section 3: Horizontal Timeline -->
        <section style="padding: 80px 0 100px;">
            <div class="container">
                <div style="margin-bottom: 40px;">
                    <h4 style="font-family: var(--font-data); color: var(--accent-cyan); font-size: 14px; margin-bottom: 12px; letter-spacing: 1px; text-transform: uppercase;">TEAM HISTORY</h4>
                    <h3 style="font-size: 36px; font-weight: 800; color: var(--text-light); letter-spacing: -0.5px;">Event Timeline</h3>
                </div>
                
                <div class="timeline-wrapper">
                    <div class="timeline-track">
                        {% for event in collections.events %}
                        {% set eCard = event.data.card | default(event.data) %}
                        {% if eCard.category == "Timeline" %}
                        <div class="timeline-node">
                            <div class="timeline-dot"></div>
                            <span class="timeline-meta">{{ eCard.dateString }} // {{ eCard.location }}</span>
                            <h4 class="timeline-title">{{ eCard.title }}</h4>
                            <p class="timeline-desc">{{ eCard.summary }}</p>
                        </div>
                        {% endif %}
                        {% endfor %}
                    </div>
                </div>
            </div>
        </section>
    </main>

    <!-- Timeline Drag-to-Scroll Engine -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const slider = document.querySelector('.timeline-wrapper');
            if (!slider) return;

            let isDown = false;
            let startX;
            let scrollLeft;

            slider.addEventListener('mousedown', (e) => {
                isDown = true;
                startX = e.pageX - slider.offsetLeft;
                scrollLeft = slider.scrollLeft;
            });
            
            slider.addEventListener('mouseleave', () => { isDown = false; });
            slider.addEventListener('mouseup', () => { isDown = false; });
            
            slider.addEventListener('mousemove', (e) => {
                if (!isDown) return;
                e.preventDefault(); // Prevent text highlighting while dragging
                const x = e.pageX - slider.offsetLeft;
                const walk = (x - startX) * 2; // Scroll speed multiplier
                slider.scrollLeft = scrollLeft - walk;
            });
        });
    </script>
